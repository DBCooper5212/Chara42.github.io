splayName":"Thai"},"zh-TW":{"areSubtitlesSupported":false,"isAudioSupported":false,"isInterfaceSupported":false,"languageDisplayName":"Chinese (Traditional)"},"tr-TR":{"areSubtitlesSupported":true,"isAudioSupported":false,"isInterfaceSupported":true,"languageDisplayName":"Turkish"},"vi-VN":{"areSubtitlesSupported":false,"isAudioSupported":false,"isInterfaceSupported":false,"languageDisplayName":"Vietnamese "}},"legalNotices":["LegalNoticePurchase","DataSharingDisclaimer"],"maxInstallSize":7472197632,"optimalSkuId":"0001","preferredSkuId":"0001","productFamily":"Games","productId":"BX3S1Q5DVHRD","productKind":"Game","publisherName":"Unknown Worlds Entertainment","ratingCount":17359,"releaseDate":"2018-12-04T00:00:00.0000000Z","shortDescription":"Subnautica is an underwater open world adventure game. Craft equipment, pilot submarines, and out-smart wildlife to explore lush coral reefs, volcanoes, and cave systems.\r\n\r\nSubnautica is an underwater open world adventure game. Craft equipment, pilot submarines, and out-smart wildlife to explore lush coral reefs, volcanoes, and cave systems.\r\n\r\nFull details on the latest status of the game, how you can give feedback and report issues can be found at http:\u002F\u002Fplaysubnautica.com.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0001","availabilityId":"B2NJLGC9ZSNG","discountPercentage":75.02501,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":7.49,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0001","availabilityId":"B0FG1Q5MLC72","discountPercentage":75.02501,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":7.49,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"systemRequirements":[{"minimum":"Windows 10 version 18362.0 or higher","recommended":"Windows 10 version 18362.0 or higher","title":"OS"},{"minimum":"x64","recommended":"x64","title":"Architecture"},{"minimum":"Intel HD 4600 or equivalent","recommended":"Nvidia GTX 550 Ti or equivalent","title":"Graphics"},{"minimum":"Intel Haswell 2 cores \u002F 4 threads @ 2.5Ghz or equivalent","recommended":" Intel Haswell 4 cores \u002F 4 threads @ 3.2Ghz or equivalent","title":"Processor"},{"minimum":"Version 11","recommended":"Version 11","title":"DirectX"},{"minimum":"4 GB","recommended":"8 GB","title":"Memory"},{"minimum":"2 GB","recommended":"2 GB","title":"Video Memory"}],"title":"Subnautica","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fad25f6a0-0e9e-47aa-8b93-b72ff4e3a81f-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Subnautica Cinematic Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.51091.63409341877910445.b07f6843-6e64-434e-ba36-1a9cab7da288.83812d49-859b-42ef-a76f-fe187be44738","width":1920,"height":1080,"caption":"Subnautica Cinematic Trailer"}}],"xCloudProperties":{"xCloudId":"SUBNAUTICA","xboxTitleId":945909358,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0KGQ8":{"entryDateUTC":"2021-05-01T00:00:00Z","exitDateUTC":"2022-11-16T10:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2021-05-01T00:00:00Z","exitDateUTC":"2022-11-16T10:00:00Z"},"CFQ7TTC0K6L8":{"entryDateUTC":"2021-05-01T00:00:00Z","exitDateUTC":"2022-11-16T10:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"SUBNAUTICA","xboxTitleId":945909358,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9P4NV23Q6QC2":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":4.7,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Violence","Blood and Gore","Crude Humor"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"STORY\nHome to the world's greatest minds, GATE operates a global network of secretive research laboratories, spanning every field of scientific study - and the realms beyond.\n\nAs a GATE employee you extend the bounds of human knowledge, and seek to explain the unexplainable - including anomalies and paranormal entities: from gravity-distorting artifacts to supernatural creatures with an unbridled instinct for violence. Safety, security, and secrecy are of the utmost importance… usually.\n\nAfter a catastrophic containment breach, your workplace has become a cosmic battle zone: anomalous entities are on the loose, enemies from other dimensions are invading via portals, and an arcane military sect - known as The Order - is targeting personnel and entities indiscriminately, aiming to seize artifacts and put an end to the chaos.\n\nContainment procedures have failed and help isn’t on the way. Stranded miles beneath the surface, it’s up to you and your fellow scientists to band together, plan your escape, and make this underground complex your new home - for now.\n\nGAMEPLAY\nAbiotic Factor brings a 90’s sci-fi twist and rich character progression to the multiplayer open world survival crafting genre. Up to 6 players can choose their PHDs, build their scientist, gear up, and explore a massive subterranean complex, filled with supernatural artifacts, transdimensional foes, and science experiments gone awry.\n\nSCIENCE MEETS VIOLENCE\nBetween alien threats hunting their next meal, trigger happy soldiers, and the world’s most advanced robotic security forces attacking personnel working overtime, there’s no shortage of danger. As a scientist, fighting isn’t your forte, so you’ll need to put your PHD to work to outwit your opponents: craft ingenious and outlandish tools, weapons and gear, from simple nets and wooden bats to laser-cannons and elaborate traps - everything your big science brain can muster!\n\nMAINTAIN A HEALTHY WORK LIFE BALANCE\nMake yourself at home - you’re here for the long haul. Scavenge resources from vacant offices and empty labs, raid vending machines, and steal company property to build a new base of operations as you explore the facility. When it’s time for a change of scenery, pack up your belongings and move them across the facility using handcarts, forklifts, SUVs, teleporters, and more.\n\nJOIN THE SCIENCE TEAM\nDon your lab coat and earn your PhD: from Plant Geneticist to Defense Analyst and Structural Engineer (and many, many more), each with its own advantages essential to survival. Combine traits and skills, then level up to earn perks and abilities with your fellow scientists to forge a formidable scientific force.\n\nSURVIVE TO SEE YOUR NEXT DAY OFF\nWorking at GATE may have been a dream job, but dying here wasn’t part of your five year plan. Explore this massive underground facility as well as many worlds beyond and take full advantage of the most advanced technology unknown to mankind in this interdimensional sci-fi adventure!","developerName":"Deep Field Games","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.53884.14585229772819603.06d592a4-a006-4f6e-901f-b18fb39d663a.bbe40b6f-cf70-4277-a589-d6269843d9b5","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.19958.14585229772819603.06d592a4-a006-4f6e-901f-b18fb39d663a.61a5398e-bac4-4f45-91d8-ef4de785728e","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.16264.14585229772819603.06d592a4-a006-4f6e-901f-b18fb39d663a.9b3e1c22-92c3-4216-9240-0606dad1edcc","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSatisfyingPassId":"CFQ7TTC0P85B","optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P4NV23Q6QC2","productKind":"Game","publisherName":"Playstack","ratingCount":1822,"releaseDate":"2025-07-22T16:00:00.0000000Z","shortDescription":"Survive To See Your Next Day Off!","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9ZT7NVH53GDD","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"01\u002F16\u002F2027 09:59:59","hasXPriceOffer":false,"listPrice":34.99,"msrp":34.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9VN1W35MBG72","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"01\u002F16\u002F2027 09:59:59","hasXPriceOffer":false,"listPrice":34.99,"msrp":34.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Abiotic Factor","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F782b65b1-df3e-416f-982c-6d0d93a9613b-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Abiotic Factor - Cold Fusion","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.45449.14585229772819603.3514f934-f3cd-41b9-a57e-f6e6c2902d03.f4ef1ebc-4d72-4bc3-a867-a07d7982588b","width":1920,"height":1080,"caption":"Abiotic Factor - Cold Fusion"}}],"xCloudProperties":{"xCloudId":"ABIOTICFACTOR","xboxTitleId":2068332202,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2025-07-22T16:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2025-07-22T16:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2025-07-22T16:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-10-01T16:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"ABIOTICFACTOR","xboxTitleId":2068332202,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9P7RBKDTN18T":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":3.8,"badges":[],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence","Blood"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Raft™ throws you and your friends into an epic oceanic adventure! Alone or together, players battle to survive a perilous voyage across a vast sea! Gather debris, scavenge reefs and build your own floating home, but be wary of the man-eating sharks!","developerName":"Redbeet Interactive","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.50880.14102062639781722.573266e7-686b-44fb-9e48-a2585bc2170f.0a67ca42-df54-4251-9010-c5df066d7a9f","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.32463.14102062639781722.573266e7-686b-44fb-9e48-a2585bc2170f.5424f649-5154-402f-88e5-905dae685f22","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.17462.14102062639781722.573266e7-686b-44fb-9e48-a2585bc2170f.951859b9-7b83-401e-8a0b-a6626a3679ac","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P7RBKDTN18T","productKind":"Game","publisherName":"Axolot Games","ratingCount":608,"releaseDate":"2024-12-04T05:00:00.0000000Z","shortDescription":"Raft™ throws you and your friends into an epic oceanic adventure! Alone or together, players battle to survive a perilous voyage across a vast sea! Gather debris, scavenge reefs and build your own floating home, but be wary of the man-eating sharks!","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B3ZKP57DXH6C","discountPercentage":33.013206,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":16.74,"msrp":24.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9PW6766KCKM1","discountPercentage":33.013206,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":16.74,"msrp":24.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Raft","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F359e1cda-06ef-4ed8-b250-e68ebf64eb66-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Raft - Xbox Series X|S Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.14023.14102062639781722.573266e7-686b-44fb-9e48-a2585bc2170f.9f1b95e5-af98-4758-b767-e850b3301472","width":1920,"height":1080,"caption":"Raft - Xbox Series X|S Launch Trailer"}}],"xCloudProperties":{"xCloudId":"RAFT","xboxTitleId":2021412862,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"RAFT","xboxTitleId":2021412862,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9NQMVR9WL9FW":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":3.7,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Action & adventure","Role playing","Shooter"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence","Blood","Simulated Gambling"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"You are an engineer thrust into the strange and mysterious Void, a world with its own history, rules and future. Build and upgrade your own train, craft powerful weapons, fight various enemies and survive the surreal landscapes of the Void alone or together with friends.\n\nEXPLORE THE VOID\nExplore a vast ever-changing world full of mysteries and unique places. Discover floating islands with puzzles and dangerous fauna. Make your way through minefields and visit depots. Meet adorable Rofleemo and make them part of your crew. The Void has much to offer for those seeking adventure, so get ready to accept its challenges!\n\nBUILD YOUR TRAIN\nYou won't simply expand the train, but you'll build it yourself from scratch. Start with an empty trolley and develop it into a proper train with multiple wagons and an advanced engine. Customize the look of your train and fill it with all sorts of objects: from storages and workbenches to decorations and tables for mini games.\n\nFIGHT TO SURVIVE\nThe Void is a dangerous place, and you’ll face a variety of enemies on your way: from regular soldiers to bloodthirsty sharks. Craft and customize your weapons and equipment, escape from being chased, stand against multiple enemy waves in the arenas, clear outposts and be prepared to constantly fight for your life.","developerName":"HypeTrain Digital","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.43738.13766638199955298.30c51e02-5250-4a92-bce6-4ed56d85cf3c.4927dc7d-1e11-4121-b0b8-ed323f936d86","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.39088.13766638199955298.30c51e02-5250-4a92-bce6-4ed56d85cf3c.f1f44049-4041-4fc5-a260-21a575b7ca31","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.17636.13766638199955298.30c51e02-5250-4a92-bce6-4ed56d85cf3c.b921d8f4-8656-49eb-93d5-02fb55202cf8","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NQMVR9WL9FW","productKind":"Game","publisherName":"HypeTrain Digital","ratingCount":412,"releaseDate":"9998-12-30T00:00:00.0000000Z","shortDescription":"Become a crew member of an Interdimensional Express Train! Discover a new world full of mysterious creatures, enemies and places. Upgrade and customize your train, gather new materials and build better weapons. Play solo or online сo-op with up to 4 people.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B1Q68HFLPNJ8","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9W6NMN7BCR7B","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Voidtrain","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fcf340de9-6a49-4e3e-b4e8-014494858bd4-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Voidtrain Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.43479.13766638199955298.a69a9ed9-b7d9-49b0-9a54-f738978da8af.e5fb74f2-2be1-41d2-b60a-8c21ef527f3d","width":1920,"height":1080,"caption":"Voidtrain Trailer"}}],"xCloudProperties":{"xCloudId":"VOIDTRAIN","xboxTitleId":1797047526,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2025-11-07T17:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2025-11-07T17:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2025-11-07T17:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-11-07T17:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"VOIDTRAIN","xboxTitleId":1797047526,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9N95N2T4ZZV7":{"availableOn":["XboxSeriesX"],"averageRating":2.6,"badges":[],"categories":["Simulation"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Blood and Gore","Intense Violence","Use of Drugs"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"Creature Lab sets you on a difficult path of a genius, yet a bit wicked scientist with a very liberal approach to test subjects and official procedures. Establish your hideout and let the experiments commence! Conduct crazy experiments, mix mutagens, analyze their properties, grow DNA-based body parts, and attach them to your test subjects.\n\nSo many possibilities… Prepare your laboratory, obtain basic reagents, and see what happens when you mix them together. Don’t forget to name all your recipes! Apply your mutagens to test subjects and observe how they react. Grow entirely new body parts and attach them to the creatures you just brought to life. Discover nearly limitless interactions between mutagens and body parts as you slowly assemble an army of mutants.\n\nThere's no use hoping for government funds so you'll make do with anything you can find or even steal. Manage your inventory, expand your lab, and make sure your hideout is safe. Don’t let the panic guide you, the more stressed you are, the bigger chance Feds will drop by to say hello and check your spot! Don’t leave any traces, be patient and extremely careful! They will never even know what hit them!\n\nRunning low on resources? Need more test subjects? Send your sick creatures into the city! Find whatever resources you need. Spread panic in the city to scare off anyone trying to find your hideout. And if the military starts looking for you, send the strongest of your creatures to teach them a lesson. Let no one stop you in your search for the ultimate mutagen!\n\nFeatures:\n- First-person mad scientist simulator\n- Complex resource and inventory management\n- A strategy element - plan raids on the city and prepare for encounters with the military\n- Thousands of different mutagens to discover - you name them all","developerName":"Image Power S.A. \u002F Console Labs S.A.","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.59088.13538924048240984.a4338b87-d2ba-4a30-922f-94bf79120fc7.dd9f344a-f0ea-4a31-a1a0-c5da2a6cef25","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.26655.13538924048240984.a4338b87-d2ba-4a30-922f-94bf79120fc7.af236bf6-ad6b-43d6-bf4e-39f8d01da4f7","width":720,"height":1080},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.29321.13538924048240984.a4338b87-d2ba-4a30-922f-94bf79120fc7.138099f3-37bd-4bf0-8a8e-1ab8d9813aee","width":1920,"height":1080}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9N95N2T4ZZV7","productKind":"Game","publisherName":" PlayWay S.A.","ratingCount":37,"releaseDate":"2024-08-30T19:00:00.0000000Z","shortDescription":"Become a mad scientist in search of the ultimate mutagen!\nHere, you can outshine even the famous Frankenstein with your incredible mutants! Prove your genius once and for all and let nobody stop you.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9T747T05QJRZ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":19.99,"msrp":19.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9PF6F55P5ZR8","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":19.99,"msrp":19.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Creature Lab","videos":[],"cmsVideos":[],"passMetadataByPassProductId":{},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9NKV34XDW014":{"availableOn":["PC","XboxOne","XboxSeriesX","XCloud","Handheld"],"averageRating":4.2,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Action & adventure","Role playing"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Mild Language","Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Q. What kind of game is this?\nA. In this game, you can peacefully live alongside mysterious creatures known as Pals or risk your life to drive off a ruthless poaching syndicate.\nPals can be used to fight and breed, or they can be made to work on farms or factories.\nYou can even sell them or eat them.\n\n▼Survival\nIn a harsh environment where food is scarce and vicious poachers roam, danger waits around every corner. To survive, you must tread carefully and make difficult choices...even if that means eating your own Pals when the time comes.\n\n▼Mounts & Exploration\nPals can be mounted to traverse the land, sea and sky—allowing you to traverse all kinds of environment as you explore the world.\n\n▼Building Structures\nWant to build a pyramid? Put an army of Pals on the job. There are no labor laws for Pals, so exploit them to your heart's content.\n\n▼Production\nFind a variety of useful Pals to make fire, generate electricity, or mine ore so that you can live a life of comfort.\n\n▼Farming\nSome Pals are good at planting seeds, while others are skilled at watering or harvesting crops. Work together with your Pals to create an idyllic farmstead.\n\n▼Factories & Automation\nLetting Pals do the work is the key to automation. Build a factory, place a Pal in it, and they'll keep working as long as they're fed—until they're dead, that is.\n\n▼Dungeon Exploration\nWith Pals on your side you can tackle even the most dangerous areas. When the time comes, you might have to sacrifice one to save your skin. They'll protect your life—even if it costs their own.\n\n▼Breeding & Genetics\nBreed a Pal and it will inherit the characteristics of its parents. Combine rare pals to create the strongest Pal of them all!\n\n▼Poaching & Crime\nEndangered Pals live in wildlife sanctuaries. Sneak in and capture rare Pals to get rich quick! It's not a crime if you don't get caught, after all.\n\n▼Multiplayer\nMultiplayer is supported, so invite a friend and go on an adventure together! And of course you can battle your friends and trade Pals, too.\nIn online co-op play mode, up to 4 players can play together.\nMeanwhile, a dedicated server can allow up to 32 players to play together.\n\nCollect all kinds of exciting Pals to fight, farm, build, and work for you in this completely new multiplayer, open world survival and crafting game!","developerName":"Pocketpair","hasAddOns":false,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.45491.13654268679289325.ececb946-5639-4e77-b347-9d188d4e7e02.d4615c02-237f-4ec6-8ec6-a84aaeed586f","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.49778.13654268679289325.ececb946-5639-4e77-b347-9d188d4e7e02.9102215b-349a-4f6d-b9a3-2c14908481f1","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.54359.13654268679289325.ececb946-5639-4e77-b347-9d188d4e7e02.58b7fb42-a33a-48ea-a6c9-c990b4653b2f","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSatisfyingPassId":"CFQ7TTC0P85B","optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NKV34XDW014","productKind":"Game","publisherName":"Pocketpair","ratingCount":20948,"releaseDate":"2024-01-19T08:00:00.0000000Z","shortDescription":"You can peacefully live alongside mysterious creatures known as Pals or risk your life to drive off a ruthless poaching syndicate.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B33BB4848STQ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F16\u002F2027 09:59:59","hasXPriceOffer":false,"listPrice":29.99,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9NNZQ8L88CDQ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F16\u002F2027 09:59:59","hasXPriceOffer":false,"listPrice":29.99,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Palworld","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fxbox\u002Fprod\u002Fvideos\u002Fmainprofile\u002F13654268679289325\u002F1c820f2a-c2b8-4283-9893-105a4b0432d9\u002Fmanifest.m3u8","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Palworld 1.0 Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.52917.13654268679289325.1d3d1208-a3d9-4150-ad23-4a1c3bb4ccd1.ab1f33a0-271d-48f7-87af-f35e2ae8d6ad","width":1920,"height":1080,"caption":"Palworld 1.0 Launch Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fxbox\u002Fprod\u002Fvideos\u002Fmainprofile\u002F13654268679289325\u002Ff0090a91-4886-4d5d-9a8f-fb72ae2cb261\u002Fmanifest.m3u8","purpose":"trailer","height":1080,"width":1920,"title":"Palworld Cinematic Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.41900.13654268679289325.1d3d1208-a3d9-4150-ad23-4a1c3bb4ccd1.383174c9-d243-46a2-b538-c40f26cffaaf","width":1920,"height":1080,"caption":"Palworld Cinematic Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fxbox\u002Fprod\u002Fvideos\u002Fmainprofile\u002F13654268679289325\u002F3d04d98a-429f-4f05-9b26-00226639b4f5\u002Fmanifest.m3u8","purpose":"trailer","height":1080,"width":1920,"title":"Tides of Terraria","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.55248.13654268679289325.1d3d1208-a3d9-4150-ad23-4a1c3bb4ccd1.8d9242f6-aa0f-489c-b004-ccdaaeafdd8c","width":1920,"height":1080,"caption":"Tides of Terraria"}}],"xCloudProperties":{"xCloudId":"PALWORLDGAMEPREVIEW","xboxTitleId":1797327516,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2024-01-19T08:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2024-01-19T08:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2024-01-19T08:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2024-08-12T14:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"PALWORLDGAMEPREVIEW","xboxTitleId":1797327516,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9P33VJGVPHVP":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":2.8,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Action & adventure","Role playing","Shooter"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Use of Alcohol","Blood","Crude Humor","Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["In-Game Purchases","Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Respawn into a new dinosaur survival experience beyond your wildest dreams… as ARK is reimagined from the ground-up into the next-generation of videogame technology with Unreal Engine 5! You awake on a mysterious island, your senses overwhelmed by the blinding sunlight and brilliant colors bouncing off every surface around you, the azure waters of a verdant Island lapping at your bare feet. A deep roar echoes from the misty jungle, jolting you into action, and you stand up – not afraid, but intrigued. Are you ready to form a tribe, tame and breed hundreds of species of dinosaurs and other primeval creatures, explore, craft, build, and fight your way to the top of the food-chain? Your new world awaits… step through the looking-glass and join it!\n\nFEATURES\n\nARK: Survival Ascended has completely recreated and redesigned the artwork and worlds of ARK to take advantage of the latest in videogame technology, Unreal Engine 5, using high-end graphics features such as fully dynamic Global Illumination (“Lumen”), so that light bounces realistically off of surfaces and provides realistic reflections, and advanced mesh streaming (“Nanite”) of hundreds of millions of triangles for extreme detail.\n\nAdvanced new physics systems such as dynamic water so that every creature creates waves, ripples, splashes, and bubbles as they move through fluids, and fully interactive physical foliage where every blade of grass, bush, and tree reacts to characters, explosions, projectiles, and physics objects. Knock down a tree, and see it crash into other trees and disturb all the foliage on its way down to smacking into the grass below! Detect an enemy moving sneakily through the grass as it shifts and sways in response to their presence. Demolish a building and watch the pieces break apart realistically, interacting with the grass and water as they fall.\n\nARK: Survival Ascended includes access to all of ARK’s worlds, including Scorched Earth, Aberration, Extinction, ARK Genesis Part 1, ARK Genesis Part 2, and more. The Island, Scorched Earth, Aberration and The Center are released now, Extinction will be released on December 16, with the subsequent expansion worlds to be added at no additional cost on a regular basis.\n\nThe definitive survival experience returns better than ever: design your Survivor, form a tribe, and tame, train, breed & ride dinosaurs within a living ecosystem. Watch your food, water, temperature, and weather patterns. Slowly expand outwards as you harvest, build structures, farm crops, customize your visual designs, and proceed to explore to uncover the true nature of The Island and the worlds beyond. \n\nThorough Quality of Life revamps in every area: redesigned User Interfaces, dynamic navigation for intelligent creature pathfinding, Wild Babies, Photo Mode, new Camera systems, new Map system, Tracking System, new Structures and Items, new Creatures, and much more.\n\nCross-Platform Modding: Download & play new custom content created by players, including new maps, creatures, items, and game modes, through a dedicated mod collection directly within the game! Enjoy an endless stream of new ARK content as the creativity and talent of the community is fully unleashed for the first time ever across gaming platforms!\n\nCross-Platform Multiplayer: form your online tribe across different gaming platforms as you work together to survive and thrive on the ARK!\n\nSupports public online multiplayer for up to 70 players, private-session multiplayer for up to 8 players, and local split-screen for 2 players.","developerName":"Studio Wildcard, Grove Street Games","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.28808.14545480955348978.c66022f5-e4e3-4713-8508-d8bd11df0814.6790feb5-a50e-42a7-83b4-076a5c1b170e","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.47381.14545480955348978.f72b621c-2a7f-403c-8bd4-126f7310ad33.c2cc3983-f689-401d-9deb-e46cb33271be","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.34402.14545480955348978.6df932ed-6670-40c9-9a84-fc164557d4ec.635b23a8-4ec7-44bd-b0ba-bc07c9b9ebb6","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSatisfyingPassId":"CFQ7TTC0P85B","optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P33VJGVPHVP","productKind":"Game","publisherName":"Studio Wildcard","ratingCount":9247,"releaseDate":"2023-11-21T17:00:00.0000000Z","shortDescription":"ARK is reimagined from the ground-up in this next-generation of video game technology with Unreal Engine 5! Form a tribe, tame & breed hundreds of unique dinosaurs and creatures, explore, craft, build, and fight your way to the top of the food-chain. Your new world awaits!","showSupportedLanguageDisclaimer":true,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B2NZD6G3GJ87","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F31\u002F2799 22:59:59","hasXPriceOffer":false,"listPrice":44.99,"msrp":44.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B0ZP2LWJ1G6S","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F31\u002F2799 22:59:59","hasXPriceOffer":false,"listPrice":44.99,"msrp":44.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"ARK: Survival Ascended","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F99366286-4f28-4714-815a-0c6e6de2281a-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Gameplay Reveal Preview","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.36448.14545480955348978.6df932ed-6670-40c9-9a84-fc164557d4ec.bec6a1f3-9981-4bed-98fe-cfe2643f40eb","width":1920,"height":1080,"caption":"Gameplay Reveal Preview"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F270497b4-38aa-4533-911a-ad671c3ce486-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Scorched Earth Ascended Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.55681.14545480955348978.d9dc5ec7-e893-437c-bd61-837246100ce7.adf1c356-f4b0-42d4-bf64-4a735a1d7fad","width":1920,"height":1080,"caption":"Scorched Earth Ascended Launch Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F413650fd-d23b-4716-a685-60cf0c4664be-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Aberration Ascended Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.12649.14545480955348978.8ab2c972-6a51-4d13-9dee-20fb336ddc09.3af231e6-71fb-4793-87ca-f3e744d17ce0","width":1920,"height":1080,"caption":"Aberration Ascended Launch Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F84e1ddab-406d-4a12-a6ae-e01a67ce4b00-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"ARK: Extinction Ascended Release Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.49597.14545480955348978.3043aa9d-4ea5-4ef7-b77c-bb3344b87b05.68e2a43a-6e4b-4c19-a21f-12c287d98bb7","width":1920,"height":1080,"caption":"ARK: Extinction Ascended Release Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F0ae5aead-fcd3-4856-8de2-272ee4573ff2-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"ARK: Lost Colony Release Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.11151.14545480955348978.3043aa9d-4ea5-4ef7-b77c-bb3344b87b05.e4d338f1-0c14-43ad-8bc8-d33b7aff7e31","width":1920,"height":1080,"caption":"ARK: Lost Colony Release Trailer"}}],"xCloudProperties":{"xCloudId":"ARKSURVIVALASCENDED","xboxTitleId":1928988061,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2024-04-01T16:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2024-04-01T16:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2024-04-01T16:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2024-08-12T14:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"ARKSURVIVALASCENDED","xboxTitleId":1928988061,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9N0KRV3ZL4GQ":{"availableOn":["XboxOne","XboxSeriesX","XCloud"],"averageRating":4,"badges":[],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Blood and Gore","Suggestive Themes","Use of Drugs","Strong Language","Intense Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"The much-loved zombie saga is back with a unique formula of horror, dark humor and over the top zombie-slaying, spanning an epic pulp adventure. \n\nDead Island 2 is a thrilling First-Person Action RPG, stylish, vibrant and flooded with zombie infection. Explore iconic, gore-drenched Los Angeles. Meet larger-than-life characters. Slay countless foes in exquisitely bloody detail. And evolve to become the ultimate Zombie Slayer.\n\nThe Ultimate Edition features the Xbox One and Xbox Series X|S versions of the game, both epic story expansions plus special weapons and stylish gear to unleash a new level of carnage. \n\nThe Ultimate Edition includes: \n- Haus and SoLA expansions\n- Memories of Banoi Pack\n- Golden Weapons Pack\n- Pulp Weapons Pack\n- Red’s Demise Katana\n- 6 Premium Character Packs\n- Kingdom Come: Deliverance II Pack \n\nPlayers using Xbox Series X|S and Xbox One X consoles can host and join co-op sessions. Xbox One|S players can join co-op sessions, but due to technical limitations they can host sessions for only one joining player.\n\nFor customers in Germany - Once zombies are defeated, players can no longer deal damage to or further dismember zombie corpses. USK players can play co-op sessions with international players through friend invites and joining friends. For public matchmaking, USK players can only play with other USK players.\n","developerName":"Deep Silver Dambuster Studios","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.30727.13923893344658637.6ce58e1e-5d11-4117-bfca-19800098ac55.b7f213b7-a653-4c90-9f0e-d0c9e13a23c9","width":1080,"height":1080,"backgroundColor":"#FFFFFF"},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.56292.13923893344658637.6ce58e1e-5d11-4117-bfca-19800098ac55.43d171f8-458b-4e49-a1db-aec65edb36fe","width":1440,"height":2160,"backgroundColor":"#FFFFFF"},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.8427.13923893344658637.6ce58e1e-5d11-4117-bfca-19800098ac55.f5320a55-2122-4329-8ff1-d6e7bcc8ca4b","width":3840,"height":2160,"backgroundColor":"#FFFFFF"}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9N0KRV3ZL4GQ","productKind":"Game","publisherName":"Deep Silver","ratingCount":6710,"releaseDate":"2023-04-21T04:00:00.0000000Z","shortDescription":"Plunge into the heart of HELL-A and experience intense zombie-slaying action. The Ultimate Edition features both epic story expansions, Haus & SoLA, plus special weapons and stylish gear to unleash a new level of carnage. ","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9ZVG3DW0DF67","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Purchase","Browse","Curate","Red