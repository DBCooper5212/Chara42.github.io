,"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":10.49,"msrp":29.99,"currency":"USD"},"skuId":"0010"}}},"9P7ZBF3S7PSS":{"0010":{"B231FVGDVQZT":{"actions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"availabilityId":"B231FVGDVQZT","endDateUtc":"12\u002F30\u002F9998 00:00:00","productId":"9P7ZBF3S7PSS","price":{"skuId":"0010","availabilityId":"B231FVGDVQZT","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":59.99,"msrp":59.99,"currency":"USD"},"skuId":"0010"}}},"9PHFJ0N31NV1":{"0010":{"9WB1FVRHTZ68":{"actions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"availabilityId":"9WB1FVRHTZ68","endDateUtc":"07\u002F30\u002F2026 09:59:59","productId":"9PHFJ0N31NV1","price":{"skuId":"0010","availabilityId":"9WB1FVRHTZ68","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"},"skuId":"0010"}},"0011":{"9S1SGP7NMKMD":{"actions":["Details","Fulfill","Purchase"],"availabilityId":"9S1SGP7NMKMD","productId":"9PHFJ0N31NV1","skuId":"0011"}}}},"productSummaries":{"BX3S1Q5DVHRD":{"accessibilityCapabilities":{"audio":["Surround sound"],"gameplay":[],"input":["Playable without button holds","Playable without rapid button presses"],"publisherInformationUri":null,"visual":[]},"availableOn":["XboxOne","XboxSeriesX","PC","XCloud","Handheld"],"averageRating":4.5,"badges":[],"bundledProductIds":[],"bundlesBySeed":[],"capabilities":{"SinglePlayer":"Single player","ConsoleGen9Optimized":"Optimized for Xbox Series X|S","ConsoleCrossGen":"Smart Delivery","CapabilityXboxEnhanced":"Xbox One X Enhanced","XblAchievements":"Xbox achievements","XblPresence":"Xbox presence","XblCloudSaves":"Xbox cloud saves","XPA":"Xbox Play Anywhere"},"categories":["Action & adventure","Other"],"contentRating":{"boardName":"ESRB","description":"For ages 10 and up","disclaimers":[],"descriptors":["Fantasy Violence","Mild Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.56093.image.e3da543f-ed61-47ce-bc12-683dab90c502.5e57d206-3b82-4a7b-9b98-d1548cd450a8","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"EVERYONE 10+","ratingAge":10,"ratingDescription":"For ages 10 and up"},"description":"You have crash-landed on an alien ocean world, and the only way to go is down. Subnautica's oceans range from sun drenched shallow coral reefs to treacherous deep-sea trenches, lava fields, and bio-luminescent underwater rivers. Manage your oxygen supply as you explore kelp forests, plateaus, reefs, and winding cave systems. The water teems with life: Some of it helpful, much of it harmful.\r\n\r\nAfter crash landing in your Life Pod, the clock is ticking to find water, food, and to develop the equipment you need to explore. Collect resources from the ocean around you. Craft knives, lights, diving gear, and personal water craft. Venture deeper and further form to find rarer resources, allowing you to craft more advanced items.\r\n\r\nBuild bases on the sea floor. Choose layouts and components, and manage hull-integrity as depth and pressure increase. Use your base to store resources, park vehicles, and replenish oxygen supplies as you explore the vast ocean.","developerName":"Unknown Worlds, Grip Games, and Panic Button","editions":[],"hasAddOns":false,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.19794.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.8fe60020-9cc9-42c9-af2a-bf7b08cb5e13","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.24838.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.d531d87c-d1b7-497f-b802-baabfb728090","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.23135.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.5a02df2f-4cea-4002-856b-2f4f478da7e9","width":3840,"height":2160},"screenshots":[{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.2860.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.839700d9-8833-4f67-8fbd-a4d5ab4b58e0","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.49327.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.23657f1c-28a5-425b-9705-5d79015e113f","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.50733.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.967b2fbc-8855-440e-91a0-b129dcf0a915","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.64144.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.28a93e70-0955-4fe5-bfec-b8ca4c911478","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.15059.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.b71bf287-792c-405f-ad41-59f54086caaa","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.4204.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.88f1c0ae-d26a-4abf-9e72-1aba9423a945","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.60475.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaabf.f3490f17-e8d7-4df9-9fc7-b5df15f19b1b","width":1920,"height":1080},{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.55277.63409341877910445.4fd452e1-c3ee-4448-a0f8-ac6eb6bdaab