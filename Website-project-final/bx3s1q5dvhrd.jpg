ers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fb1bfae1c-8ea9-492e-97f4-5cc7b00974b5-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Update 2.0 - Accolades Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.7037.63407868131364914.be3dcf4b-4889-45d5-91f3-1ad85e1d2d5a.70424e7d-f068-4b8d-9ce7-9820d28c52db","width":1920,"height":1080,"caption":"Update 2.0 - Accolades Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F4b86eff8-4866-4476-9b90-f2117f2981cc-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Cyberpunk 2077 — Update 2.1 Overview","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.62544.63407868131364914.d91c5320-9b7d-4e94-9919-0197247ccacc.59bdf4c5-7832-4327-9d76-34555db4b8fd","width":1920,"height":1080,"caption":"Cyberpunk 2077 — Update 2.1 Overview"}}],"xCloudProperties":{"xCloudId":"CYBERPUNK2077","xboxTitleId":222473492,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2026-03-10T00:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2026-03-10T00:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2026-03-10T00:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"CYBERPUNK2077","xboxTitleId":222473492,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9MX7F9LLRKZP":{"availableOn":["XboxSeriesX"],"averageRating":3.5,"badges":[],"categories":["Action & adventure","Simulation"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence","Blood","Use Of Drugs And Alcohol"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"iDigging is an exciting cooperative (up to 5 people) first-person game with bright, stylized, cute graphics where you play as a protagonist who decides to challenge the rules and laws. In this game, you'll dig your way to success despite the bans and threats.\n\nThe life of your character is not going well: his wife left him for the neighbor because he has no job and no money, and his house is empty. However, one day, the main character decides to change his life. In the game world, there is a strict ban on digging on your own property — all underground resources belong to the state since someone found treasure buried beneath the ground. But our hero decides to find this treasure and regain his status.\n\nYou can dig endlessly in your backyard, exploring different layers of soil to find valuable resources and useful items such as furniture for your house, accessories, metals, jewels, and much more. Everything you find can be sold to earn money and improve your home, making it a cozy place to live. The more you dig, the better your life becomes, and the more you surpass your neighbor who lives nearby.\n\nHowever, your neighbor isn't that simple. He constantly spies on you and might call the police if he notices anything suspicious. The police come regularly to check if you’ve been digging, and if they find any traces, you’ll be in big trouble. You’ll have to use your wits and various tools to hide your actions and conceal the dug holes from prying eyes. To do so, you can use camouflage carpets, upgrade your digging tools, and employ other tricks.\n\nThroughout the game, you’ll be able to improve your tools, starting with simple shovels and pickaxes and advancing to powerful mechanical devices like drills or dynamite. You’ll also have access to various bombs and even guard dogs to protect you from the pesky neighbor.","developerName":"TWEN","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.33950.13895319741425600.29586239-8c38-4cd7-834a-d6d57fe2a383.1759ef15-cf88-4602-a910-9f4b4e452372","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.33945.13895319741425600.29586239-8c38-4cd7-834a-d6d57fe2a383.789e9c30-cdbc-47ee-8a73-658838442beb","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.190.13895319741425600.29586239-8c38-4cd7-834a-d6d57fe2a383.98c54b1a-7176-4e2e-99f1-31204978d259","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9MX7F9LLRKZP","productKind":"Game","publisherName":"Dreland Enterprises","ratingCount":6,"releaseDate":"2026-05-07T21:00:00.0000000Z","shortDescription":"In iDigging, you’ll balance treasure hunting, home improvement, and the strategy of hiding from curious neighbors and authorities. Upgrade, dig, and create your best life despite all the challenges!","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9XVCG1JQ85JG","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":9.49,"msrp":9.49,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9XXMW2RXTLFJ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":9.49,"msrp":9.49,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"iDigging","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F5fc83d23-e971-4e04-b223-d200a4561eec-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Trailer iDigging Xbox 1920х1080","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.51488.13895319741425600.29586239-8c38-4cd7-834a-d6d57fe2a383.bdc5166d-485a-400f-be06-1c9f7b57e0ef","width":1920,"height":1080,"caption":"Trailer iDigging Xbox 1920х1080"}}],"passMetadataByPassProductId":{},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9MW2X7FQ4ZG9":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":4.1,"badges":[],"categories":["Strategy","Role playing","Simulation"],"contentRating":{"boardName":"ESRB","description":"For ages 10 and up","disclaimers":[],"descriptors":["Violent References","Mild Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.56093.image.e3da543f-ed61-47ce-bc12-683dab90c502.5e57d206-3b82-4a7b-9b98-d1548cd450a8","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact","In-Game Purchases"],"rating":"EVERYONE 10+","ratingAge":10,"ratingDescription":"For ages 10 and up"},"description":"The universe is getting bigger every day! Paradox Development Studio is bringing the grand strategy genre to consoles for the first time ever with Stellaris: Console Edition. Featuring the same deep strategic gameplay, rich and diverse alien races and emergent storytelling, Stellaris: Console Edition puts the complexity of the galaxy at your thumbsticks. Whether you’re exploring the unknown, discovering the mysteries of the universe, or conquering it for the glory of your empire, console players have more inter-galactic strategy awaiting them than ever before.\n\nThe universe has arrived at your consoles, it’s up to you what to do with it.\n\nMAIN FEATURES\n•\tBehold the enormity of space with procedurally generated galaxies with an untold number of planets to explore.\n•\tEncounter a myriad of wild, wacky, and dangerous alien races who may prove to be crucial trade partners or conquering forces hellbent on enslaving your civilization.\n•\tTake on strategic space warfare and resource management to ensure the survival and advancement of your empire.\n•\tExplore scientific anomalies and uncover technological wonders throughout the galaxy to mercilessly utilize them toward your own gains.\n•\tGovern your own fledgling population and secure your power and agenda through manipulating internal policies, factions, traditions and more.\n\nParadox ID user account (16+) is required for online multiplayer. Age restrictions apply (16+) for online multiplayer.","developerName":"Paradox Development Studio, Tantalus Media","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.28754.13851675759085158.74991af7-70f4-4aea-ad50-57bb8bc448c3.552869ac-6877-4457-90ec-ee9ce0701c50","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.57468.13851675759085158.74991af7-70f4-4aea-ad50-57bb8bc448c3.87c73550-e8c4-456b-9ecd-e6c0115c0bbd","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.31612.13851675759085158.74991af7-70f4-4aea-ad50-57bb8bc448c3.fdb6fa00-6490-434c-ac0b-3e8bc8338f85","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9MW2X7FQ4ZG9","productKind":"Game","publisherName":"Paradox Interactive","ratingCount":382,"releaseDate":"2025-11-06T09:00:00.0000000Z","shortDescription":"Stellaris: Console Edition puts the complexity of the galaxy at your thumbsticks. Whether you’re exploring the unknown, discovering the mysteries of the universe, or conquering it for the glory of your empire, players have more inter-galactic strategy awaiting them than ever before.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9Z818Z5MPWZ4","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9QPW4F3765DS","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Stellaris: Console Edition (X|S)","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F0d4428d9-017a-45f9-b8bf-cc7543f33f30-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Stellaris Console Edition release trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.23842.13851675759085158.74991af7-70f4-4aea-ad50-57bb8bc448c3.14911390-44e4-42f1-bbc3-7dea4e1fc5d9","width":1920,"height":1080,"caption":"Stellaris Console Edition release trailer"}}],"xCloudProperties":{"xCloudId":"STELLARISCONSOLEEDITIONXS","xboxTitleId":1698419011,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K5DJ":{"entryDateUTC":"2025-12-03T00:00:00Z","exitDateUTC":"2026-07-16T10:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2025-12-03T00:00:00Z","exitDateUTC":"2026-07-16T10:00:00Z"},"CFQ7TTC0K6L8":{"entryDateUTC":"2025-11-06T09:00:00Z","exitDateUTC":"2026-07-16T10:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-11-06T09:00:00Z","exitDateUTC":"2026-07-16T10:00:00Z"},"CFQ7TTC10QFD":{"entryDateUTC":"2026-04-23T15:00:00Z","exitDateUTC":"2026-07-16T10:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"STELLARISCONSOLEEDITIONXS","xboxTitleId":1698419011,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9MX0X718686P":{"availableOn":["XboxSeriesX"],"averageRating":3.7,"badges":[],"categories":["Simulation","Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 10 and up","disclaimers":[],"descriptors":["Fantasy Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.56093.image.e3da543f-ed61-47ce-bc12-683dab90c502.5e57d206-3b82-4a7b-9b98-d1548cd450a8","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"EVERYONE 10+","ratingAge":10,"ratingDescription":"For ages 10 and up"},"description":"Join Sharpe Industries as a vehicle test pilot and journey across the world to remote outposts where everything needs to be destroyed, using purpose-built wrecking machines such as flying bulldozers, tanks wielding quad rocket launchers, and ornithopters with grappling hooks.  \n\nMaster these contraptions and demolish every structure in sight across two campaigns and a Sandbox mode. Deconstruct buildings piece-by-piece or take advantage of explosive chain-reactions with Instruments of Destruction’s advanced physics system. \n\nTackle a carnage-filled campaign filled with demolition-based objectives, then test your skills even further in dedicated high-score challenges that apply new parameters and objectives to each level. Or take a break from missions and unwind in the Sandbox mode to raze the world at your own pace.  \n\nAnd don’t just destroy: build. Learn how to design your own machines in a dedicated epilogue campaign for the ultimate demolition experience. Use the in-built editor to construct devastating vehicles armed with chainsaws, lasers, claws, wrecking balls, magnets, vortex generators, and much more.\n\n\n ","developerName":"Radiangames","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.61106.13828941542204094.a984358e-dc61-427d-84fe-9050e9d68255.c4f535f0-df62-4184-9952-7a9be06ce9a0","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.30895.13828941542204094.0d3737ce-f81c-47a6-afe1-98b0febf6d42.523fc49b-9754-417a-ba8b-98ff3408689b","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.12673.13828941542204094.0d3737ce-f81c-47a6-afe1-98b0febf6d42.558e8bc8-9f8c-436c-bf50-fc26694eb550","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9MX0X718686P","productKind":"Game","publisherName":"Secret Mode","ratingCount":23,"releaseDate":"2025-10-23T18:00:00.0000000Z","shortDescription":"Crash through walls and tear down buildings in Instruments of Destruction, a vehicle-action game featuring advanced physics-based demolition. Pilot 130+ unique vehicles across scores of challenge-packed missions or design your own contraptions and wreck highly-interactive sandbox worlds. ","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B4V1QS9P8NF2","discountPercentage":50.02501,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":9.99,"msrp":19.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9RBPHHGKTCG4","discountPercentage":50.02501,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":9.99,"msrp":19.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Instruments of Destruction","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fb6a7b075-66c4-4609-9130-dc5c3e84a8b4-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Console Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.53764.13828941542204094.cfe9a926-b9f8-48fc-b49f-cb78352ff109.cd588988-a82e-4c80-94c8-57531288ee91","width":1920,"height":1080,"caption":"Console Launch Trailer"}}],"passMetadataByPassProductId":{},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9P3H2PVZZPSD":{"availableOn":["XboxSeriesX"],"averageRating":3.2,"badges":[],"categories":["Action & adventure","Role playing","Simulation"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence","Blood"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"ICARUS: Console Edition\nLand on ICARUS, a planet broken due to failed terraforming. Once meant to be humanity’s second home, it is now a hostile frontier of toxic skies, savage wildlife, and relentless storms. Every drop from orbit is a fight for survival. Build shelter, craft weapons, hunt for food, and seek your fortune in exotic matter. \n\nSurvive alone or with up to four players in this uncompromising PvE survival game from the creator of DayZ.\n\nThe New Frontiers Expansion is included from the start, transforming ICARUS: Console Edition into a larger, deadlier but more rewarding survival experience. Discover new maps, missions, creatures, and rewards.\n________________________________________\nA PLANET THAT FIGHTS BACK\nICARUS resists your presence; poisoned air, lightning storms that tear apart structures, wildfires that spread unchecked, and predators that stalk in the shadows. It feels like the planet itself wants to drive you back into orbit. \n·       With New Frontiers added from the start, you can explore two 64 km2 maps of handcrafted terrain across forests, mountains, deserts, and caves\n·       Harvest every tree, rock, and creature\n·       Adapt to extreme weather and natural disasters\n________________________________________\nNEW FRONTIERS INCLUDED\nThe Prometheus region, once sealed off by the UDA, is now open. Terraforming failed here completely, leaving raw alien landscapes intact but warped. This expansion expands ICARUS far beyond its original borders:\n·       New Map & biomes: Alien grasslands, volcanic wastelands of molten lava, and dangerous swamplands\n·       Six Narrative Missions: A chained story across Prometheus as you pursue a mysterious whistleblower for the UDA\n·       New Creatures: Face Needlers, Dracs, Dreadwings, and other mutated apex predators, evolved to dominate these zones\n·       New Exotics: Discover a volatile new exotic with unique effects on the flora, plus new exotic plants and over 30 additional workshop items\n·       New Items & Resources: Mine obsidian, clay, scoria, crystallised miasma, and super-cooled ice; craft 100+ new items including weapons, food, recipes, and building tiers\n________________________________________\nTHREE WAYS TO SURVIVE\n·       Open World: Establish permanent bases and explore freely\n·       Missions: Timed contracts where extraction is everything\n·       Outposts: Low-pressure zones for creative building and experimentation\n________________________________________\nPROGRESSION & REWARD\n·       Tech Tree & Talents: Advance from primitive tools to advanced tech\n·       Specialisation: Focus as a hunter, builder, or survivalist\n·       Orbital Workshop: Trade exotic matter for permanent upgrades and equipment\nExotic matter remains the ultimate prize; rare, unstable, and deadly to pursue.\n________________________________________\nSOLO OR CO-OP\nUp to four players can share each drop, combining skills and resources to endure. Prefer to go it alone? Survive solo with a Solo Talent Tree for maximum challenge.\nNote: ICARUS: Console Edition does not support cross-play.","developerName":"GRIP Studios","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.61419.14542525630859903.85c6d474-5d02-498b-aab0-48af31d8faaa.6b7ef142-42c1-4372-a512-fcdd44a9dbf5","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.48508.14542525630859903.85c6d474-5d02-498b-aab0-48af31d8faaa.44e542c9-f889-4bbf-9b3e-a4d94abc03a8","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.10291.14542525630859903.85c6d474-5d02-498b-aab0-48af31d8faaa.05861847-a58a-4e12-9627-ec27403ac6c2","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P3H2PVZZPSD","productKind":"Game","publisherName":"GRIP Studios","ratingCount":659,"releaseDate":"2026-03-26T15:00:00.0000000Z","shortDescription":"From the creator of DayZ, comes ICARUS: Console Edition, a PvE survival game for up to four players. Explore a hostile frontier. Survive the Open World, complete timed Missions, or build your Outpost as you explore, craft, hunt, and prospect for exotic matter.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B1TSGNCWPB0Z","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9WLB0NH5HD97","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"ICARUS: Console Edition","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F75bdf37d-3315-406e-9d2d-dc4e44572f09-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.13597.14542525630859903.9f71d64b-5e5a-423f-814b-ce55b5deb31b.0a4e75b5-7ffe-47aa-aea3-2b977548d735","width":1920,"height":1080,"caption":"Launch Trailer"}}],"passMetadataByPassProductId":{},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9NC4WDL5KZBL":{"availableOn":["XboxOne","XboxSeriesX","PC","XCloud","Handheld"],"averageRating":3,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Shooter","Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Blood","Violence","Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["In-Game Purchases"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"A survival-action game inspired by real-life events, Atomfall is set five years after the Windscale nuclear disaster in Northern England.\nExplore the fictional quarantine zone, scavenge, craft, barter, fight and talk your way through a British countryside setting filled with bizarre characters, mysticism, cults, and rogue government agencies.\nFrom Rebellion, the studio behind Sniper Elite and Zombie Army, Atomfall will challenge you to solve the dark mystery of what really happened.\nPlayer Driven Mystery: Unravel a tapestry of interwoven narratives through exploration, conversation, investigation, and combat, where every choice you make has consequences.\n\nSearch, Scavage, Survive: You’ll need to scavenge for supplies, craft weapons and items, and fight desperately to make it out alive!\n\nDesperate Combat: With weapons and ammunition scarce, each frenetic engagement will see you blend marksmanship with vicious hand-to-hand combat. Manage your heart rate to hold a steady aim and ensure you have the energy you need to reach for your cricket bat and land the killer blow.\n\nGreen and Unpleasant Land: The picturesque British countryside, with rolling green hills, lush valleys, and rural villages belie the dangers that await you. Navigate cult-controlled ruins, natural caves, nuclear bunkers and more as you explore this dense, foreboding world.\n\nReimagining Windscale: A fictional reimagining of a real-world event, Atomfall draws from science fiction, folk horror, and Cold War influences to create a world that is eerily familiar yet completely alien.","developerName":"Rebellion","hasAddOns":true,"hhVerified":{"deviceEvaluation":1},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.43253.13575061151050973.cebfa75f-b2f4-4dde-99fa-c709bab904af.e292a86b-4157-4340-b5a4-9d55a11c0f3e","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.34329.13575061151050973.cebfa75f-b2f4-4dde-99fa-c709bab904af.9b26f97c-19cc-4602-8f8d-27a7ab70c8b0","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.15012.13575061151050973.cebfa75f-b2f4-4dde-99fa-c709bab904af.a2bea58d-f1fe-4201-895c-59870cfa2c80","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSatisfyingPassId":"CFQ7TTC0P85B","optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NC4WDL5KZBL","productKind":"Game","publisherName":"Rebellion","ratingCount":4129,"releaseDate":"2025-03-27T14:00:00.0000000Z","shortDescription":"A nuclear disaster has left an area of Britain in tatters. Atomfall, a new survival-action game, will see you explore, scavenge, craft, barter and fight your way through beautifully recreated scenery in search of answers.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9R3J1NLK5SWJ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"10\u002F01\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":59.99,"msrp":59.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B05X2NSCSPL8","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"10\u002F01\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":59.99,"msrp":59.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Atomfall","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fe3869d10-f882-4461-8a1a-9c458e953465-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Features Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.3457.13575061151050973.3d823ca3-9a59-401d-8518-f2a2c60e7f96.2723196f-cdfd-4532-a255-dc3b5adc0cc3","width":1920,"height":1080,"caption":"Features Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fa7eb345e-fa97-42b8-b33a-1a373900095f-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.57984.13575061151050973.e8d9ff25-882c-4e2a-82b7-1c88c577d738.b77ee85f-7447-4c3c-bf53-ea7999396976","width":1920,"height":1080,"caption":"Launch Trailer"}}],"xCloudProperties":{"xCloudId":"ATOMFALL","xboxTitleId":1880835530,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2025-03-27T14:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2025-03-27T14:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2025-03-27T14:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2026-01-07T00:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"ATOMFALL","xboxTitleId":1880835530,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9N9QJG4S82B5":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":3.8,"badges":[{"type":3},{"type":5}],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence","Mild Blood","Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["In-Game Purchases","Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Avatar: Frontiers of Pandora™ is a third and first-person action-adventure game set in the never-before-seen Western Frontier of Pandora. Abducted by the human militaristic corporation known as the RDA, you, a Na’vi, were trained and molded to serve their purpose. Fifteen years later, you are free, but find yourself a stranger in your birthplace. Reconnect with your lost heritage, discover what it truly means to be Na’vi, and join other clans to protect Pandora from the RDA.\n\nEXPLORE A WORLD OF WONDER AND DANGER\nExperience the epic wonders of the Western Frontier, a never-before-seen continent of Pandora. Journey through beautiful yet unpredictable open world regions, where lowering your guard can lead to deadly mistakes.\n\nBECOME NA’VI\nHarness your incredible strength and agility while customizing your character, crafting new gear, and upgrading skills and weapons to fit your playstyle.\n\nSOAR THE SKIES\nBond with your own personal banshee that will give you an edge in aerial combat and can be used for traveling across the vast Western Frontier.\n\nMASTER MULTIPLE COMBAT STYLES\nFight off the dangers of Pandora as you embrace the precision of traditional Na’vi weapons, including your bow and spear-thrower, or leverage your human training with more destructive weapons, such as an assault rifle or a shotgun.\n\nAN IMMERSIVE NEXT-GEN EXPERIENCE\nDeveloped to maximize the power of Xbox Series X|S, Avatar: Frontiers of Pandora will push the limits of immersion with extraordinary levels of detail, rendering, density, and immersive audio.\n\nSHARE YOUR ADVENTURE IN FULL CAMPAIGN CO-OP\nPlay the full story campaign in single-player or with a friend online in two-player co-op.\n\nInternet connection, Ubisoft account, Microsoft Account and Game Pass Ultimate or Core (subscriptions sold separately) required to access online multiplayer\u002Ffeatures.","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.50141.13532281981722910.c73fcb29-e2af-4599-b241-4a8bde2d732c.cbde65aa-9952-4b20-a8c0-24ca51c1ea83","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.63545.13532281981722910.c73fcb29-e2af-4599-b241-4a8bde2d732c.76656ba3-0068-4f3f-a1da-c78cbc798b87","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.10969.13532281981722910.c73fcb29-e2af-4599-b241-4a8bde2d732c.b9f50dd2-d2c0-412a-8556-a6cf52ac0cfa","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0QH5H"],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9N9QJG4S82B5","productKind":"Game","publisherName":"Ubisoft","ratingCount":2232,"releaseDate":"2023-12-07T08:00:00.0000000Z","shortDescription":"Avatar: Frontiers of Pandora™ is a third and first-person action-adventure game set in the never-before-seen Western Frontier of Pandora. Reconnect with your lost heritage and discover what it means to become Na’vi as you join other clans to protect Pandora from the formidable forces of the RDA.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9Q1SHGC55THR","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9T036N88756Z","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Avatar: Frontiers of Pandora™","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F707fcdfe-4278-4970-8e1b-017764e42d07-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"World Premiere Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.36886.13532281981722910.e642a53f-9af1-409d-be36-e2aa0ffde3da.1f3be7d3-02fd-461f-9b8d-8830e069048e","width":1920,"height":1080,"caption":"World Premiere Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F010b306e-4747-4fef-9b38-5ab3f89c4341-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Official Story Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.63004.13532281981722910.bf97deae-b598-4a16-8e96-cd3b344e42a8.4b5f822c-fcee-4638-978c-d4b2ebff5dbc","width":1920,"height":1080,"caption":"Official Story Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fbc3c4226-a0a6-4adf-bb74-8917deb65202-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Season Pass","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.53741.13532281981722910.713739ce-e792-4ff8-95b7-f79bb2a7e463.06fe5253-bb2b-482a-8923-fad2df3a241a","width":1920,"height":1080,"caption":"Season Pass"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F240c6ca5-432c-4783-8e55-a179e987394d-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Launch trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.46954.13532281981722910.945bc525-8ac3-4815-94e5-1a69bf8bd9a9.27fd94e8-d606-40e7-a029-7ebeb2f312a3","width":1920,"height":1080,"caption":"Launch trailer"}}],"xCloudProperties":{"xCloudId":"AVATARFRONTIERSOFPANDORA","xboxTitleId":1682363458,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2026-02-17T15:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2026-02-17T15:00:00Z"},"CFQ7TTC0QH5H":{}},"xCloudPropertiesV2":{"xCloudId":"AVATARFRONTIERSOFPANDORA","xboxTitleId":1682363458,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9P1GTVHTSMT4":{"availableOn":["XboxSeriesX","PC","Handheld"],"averageRating":4.1,"badges":[],"categories":["Action & adventure","Platformer","Simulation"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Violence","Blood"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"Work fast, stay safe, and protect your cat\n\nYou wake up in a dark warehouse, tasked with packing orders while something lurks in the shadows. Work fast, stay safe, and protect your cat. He’s all you’ve got.\n\nYou’re all alone working at a remote fulfillment center. Your only companion is your cat, a comforting presence in the vast, dark warehouse you are stationed in. Start each shift by reviewing incoming orders, as the demands increase, unlock deeper sections of the warehouse and uncover its unsettling secrets. But it’s not just your survival, your cat depends on you.\n\nFeatures:\n\n- Order Fulfillment Simulation: Retrieve, pack, and ship items while meeting tight quotas.\n- Navigate a warehouse where danger grows with every step.\n- Each death places you in a new warehouse where dynamic events create unpredictable challenges.\n- Unlock and explore new areas, piecing together the dark truths within.\n- Protect and care for your cat, your only source of comfort and connection.\n- Upgrade your tools to enhance your efficiency and chances of survival.","developerName":"Cybernetic Walrus","hasAddOns":false,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.36042.14511672593686985.6a4ae8b3-4f83-43db-893f-0767eb147f28.7f96e9e2-baf3-4a4b-b22d-1a694ed2fcc2","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.1561.14511672593686985.6a4ae8b3-4f83-43db-893f-0767eb147f28.5c5fa40e-a5ba-4818-bc1b-9be905ea5173","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.5878.14511672593686985.6a4ae8b3-4f83-43db-893f-0767eb147f28.a42a5a7b-a40e-4645-a8a0-c8b0c54a4375","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P1GTVHTSMT4","productKind":"Game","publisherName":"JanduSoft","ratingCount":21,"releaseDate":"2026-03-06T00:00:00.0000000Z","shortDescription":"Work fast, stay safe, and protect your cat","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9VQJRTB5JLM2","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":10.49,"msrp":10.49,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B1K9WLT5R1S9","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":10.49,"msrp":10.49,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Order 13","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F9915bd70-2e04-459d-8db7-ff7e97a0e20c-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Order 13 - Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.39425.14511672593686985.6a4ae8b3-4f83-43db-893f-0767eb147f28.5be4e10b-5a01-4db5-ae4a-35ecea7f240e","width":1920,"height":1080,"caption":"Order 13 - Launch Trailer"}}],"passMetadataByPassProductId":{},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9P5BRS3LJN26":{"availableOn":["XboxOne","XboxSeriesX","XCloud"],"averageRating":3.7,"badges":[],"categories":["Action & adventure","Simulation","Role playing"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Violence","Sexual Themes","Use of Alcohol And Tobacco","Strong Language","Crude Humor"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"Bum Simulator is a sandbox game bursting with inappropriate humor and memorable characters. Apart from day-to-day survival, you can enjoy many unique features.\r\n\r\nYou can throw pigeons at people and watch as the panic ensues. Not fun enough? Upgrade your birds with explosives and let chaos reign. Still not satisfied? Wait until you see the fully upgraded pigeonado skill…\r\n\r\nMix alcohol with stuff you found on the ground to create powerful mixtures. Drink them (if you dare) to get a boost, or throw them at your enemies for a devastating effect.\r\n\r\nEvery bum needs a shopping cart of their own. Yours is named Carl and he’s your trusty mobile inventory. Also, he’s your best friend (no, really). You’ll learn to love him - we promise!\r\n\r\nMutant sewer rat people from the ’80s? Mentally unstable clown with a hook for a hand? A bored rich man telling you to punch random people on the street? We have them all, and then some! You’ll meet them all while following the insane storyline (yes, this game has an actual story!)\r\n\r\nDay-to-day survival can be exhausting, so why not take a break and get some shut-eye in a cozy shelter? Conquer, construct, and customize your cardboard bases to your heart’s content. However, remember to build some defenses as the rival bum gang raids are inevitable!\r\n\r\nCrafting makes your life easier. Collect materials and process them to get upgrades and expansions to your base. Tired of searching for food? Construct pots and plant some vegetables. Need stronger pigeons? Better upgrade that coop. Scavenging for scrap got boring? Recruit other bums to do the dirty work for you. With enough work, you can build a truly self-sustainable bum base!\r\n\r\nHear ye, hear ye! Every character in the game is fully voiced. Each line of dialogue oozes emotion and personality, which makes the game's storyline and atmosphere even gross… er… more engrossing!","developerName":"Ragged Games S.A. \u002F Console Labs S.A.","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.32651.14571915730728501.47e7f17c-5ac6-46c5-8d5e-f74753cce689.12c3a18d-22c3-406b-8c0c-f39c9ab808fd","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.12470.14571915730728501.47e7f17c-5ac6-46c5-8d5e-f74753cce689.f2253e2e-26df-4efc-a2c8-2c3e5466de9e","width":720,"height":1080},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.3034.14571915730728501.47e7f17c-5ac6-46c5-8d5e-f74753cce689.27bf6630-882b-4631-95ca-20a396160492","width":1920,"height":1080}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P5BRS3LJN26","productKind":"Game","publisherName":" PlayWay S.A.","ratingCount":109,"releaseDate":"2024-12-13T20:00:00.0000000Z","shortDescription":"Bum Simulator is a sandbox game bursting with inappropriate humor and memorable characters. You live on the streets of Bumsville. Do you have what it takes to adapt, survive and become an urban legend?","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B0H58Z6LWDJQ","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":19.99,"msrp":19.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9QMP2L5HK4JF","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":19.99,"msrp":19.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Bum Simulator","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F804de53a-40f6-4c9c-a588-991cec02bee8-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.47445.14571915730728501.47e7f17c-5ac6-46c5-8d5e-f74753cce689.3ad6dda7-3eea-463e-b725-f9e0847e02cd","width":1920,"height":1080,"caption":"Trailer"}}],"xCloudProperties":{"xCloudId":"BUMSIMULATOR","xboxTitleId":1950881463,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"BUMSIMULATOR","xboxTitleId":1950881463,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9P7ZG9MQKKLN":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":4.1,"badges":[],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Intense Violence","Blood and Gore","Partial Nudity","Use of Drugs","Strong Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"Pre-order the Standard Edition now to get the exclusive Hero of Harran Bundle, which contains:\n– Ultimate Survivor Outfit\n– Harran Combat Knife (+ Upgradable Blueprint)\n– The Follower Crossbow (+ Upgradable Blueprint)\n– In Jade’s Memory Pistol (+ Upgradable Blueprint)\n– Castor Woods Patrol \n\nYou are Kyle Crane. After being captured by the Baron and enduring his painful experiments for years, you escape. But the scars remain. Left on the edge of humanity with both human and zombie DNA, you struggle to control your inner beast and the conflict that comes with it. But you’ll need to, if you want to get your revenge on the man who did this to you. A unique blend of open world and action survival horror, Dying Light: The Beast is set in the beautiful, yet dangerous valley of Castor Woods that’s now overrun with zombies rather than tourists. To take your former captor down, you’ll need to form fragile alliances, as well as utilize all the combat and traversal options in your arsenal. But be careful: out here, each step is a fight for survival, especially once the sun sets and the tension heightens as the true horrors come out at night!\nHalf Beast, Half Survivor\nBecome Kyle Crane, a unique hero with DNA of a survivor… and a beast. Switch between two playstyles and experience a fierce inner conflict between man and monster, leading to the ultimate embrace of unstoppable strength.\n\nPrimal Brutality\nTake the raw savagery of Dying Light’s combat to the extreme and push brutality beyond human limits as you crush skulls, rip heads off, and tear enemies in half struggling to control the hero's constantly evolving, rage fueled, beast-like powers.\n\nOwn the day, fear the night\nA signature of the Dying Light series - two vastly different experiences of day and night merge into one unforgettable whole. Scavenge and explore by day, mindful of the constant tension of the moving clock - as when the sun sets, the night unleashes horrors that leave you with only three choices: run, hide, or fight for your life.\n\nRun the Rooftops, Rule the Roads\nFeel the rush of best-in-class first-person parkour as you jump from rooftop to rooftop and climb over any obstacle using a movement system accessible to all, yet rewarding those who master it. Then take the wheel of an off-road vehicle and plow through hordes of zombies enjoying unparalleled freedom of open world traversal.\n\nBeautiful Zombie Apocalypse\nBreathtaking next-gen visuals bring the handcrafted zombie apocalypse to life, where every detail tells a story of survival. Get lost in the majesty of Swiss-Alps inspired valley of Castor Woods with various biomes - tourist town, industrial area, national park, farm fields, swamps - full of beauty… and decay.\n\nShare the adventure\nBand together in up to 4-player co-op to take on the dangers of Castor Woods, where every fight, every discovery and every twisting step of the story can be faced as a group. Use shared progression to conquer the entire adventure side by side, as you face relentless enemies, scavenge for resources and save each other from the brink of death.","developerName":"Techland","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.21999.14102787083896651.ea3348c6-a4e1-4aea-a11d-d22d013e3779.e27dea73-d37e-45c6-92e9-e957dd52e581","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.42525.14102787083896651.ea3348c6-a4e1-4aea-a11d-d22d013e3779.2e836e64-aa0c-45a1-b54c-35cbf73fd196","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.31976.14102787083896651.ea3348c6-a4e1-4aea-a11d-d22d013e3779.7c30cfeb-3b78-4026-be3f-08f2f2b92df8","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P7ZG9MQKKLN","productKind":"Game","publisherName":"Techland","ratingCount":2088,"releaseDate":"2025-09-18T16:00:00.0000000Z","shortDescription":"Dying Light: The Beast is a thrilling standalone zombie adventure set in a tightly-crafted rural region. Play as Kyle Crane, a legendary hero who breaks free after years of brutal experiments. Now, he must realize there’s more at stake than just revenge.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B26DLGX0JHNQ","discountPercentage":33.005505,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":40.19,"msrp":59.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9X0R1ND8C6JG","discountPercentage":33.005505,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":40.19,"msrp":59.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Dying Light: The Beast","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F3f36d710-c557-44ff-8d3a-e1f6d86c6334-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Castor Woods #1","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.51115.14102787083896651.d5c68aae-45b6-4d66-96f8-6571ac56a6a8.b23416b0-cbe5-4900-a0e5-39204a38e662","width":1920,"height":1080,"caption":"Castor Woods #1"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Ffa6e20a3-09ff-424c-aedf-73ab3b7c8d96-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"SGF","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.42395.14102787083896651.395045c2-b8f1-4929-ad5c-bbd64a5bff8e.e2e5be57-1bf0-46b2-ab3c-0789b18555b4","width":1920,"height":1080,"caption":"SGF"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F457c5216-45e6-4dc5-ade0-a903a22a6a46-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Part 1 EN","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.20113.14102787083896651.2270e653-e2f3-46f4-9dfc-2d8c185061f1.3a27152e-36f3-407b-b36b-f8aca8df8b0c","width":1920,"height":1080,"caption":"Part 1 EN"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F12fde580-ca8d-49a3-9d16-ed0598a587a1-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Bober The Beaver #2","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.58174.14586422464832714.28afe5ef-602d-4e61-8e95-f9b16ef2563f.d692e2fc-fe38-41f5-b71a-24266e62fd19","width":1920,"height":1080,"caption":"Bober The Beaver #2"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F17574d34-c9a7-4c21-82f5-2103eecef4ac-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Part 2 EN","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.41676.14102787083896651.316ab59f-1961-4cea-bd15-fcdf1be59ae0.aa79bffe-c5a5-4d97-8af7-7fb39c1e75aa","width":1920,"height":1080,"caption":"Part 2 EN"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F31d915f4-225e-4171-9c79-fdc6bf7c019c-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"accolades trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.44983.14102787083896651.be6d7908-a708-4034-ada0-6bf458b351a5.c049cb54-c3a5-4e7f-a14f-e4449837624a","width":1920,"height":1080,"caption":"accolades trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fb6a634f5-f9d5-4bc3-9a6b-58823d4eac59-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"DLTB x PUBGM","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.8743.14102787083896651.fba10032-6adf-4646-9c33-c5e14b322dfb.dc4f310a-549a-47f1-9f1c-1386072c4a3b","width":1920,"height":1080,"caption":"DLTB x PUBGM"}}],"xCloudProperties":{"xCloudId":"DYINGLIGHTTHEBEAST","xboxTitleId":1680544459,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"DYINGLIGHTTHEBEAST","xboxTitleId":1680544459,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9MT19Q3CRMQZ":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":3.8,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Simulation","Racing & flying"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Use of Alcohol","Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Hop into the driver's seat of your rocket-powered big rig as you haul cargo, scavenge for salvage and interact with an eclectic cast of star-hopping truckers in this Americana-infused journey on the ultimate open road - space!\n\nHAUL AND HOLLER\n\nCruise the hyper highways, taking on a variety of jobs such as fuel hungry long hauls and hazardous drop-offs to earn cash and unlock new content.\n\nAnd don't forget to monitor the CB radio for chatter from fellow truckers; it's a fantastic way to uncover side gigs and stay updated on galactic gossip.\n\n\nMANAGE AND MAINTAIN\n\nKeeping your rig runnin’ isn’t always easy. You’ll need to keep your core systems online, gravity compensator spinnin’ and hull patched to prevent your cab from leaking lung juice.\n\nBe sure to make pre-trip shop stops for replacement parts, and consider upgrading your truck at a local garage. These improvements are vital for safely navigating volatile sectors and ensuring timely deliveries.\n\n\nHYPERJUMP!\n\nUse the galactic map to plan your journey and warp jumps, while keeping an eye on your fuel reserves and power levels.\n\nOnce your route is set, kick back, crank up the cab hi-fi and cruise to a selection of original songs covering starburst blues, galactic rock and asteroid infused americana. The open road is waiting!\n\nMADE BY MONSTERS\nStar Trucker is the passion project of a small team: Monster and Monster. A two-person indie studio with a love for all things sci-fi and sim.\n\nWith the help of some talented friends they’ve developed an out of this world experience filled with emergent challenges and complex systems to master. So buckle up and join them for the long haul!","developerName":"Monster and Monster","hasAddOns":true,"hhVerified":{"deviceEvaluation":1},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.57407.13821700683757810.89118bcb-37c3-4645-abe7-b733ccb23ac2.82ae89f2-3536-4c4f-bf3e-257c62a2f2f9","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.8297.13821700683757810.89118bcb-37c3-4645-abe7-b733ccb23ac2.13463818-cf7c-4b5a-8264-720e092078ee","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.16851.13821700683757810.89118bcb-37c3-4645-abe7-b733ccb23ac2.e1affadc-0fc7-4702-9da4-2004fdbc4a50","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9MT19Q3CRMQZ","productKind":"Game","publisherName":"Raw Fury","ratingCount":1569,"releaseDate":"2024-09-03T14:00:00.0000000Z","shortDescription":"Haul cargo, trade salvage and keep your space suit close as you search for fame and fortune among the stars in a game that puts an interstellar twist on the truck sim genre. ","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9TR8V9F21NXB","discountPercentage":60.02401,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":9.99,"msrp":24.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B4XGVFFXCTBX","discountPercentage":60.02401,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":9.99,"msrp":24.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Star Trucker","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F3a24536e-37f8-40a2-aefe-eeece50d4acd-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.28141.13821700683757810.2daca4f7-bee5-417f-b4f0-dd5cff439b7f.d2c68d14-e856-47c3-8416-19cae280ace4","width":1920,"height":1080,"caption":"Launch Trailer"}}],"xCloudProperties":{"xCloudId":"STARTRUCKER","xboxTitleId":1848367053,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2024-09-03T14:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2024-09-03T14:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2024-09-03T14:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-06-06T00:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"STARTRUCKER","xboxTitleId":1848367053,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9NPR2CG6S95Q":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":4.6,"badges":[],"categories":["Simulation","Strategy"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Satisfactory is a first-person open-world factory building game with a dash of exploration and combat. Play alone or with friends, explore an alien planet, create multi-story factories, and enter conveyor belt heaven!\n\nConstruct\nConquer nature by building massive factories across the land. Expand wherever and however you want. The planet is filled with valuable natural resources just waiting to be utilized. As an employee of FICSIT it’s your duty to make sure they come to good use.\n\nAutomate\nConstruct your factories with gracious perfection or build intricate webs of conveyor belts to supply all your needs. Automate trucks and trains to reach your faraway outposts and be sure to handle liquids properly by transporting them in pipes. It’s all about minimizing manual labor!\n\nExplore & Exploit\nVenture on expeditions to search for new materials and be sure to put everything to good use. Nature is yours to harvest! You have vehicles, jetpacks, jump pads and more at your disposal to make the exploration easier. Equip the proper safety gear as well, just in case you run into the local wildlife.\n\nFEATURES\n• Open World: Explore the huge (30km²) alien planet that is Massage-2(AB)b with its unique fauna and creatures.\n• Co-Op: Build a factory yourself or share the joy with your friends. Up to you!\n• Factory Building: Experience building a huge factory from a first-person perspective. Automate and optimize it to perfection for your personal satisfaction.\n• Customization: Customize your factory to your own liking. Build at high altitudes or over wide plains, there is almost no limits in the making of your tailor-made factory.\n• Vehicles: Travel the world with class. Use jump pads, factory carts, jetpacks, hypertubes, trucks or trains. The choice is yours!","developerName":"Coffee Stain Studios","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.55986.13784230449865111.9212e30a-10f2-4aed-9643-6dccce6b5481.9c0c0579-cf40-46e1-8ee2-59f849fc1cb1","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.3312.13784230449865111.9212e30a-10f2-4aed-9643-6dccce6b5481.3e408d39-55cc-49cc-8473-5ba97e5fd956","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.5471.13784230449865111.9212e30a-10f2-4aed-9643-6dccce6b5481.2eba87f3-e798-45b2-927a-f8c6ea4f0a45","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NPR2CG6S95Q","productKind":"Game","publisherName":"Coffee Stain Publishing","ratingCount":605,"releaseDate":"2025-11-04T13:00:00.0000000Z","shortDescription":"Satisfactory is a first-person open-world factory building game with a dash of exploration and combat. Play alone or with friends, explore an alien planet, create multi-story factories, and enter conveyor belt heaven! ","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B1NH7WVV2W86","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9P24G16LH0XG","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":39.99,"msrp":39.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Satisfactory","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fa88475b1-6f13-4704-b497-9b313b3af62d-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Satisfactory Xbox Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.44052.13784230449865111.9212e30a-10f2-4aed-9643-6dccce6b5481.a5536b7d-6fb4-4fbd-8b34-aab4b35fb8c0","width":1920,"height":1080,"caption":"Satisfactory Xbox Launch Trailer"}}],"xCloudProperties":{"xCloudId":"SATISFACTORY","xboxTitleId":1966276493,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"SATISFACTORY","xboxTitleId":1966276493,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9PNKG0WBL61W":{"availableOn":["PC","XboxSeriesX","XCloud","Handheld"],"averageRating":3.8,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Racing & flying","Role playing","Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 13 and up","disclaimers":[],"descriptors":["Fantasy Violence","Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.17268.image.4cc004ee-a56d-4f11-ae99-67a89379b743.13d51d69-d3ba-4760-8fdf-f996abafa50a","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"TEEN","ratingAge":13,"ratingDescription":"For ages 13 and up"},"description":"Pacific Drive is a first-person driving survival game with your car as your only companion. Navigate a surreal reimagining of the Pacific Northwest, and face supernatural dangers as you venture into the Olympic Exclusion Zone. Each excursion into the wilderness brings unique and strange challenges as you restore and upgrade your car from an abandoned garage that acts as your home base. Gather precious resources and investigate what’s been left behind in the Zone; unravel a long-forgotten mystery while learning exactly what it takes to survive in this unpredictable, hostile environment.\n\nDRIVE TO SURVIVE\nIt’s you and your station wagon against an unforgiving, vicious world. It’ll take more than a fresh set of tires to keep you alive, on and off the road. Your faithful wagon can be upgraded and reinforced to protect you, but the car is going to take a beating. Keep your gas tank filled and your panels intact to withstand the radiation permeating the Zone. You’ll be pushed to your limit - making repairs on the fly, scavenging materials wherever you can, and adapting your rolling fortress to tackle the many life-threatening dangers that lurk in the shadows.\n\nINVESTIGATE THE ZONE\nThe experimental leftovers of the secretive ARDA organization remain scattered across the Zone, and finding answers won’t be easy. Everywhere you look you’ll find anomalies, surreal forces of a twisted nature that make your journey more difficult... or more interesting. Silhouettes in the dark, rolling piles of scrap metal, and towering pillars of earth - each outing from your garage is packed with otherworldly hazards. As terrifying as those may be, nothing compares to the overwhelming power of a Zone Storm. Stomp on the gas and outrun it if you can - these rolling maelstroms rend the landscape and obliterate anything that sticks around too long. Don’t let that be you.\n\nREPEAT\nCheck the map, pack some gear for the trip, and hit the road. Gather resources and collect data as you go, there’s all sorts of useful stuff inside the walls of the Zone. Make it back safely and use the contents of your trunk to improve your car and garage. Every time you venture out, new trials await: bizarre weather, unforgiving landscapes, and experimental remnants. The golden rule in the Zone is ‘nothing ventured, nothing gained’ — some materials can only be found in the most dangerous places. Be smart out there, and don’t waste time — it’s going to be a long haul.\n","developerName":"Ironwood Studios ","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.30777.14342694787118182.96ac9113-88e6-4c27-822e-b852c773b5cc.9664d48f-5494-4d80-b8a1-253008354cf2","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.9028.14342694787118182.96ac9113-88e6-4c27-822e-b852c773b5cc.479a98da-1b02-4315-86a1-a5df93ed489a","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.32152.14342694787118182.96ac9113-88e6-4c27-822e-b852c773b5cc.55f5e57e-9a6a-4f91-ac0a-e609202b02ea","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9PNKG0WBL61W","productKind":"Game","publisherName":"Kepler Interactive","ratingCount":659,"releaseDate":"2025-10-23T19:00:00.0000000Z","shortDescription":"Face the supernatural dangers of the Olympic Exclusion Zone with a car as your only lifeline in this driving survival adventure! Scavenge resources, load up your trusty station wagon, and drive like hell to make it through alive.","showSupportedLanguageDisclaimer":true,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9RSN3983STPN","discountPercentage":65.021675,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":10.49,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B4V84HC9WJMV","discountPercentage":65.021675,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":10.49,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Pacific Drive","videos":[],"cmsVideos":[],"xCloudProperties":{"xCloudId":"PACIFICDRIVE","xboxTitleId":2115352193,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2025-10-23T19:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2025-10-23T19:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2025-10-23T19:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-10-23T19:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"PACIFICDRIVE","xboxTitleId":2115352193,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9P7ZBF3S7PSS":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":3.4,"badges":[],"categories":["Shooter","Action & adventure","Role playing"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Blood and Gore","Intense Violence","Use of Alcohol And Tobacco","Strong Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"S.T.A.L.K.E.R. 2: Heart of Chornobyl is the unforgiving FPS survival adventure in a dark science-fiction open world. Scavenge for gear and resources, hunt for wonders, make hard decisions to survive and pave the path through the Chornobyl Anomalous Zone.\n\nTHE ZONE\nThousands of adventurers from all over the world find a new life here, in a mysterious and dangerous place on the land of the Chornobyl Anomalous Exclusion Zone. Become one of them, and start your own through an immense, atmospheric open world, full of dangers and mysteries. Shed light on the dark secrets of the second disaster, hunt mutants, and explore the hazardous anomalies in search of precious artifacts.\nWill your skill and courage be enough to overcome anomalous and human threats, or will you become one of many who lost to the Zone?\n\nTHE STORY\nThe Zone keeps hundreds of secrets and thousands of stories, revealing them only to the bravest and most dexterous. Starting as a lone stalker, explore a unique post-apocalyptic world and decide who will get a bullet and who is worthy of your helping hand. And while making decisions, be sure: many choices and actions will have their own, sometimes far from the obvious, consequences.\nTo be a savior and a faithful friend, the figure for stalker's campfire legends. Or to carry out harsh, but profitable missions for those who are in control of the Zone — you are free to be anyone here, even yourself.\n\nTHE DANGER\nBandits, mercenaries, official authority forces, lone stalkers, various factions, and mutants… The world of «S.T.A.L.K.E.R. 2: Heart of Chornobyl» is full of predators who strive to seize your loot or get a taste of human flesh. Analyzing their behavior and picking specific tactics for each species is the only way to win or at least get out of the fight alive.\nThere is no absolute safety because your foremost enemy is the Zone itself, capable of challenging all your skill and courage at the most unexpected moment.\n\nTHE ACTION\nThe Zone has become a perfect black market for weaponry from all around the world. This means that in the potential arsenal of stalkers, there are more than 30 models of various firearms and the ingenuity of gunsmiths who are ready to modify them for greater lethality and reliability. Define your distinctive combat style, select the most efficient weapon, and customize it to your taste for maximal tactical advantage.\nA wise stalker said: the most dangerous weapon is not the gun in your holster but the gumption, tenacity, and sharp reflexes. Keep that in mind on your path to the Heart of Chornobyl!\n\n\nCertain features of the game, including mods, may not be accessible to Xbox child accounts. On Xbox, a child is defined as a player under the age of 13, unless local laws specify otherwise.","developerName":"GSC Game World","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.2713.14102836618611203.a0c0e3ae-152e-400e-9afe-a59e5468b2a6.076ba899-f19f-43f1-b62b-1b78910f2974","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.15281.14102836618611203.a0c0e3ae-152e-400e-9afe-a59e5468b2a6.d7860502-077b-4921-9223-d5c6112896bd","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.60553.14102836618611203.7e33768f-3f4c-4982-9528-7233be70e203.4e7815ef-c368-43ae-adf2-edf5f81cc28d","width":1920,"height":1080}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9P7ZBF3S7PSS","productKind":"Game","publisherName":"GSC Game World","ratingCount":7076,"releaseDate":"2024-11-20T16:00:00.0000000Z","shortDescription":"S.T.A.L.K.E.R. 2: Heart of Chornobyl is the unforgiving FPS survival adventure in a dark science-fiction open world. ","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"B231FVGDVQZT","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":59.99,"msrp":59.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B0M1PJF9G8WN","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"12\u002F30\u002F9998 00:00:00","hasXPriceOffer":false,"listPrice":59.99,"msrp":59.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"S.T.A.L.K.E.R. 2: Heart of Chornobyl","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F7eb5e981-e1b1-4cbd-a67f-15be2ca17a10-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - Scar Official Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.10750.14102836618611203.a0c0e3ae-152e-400e-9afe-a59e5468b2a6.245413a2-826f-4efe-ad9e-c58afa1216bc","width":1920,"height":1080,"caption":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - Scar Official Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fe002aad7-dd3c-4844-951d-66f5db4afbdb-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - World and Locations Official Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.2925.14102836618611203.a0c0e3ae-152e-400e-9afe-a59e5468b2a6.8a1673af-cf10-4258-8b0d-8e6b181e31c7","width":1920,"height":1080,"caption":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - World and Locations Official Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002Fb06da691-9f1f-407d-b02e-d262ad3663f3-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - Smoking Barrels Deep Dive","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.29026.14102836618611203.a0c0e3ae-152e-400e-9afe-a59e5468b2a6.f51f6ba1-9bce-481a-9efe-ada1b12f3257","width":1920,"height":1080,"caption":"S.T.A.L.K.E.R. 2: Heart of Chornobyl - Smoking Barrels Deep Dive"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F291b3adb-cc00-41b2-ae4f-649282917a12-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":2160,"width":3840,"title":"S.T.A.L.K.E.R. 2: Heart of Chornobyl — Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.43439.14102836618611203.d565774f-a3ce-4075-ae25-09361477c081.c076c640-613b-4568-8abb-c8671caca1a7","width":1920,"height":1080,"caption":"S.T.A.L.K.E.R. 2: Heart of Chornobyl — Launch Trailer"}}],"xCloudProperties":{"xCloudId":"STALKER2HEARTOFCHORNOBYLXBOXEDITION","xboxTitleId":2005028938,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2024-11-20T16:00:00Z","exitDateUTC":"2025-11-16T10:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2024-11-20T16:00:00Z","exitDateUTC":"2025-11-16T10:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-05-22T00:00:00Z","exitDateUTC":"2025-11-16T10:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"STALKER2HEARTOFCHORNOBYLXBOXEDITION","xboxTitleId":2005028938,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","MKB"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"9PHFJ0N31NV1":{"availableOn":["PC","XboxSeriesX","XCloud","Handheld"],"averageRating":4.4,"badges":[],"categories":["Action & adventure","Shooter"],"contentRating":{"boardName":"ESRB","description":"For ages 10 and up","disclaimers":[],"descriptors":["Fantasy Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.56093.image.e3da543f-ed61-47ce-bc12-683dab90c502.5e57d206-3b82-4a7b-9b98-d1548cd450a8","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"EVERYONE 10+","ratingAge":10,"ratingDescription":"For ages 10 and up"},"description":"Slime Rancher 2 is a sequel to the award-winning, smash-hit original that has been enjoyed by over 10 million fans worldwide. Continue the adventures of Beatrix LeBeau as she journeys to Rainbow Island, a mysterious land brimming with ancient technology, unknown natural resources, and an avalanche of wiggling, jiggling, new slimes to discover.\n\nAs Beatrix attempts to unravel the island’s secrets and uncover its true purpose, she’ll build, ranch, and farm within a beautiful conservatory, whose sparkling glass walls give her full view of the prismatic paradise she now calls home.","developerName":"Monomi Park","hasAddOns":false,"hhVerified":{"deviceEvaluation":1},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.49583.14232893733292770.8250c76d-8c58-4fda-ab63-37a304804465.ac1a2840-fb24-4e18-9c6a-0a663298825e","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.26469.14232893733292770.8250c76d-8c58-4fda-ab63-37a304804465.0d51f4b0-4929-4e8d-a1e7-f58f6a7b38ad","width":720,"height":1080},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.54440.14232893733292770.922deeaa-f116-48ec-8f5f-e18d57108027.573e7aa5-d0f6-4cf0-9745-029b4223f9fe","width":1920,"height":1080}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9PHFJ0N31NV1","productKind":"Game","publisherName":"Monomi Park","ratingCount":4606,"releaseDate":"2025-09-23T17:00:00.0000000Z","shortDescription":"Continue the adventures of Beatrix LeBeau as she journeys across the Slime Sea to Rainbow Island, a land brimming with ancient mysteries, and bursting with wiggly, new slimes to wrangle in this sequel to the smash-hit, Slime Rancher.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9WB1FVRHTZ68","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9PCNSCZ29X0M","discountPercentage":40.013336,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":17.99,"msrp":29.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Slime Rancher 2","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F3aa69016-c4fb-43be-999b-68e426bd145d-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Slime Rancher 2 A Hero in Time Update","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.21102.14232893733292770.8250c76d-8c58-4fda-ab63-37a304804465.4b0ef02d-3afb-46e6-84e8-c8a4204092de","width":1920,"height":1080,"caption":"Slime Rancher 2 A Hero in Time Update"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F3248df57-fba9-4042-84bd-a11b85620aaa-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"SR2 Update 1.2 Radiant Slime Sanctuary","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.40815.14232893733292770.872e1054-b690-4b3e-925e-f4a2b35d2fbb.65a15900-7812-4c1f-b479-9b852858c638","width":1920,"height":1080,"caption":"SR2 Update 1.2 Radiant Slime Sanctuary"}}],"xCloudProperties":{"xCloudId":"SLIMERANCHER2","xboxTitleId":1884079219,"supportsTouch":true},"passMetadataByPassProductId":{"CFQ7TTC0KGQ8":{"entryDateUTC":"2022-09-22T17:00:00Z","exitDateUTC":"2024-09-16T10:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2022-09-22T17:00:00Z","exitDateUTC":"2024-09-16T10:00:00Z"},"CFQ7TTC0K6L8":{"entryDateUTC":"2022-09-22T17:00:00Z","exitDateUTC":"2024-09-16T10:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"SLIMERANCHER2","xboxTitleId":1884079219,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller","CustomTouchOverlay","MKB"],"supportsTouch":true},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false}},"productInfoMetadata":{},"skuSummaries":{"BX3S1Q5DVHRD":{"0001":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B2NJLGC9ZSNG","preferredAvailabilityId":"B2NJLGC9ZSNG","productId":"BX3S1Q5DVHRD","skuDescription":"You have crash-landed on an alien ocean world, and the only way to go is down. Subnautica's oceans range from sun drenched shallow coral reefs to treacherous deep-sea trenches, lava fields, and bio-luminescent underwater rivers. Manage your oxygen supply as you explore kelp forests, plateaus, reefs, and winding cave systems. The water teems with life: Some of it helpful, much of it harmful.\r\n\r\nAfter crash landing in your Life Pod, the clock is ticking to find water, food, and to develop the equipment you need to explore. Collect resources from the ocean around you. Craft knives, lights, diving gear, and personal water craft. Venture deeper and further form to find rarer resources, allowing you to craft more advanced items.\r\n\r\nBuild bases on the sea floor. Choose layouts and components, and manage hull-integrity as depth and pressure increase. Use your base to store resources, park vehicles, and replenish oxygen supplies as you explore the vast ocean.","skuId":"0001","skuImages":{},"skuTitle":"Subnautica","isUbisoftConsoleCrossEntitlement":false},"0004":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"BX3S1Q5DVHRD","skuDescription":"You have crash-landed on an alien ocean world, and the only way to go is down. Subnautica's oceans range from sun drenched shallow coral reefs to treacherous deep-sea trenches, lava fields, and bio-luminescent underwater rivers. Manage your oxygen supply as you explore kelp forests, plateaus, reefs, and winding cave systems. The water teems with life: Some of it helpful, much of it harmful.\r\n\r\nAfter crash landing in your Life Pod, the clock is ticking to find water, food, and to develop the equipment you need to explore. Collect resources from the ocean around you. Craft knives, lights, diving gear, and personal water craft. Venture deeper and further form to find rarer resources, allowing you to craft more advanced items.\r\n\r\nBuild bases on the sea floor. Choose layouts and components, and manage hull-integrity as depth and pressure increase. Use your base to store resources, park vehicles, and replenish oxygen supplies as you explore the vast ocean.","skuId":"0004","skuImages":{},"skuTitle":"Subnautica","isUbisoftConsoleCrossEntitlement":false}},"9P4NV23Q6QC2":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9ZT7NVH53GDD","preferredAvailabilityId":"9ZT7NVH53GDD","productId":"9P4NV23Q6QC2","skuDescription":"STORY\nHome to the world's greatest minds, GATE operates a global network of secretive research laboratories, spanning every field of scientific study - and the realms beyond.\n\nAs a GATE employee you extend the bounds of human knowledge, and seek to explain the unexplainable - including anomalies and paranormal entities: from gravity-distorting artifacts to supernatural creatures with an unbridled instinct for violence. Safety, security, and secrecy are of the utmost importance… usually.\n\nAfter a catastrophic containment breach, your workplace has become a cosmic battle zone: anomalous entities are on the loose, enemies from other dimensions are invading via portals, and an arcane military sect - known as The Order - is targeting personnel and entities indiscriminately, aiming to seize artifacts and put an end to the chaos.\n\nContainment procedures have failed and help isn’t on the way. Stranded miles beneath the surface, it’s up to you and your fellow scientists to band together, plan your escape, and make this underground complex your new home - for now.\n\nGAMEPLAY\nAbiotic Factor brings a 90’s sci-fi twist and rich character progression to the multiplayer open world survival crafting genre. Up to 6 players can choose their PHDs, build their scientist, gear up, and explore a massive subterranean complex, filled with supernatural artifacts, transdimensional foes, and science experiments gone awry.\n\nSCIENCE MEETS VIOLENCE\nBetween alien threats hunting their next meal, trigger happy soldiers, and the world’s most advanced robotic security forces attacking personnel working overtime, there’s no shortage of danger. As a scientist, fighting isn’t your forte, so you’ll need to put your PHD to work to outwit your opponents: craft ingenious and outlandish tools, weapons and gear, from simple nets and wooden bats to laser-cannons and elaborate traps - everything your big science brain can muster!\n\nMAINTAIN A HEALTHY WORK LIFE BALANCE\nMake yourself at home - you’re here for the long haul. Scavenge resources from vacant offices and empty labs, raid vending machines, and steal company property to build a new base of operations as you explore the facility. When it’s time for a change of scenery, pack up your belongings and move them across the facility using handcarts, forklifts, SUVs, teleporters, and more.\n\nJOIN THE SCIENCE TEAM\nDon your lab coat and earn your PhD: from Plant Geneticist to Defense Analyst and Structural Engineer (and many, many more), each with its own advantages essential to survival. Combine traits and skills, then level up to earn perks and abilities with your fellow scientists to forge a formidable scientific force.\n\nSURVIVE TO SEE YOUR NEXT DAY OFF\nWorking at GATE may have been a dream job, but dying here wasn’t part of your five year plan. Explore this massive underground facility as well as many worlds beyond and take full advantage of the most advanced technology unknown to mankind in this interdimensional sci-fi adventure!","skuId":"0010","skuImages":{},"skuTitle":"Abiotic Factor","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P4NV23Q6QC2","skuDescription":"STORY\nHome to the world's greatest minds, GATE operates a global network of secretive research laboratories, spanning every field of scientific study - and the realms beyond.\n\nAs a GATE employee you extend the bounds of human knowledge, and seek to explain the unexplainable - including anomalies and paranormal entities: from gravity-distorting artifacts to supernatural creatures with an unbridled instinct for violence. Safety, security, and secrecy are of the utmost importance… usually.\n\nAfter a catastrophic containment breach, your workplace has become a cosmic battle zone: anomalous entities are on the loose, enemies from other dimensions are invading via portals, and an arcane military sect - known as The Order - is targeting personnel and entities indiscriminately, aiming to seize artifacts and put an end to the chaos.\n\nContainment procedures have failed and help isn’t on the way. Stranded miles beneath the surface, it’s up to you and your fellow scientists to band together, plan your escape, and make this underground complex your new home - for now.\n\nGAMEPLAY\nAbiotic Factor brings a 90’s sci-fi twist and rich character progression to the multiplayer open world survival crafting genre. Up to 6 players can choose their PHDs, build their scientist, gear up, and explore a massive subterranean complex, filled with supernatural artifacts, transdimensional foes, and science experiments gone awry.\n\nSCIENCE MEETS VIOLENCE\nBetween alien threats hunting their next meal, trigger happy soldiers, and the world’s most advanced robotic security forces attacking personnel working overtime, there’s no shortage of danger. As a scientist, fighting isn’t your forte, so you’ll need to put your PHD to work to outwit your opponents: craft ingenious and outlandish tools, weapons and gear, from simple nets and wooden bats to laser-cannons and elaborate traps - everything your big science brain can muster!\n\nMAINTAIN A HEALTHY WORK LIFE BALANCE\nMake yourself at home - you’re here for the long haul. Scavenge resources from vacant offices and empty labs, raid vending machines, and steal company property to build a new base of operations as you explore the facility. When it’s time for a change of scenery, pack up your belongings and move them across the facility using handcarts, forklifts, SUVs, teleporters, and more.\n\nJOIN THE SCIENCE TEAM\nDon your lab coat and earn your PhD: from Plant Geneticist to Defense Analyst and Structural Engineer (and many, many more), each with its own advantages essential to survival. Combine traits and skills, then level up to earn perks and abilities with your fellow scientists to forge a formidable scientific force.\n\nSURVIVE TO SEE YOUR NEXT DAY OFF\nWorking at GATE may have been a dream job, but dying here wasn’t part of your five year plan. Explore this massive underground facility as well as many worlds beyond and take full advantage of the most advanced technology unknown to mankind in this interdimensional sci-fi adventure!","skuId":"0011","skuImages":{},"skuTitle":"Abiotic Factor","isUbisoftConsoleCrossEntitlement":false}},"9P7RBKDTN18T":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B3ZKP57DXH6C","preferredAvailabilityId":"B3ZKP57DXH6C","productId":"9P7RBKDTN18T","skuDescription":"Raft™ throws you and your friends into an epic oceanic adventure! Alone or together, players battle to survive a perilous voyage across a vast sea! Gather debris, scavenge reefs and build your own floating home, but be wary of the man-eating sharks!","skuId":"0010","skuImages":{},"skuTitle":"Raft","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P7RBKDTN18T","skuDescription":"Raft™ throws you and your friends into an epic oceanic adventure! Alone or together, players battle to survive a perilous voyage across a vast sea! Gather debris, scavenge reefs and build your own floating home, but be wary of the man-eating sharks!","skuId":"0011","skuImages":{},"skuTitle":"Raft","isUbisoftConsoleCrossEntitlement":false}},"9NQMVR9WL9FW":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B1Q68HFLPNJ8","preferredAvailabilityId":"B1Q68HFLPNJ8","productId":"9NQMVR9WL9FW","skuDescription":"You are an engineer thrust into the strange and mysterious Void, a world with its own history, rules and future. Build and upgrade your own train, craft powerful weapons, fight various enemies and survive the surreal landscapes of the Void alone or together with friends.\n\nEXPLORE THE VOID\nExplore a vast ever-changing world full of mysteries and unique places. Discover floating islands with puzzles and dangerous fauna. Make your way through minefields and visit depots. Meet adorable Rofleemo and make them part of your crew. The Void has much to offer for those seeking adventure, so get ready to accept its challenges!\n\nBUILD YOUR TRAIN\nYou won't simply expand the train, but you'll build it yourself from scratch. Start with an empty trolley and develop it into a proper train with multiple wagons and an advanced engine. Customize the look of your train and fill it with all sorts of objects: from storages and workbenches to decorations and tables for mini games.\n\nFIGHT TO SURVIVE\nThe Void is a dangerous place, and you’ll face a variety of enemies on your way: from regular soldiers to bloodthirsty sharks. Craft and customize your weapons and equipment, escape from being chased, stand against multiple enemy waves in the arenas, clear outposts and be prepared to constantly fight for your life.","skuId":"0010","skuImages":{},"skuTitle":"Voidtrain","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9NQMVR9WL9FW","skuDescription":"You are an engineer thrust into the strange and mysterious Void, a world with its own history, rules and future. Build and upgrade your own train, craft powerful weapons, fight various enemies and survive the surreal landscapes of the Void alone or together with friends.\n\nEXPLORE THE VOID\nExplore a vast ever-changing world full of mysteries and unique places. Discover floating islands with puzzles and dangerous fauna. Make your way through minefields and visit depots. Meet adorable Rofleemo and make them part of your crew. The Void has much to offer for those seeking adventure, so get ready to accept its challenges!\n\nBUILD YOUR TRAIN\nYou won't simply expand the train, but you'll build it yourself from scratch. Start with an empty trolley and develop it into a proper train with multiple wagons and an advanced engine. Customize the look of your train and fill it with all sorts of objects: from storages and workbenches to decorations and tables for mini games.\n\nFIGHT TO SURVIVE\nThe Void is a dangerous place, and you’ll face a variety of enemies on your way: from regular soldiers to bloodthirsty sharks. Craft and customize your weapons and equipment, escape from being chased, stand against multiple enemy waves in the arenas, clear outposts and be prepared to constantly fight for your life.","skuId":"0017","skuImages":{},"skuTitle":"Voidtrain","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NQMVR9WL9FW","skuDescription":"You are an engineer thrust into the strange and mysterious Void, a world with its own history, rules and future. Build and upgrade your own train, craft powerful weapons, fight various enemies and survive the surreal landscapes of the Void alone or together with friends.\n\nEXPLORE THE VOID\nExplore a vast ever-changing world full of mysteries and unique places. Discover floating islands with puzzles and dangerous fauna. Make your way through minefields and visit depots. Meet adorable Rofleemo and make them part of your crew. The Void has much to offer for those seeking adventure, so get ready to accept its challenges!\n\nBUILD YOUR TRAIN\nYou won't simply expand the train, but you'll build it yourself from scratch. Start with an empty trolley and develop it into a proper train with multiple wagons and an advanced engine. Customize the look of your train and fill it with all sorts of objects: from storages and workbenches to decorations and tables for mini games.\n\nFIGHT TO SURVIVE\nThe Void is a dangerous place, and you’ll face a variety of enemies on your way: from regular soldiers to bloodthirsty sharks. Craft and customize your weapons and equipment, escape from being chased, stand against multiple enemy waves in the arenas, clear outposts and be prepared to constantly fight for your life.","skuId":"0011","skuImages":{},"skuTitle":"Voidtrain","isUbisoftConsoleCrossEntitlement":false}},"9N95N2T4ZZV7":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9T747T05QJRZ","preferredAvailabilityId":"9T747T05QJRZ","productId":"9N95N2T4ZZV7","skuDescription":"Creature Lab sets you on a difficult path of a genius, yet a bit wicked scientist with a very liberal approach to test subjects and official procedures. Establish your hideout and let the experiments commence! Conduct crazy experiments, mix mutagens, analyze their properties, grow DNA-based body parts, and attach them to your test subjects.\n\nSo many possibilities… Prepare your laboratory, obtain basic reagents, and see what happens when you mix them together. Don’t forget to name all your recipes! Apply your mutagens to test subjects and observe how they react. Grow entirely new body parts and attach them to the creatures you just brought to life. Discover nearly limitless interactions between mutagens and body parts as you slowly assemble an army of mutants.\n\nThere's no use hoping for government funds so you'll make do with anything you can find or even steal. Manage your inventory, expand your lab, and make sure your hideout is safe. Don’t let the panic guide you, the more stressed you are, the bigger chance Feds will drop by to say hello and check your spot! Don’t leave any traces, be patient and extremely careful! They will never even know what hit them!\n\nRunning low on resources? Need more test subjects? Send your sick creatures into the city! Find whatever resources you need. Spread panic in the city to scare off anyone trying to find your hideout. And if the military starts looking for you, send the strongest of your creatures to teach them a lesson. Let no one stop you in your search for the ultimate mutagen!\n\nFeatures:\n- First-person mad scientist simulator\n- Complex resource and inventory management\n- A strategy element - plan raids on the city and prepare for encounters with the military\n- Thousands of different mutagens to discover - you name them all","skuId":"0010","skuImages":{},"skuTitle":"Creature Lab","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9N95N2T4ZZV7","skuDescription":"Creature Lab sets you on a difficult path of a genius, yet a bit wicked scientist with a very liberal approach to test subjects and official procedures. Establish your hideout and let the experiments commence! Conduct crazy experiments, mix mutagens, analyze their properties, grow DNA-based body parts, and attach them to your test subjects.\n\nSo many possibilities… Prepare your laboratory, obtain basic reagents, and see what happens when you mix them together. Don’t forget to name all your recipes! Apply your mutagens to test subjects and observe how they react. Grow entirely new body parts and attach them to the creatures you just brought to life. Discover nearly limitless interactions between mutagens and body parts as you slowly assemble an army of mutants.\n\nThere's no use hoping for government funds so you'll make do with anything you can find or even steal. Manage your inventory, expand your lab, and make sure your hideout is safe. Don’t let the panic guide you, the more stressed you are, the bigger chance Feds will drop by to say hello and check your spot! Don’t leave any traces, be patient and extremely careful! They will never even know what hit them!\n\nRunning low on resources? Need more test subjects? Send your sick creatures into the city! Find whatever resources you need. Spread panic in the city to scare off anyone trying to find your hideout. And if the military starts looking for you, send the strongest of your creatures to teach them a lesson. Let no one stop you in your search for the ultimate mutagen!\n\nFeatures:\n- First-person mad scientist simulator\n- Complex resource and inventory management\n- A strategy element - plan raids on the city and prepare for encounters with the military\n- Thousands of different mutagens to discover - you name them all","skuId":"0011","skuImages":{},"skuTitle":"Creature Lab","isUbisoftConsoleCrossEntitlement":false}},"9NKV34XDW014":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B33BB4848STQ","preferredAvailabilityId":"B33BB4848STQ","productId":"9NKV34XDW014","skuDescription":"Q. What kind of game is this?\nA. In this game, you can peacefully live alongside mysterious creatures known as Pals or risk your life to drive off a ruthless poaching syndicate.\nPals can be used to fight and breed, or they can be made to work on farms or factories.\nYou can even sell them or eat them.\n\n▼Survival\nIn a harsh environment where food is scarce and vicious poachers roam, danger waits around every corner. To survive, you must tread carefully and make difficult choices...even if that means eating your own Pals when the time comes.\n\n▼Mounts & Exploration\nPals can be mounted to traverse the land, sea and sky—allowing you to traverse all kinds of environment as you explore the world.\n\n▼Building Structures\nWant to build a pyramid? Put an army of Pals on the job. There are no labor laws for Pals, so exploit them to your heart's content.\n\n▼Production\nFind a variety of useful Pals to make fire, generate electricity, or mine ore so that you can live a life of comfort.\n\n▼Farming\nSome Pals are good at planting seeds, while others are skilled at watering or harvesting crops. Work together with your Pals to create an idyllic farmstead.\n\n▼Factories & Automation\nLetting Pals do the work is the key to automation. Build a factory, place a Pal in it, and they'll keep working as long as they're fed—until they're dead, that is.\n\n▼Dungeon Exploration\nWith Pals on your side you can tackle even the most dangerous areas. When the time comes, you might have to sacrifice one to save your skin. They'll protect your life—even if it costs their own.\n\n▼Breeding & Genetics\nBreed a Pal and it will inherit the characteristics of its parents. Combine rare pals to create the strongest Pal of them all!\n\n▼Poaching & Crime\nEndangered Pals live in wildlife sanctuaries. Sneak in and capture rare Pals to get rich quick! It's not a crime if you don't get caught, after all.\n\n▼Multiplayer\nMultiplayer is supported, so invite a friend and go on an adventure together! And of course you can battle your friends and trade Pals, too.\nIn online co-op play mode, up to 4 players can play together.\nMeanwhile, a dedicated server can allow up to 32 players to play together.\n\nCollect all kinds of exciting Pals to fight, farm, build, and work for you in this completely new multiplayer, open world survival and crafting game!","skuId":"0010","skuImages":{},"skuTitle":"Palworld","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NKV34XDW014","skuDescription":"Q. What kind of game is this?\nA. In this game, you can peacefully live alongside mysterious creatures known as Pals or risk your life to drive off a ruthless poaching syndicate.\nPals can be used to fight and breed, or they can be made to work on farms or factories.\nYou can even sell them or eat them.\n\n▼Survival\nIn a harsh environment where food is scarce and vicious poachers roam, danger waits around every corner. To survive, you must tread carefully and make difficult choices...even if that means eating your own Pals when the time comes.\n\n▼Mounts & Exploration\nPals can be mounted to traverse the land, sea and sky—allowing you to traverse all kinds of environment as you explore the world.\n\n▼Building Structures\nWant to build a pyramid? Put an army of Pals on the job. There are no labor laws for Pals, so exploit them to your heart's content.\n\n▼Production\nFind a variety of useful Pals to make fire, generate electricity, or mine ore so that you can live a life of comfort.\n\n▼Farming\nSome Pals are good at planting seeds, while others are skilled at watering or harvesting crops. Work together with your Pals to create an idyllic farmstead.\n\n▼Factories & Automation\nLetting Pals do the work is the key to automation. Build a factory, place a Pal in it, and they'll keep working as long as they're fed—until they're dead, that is.\n\n▼Dungeon Exploration\nWith Pals on your side you can tackle even the most dangerous areas. When the time comes, you might have to sacrifice one to save your skin. They'll protect your life—even if it costs their own.\n\n▼Breeding & Genetics\nBreed a Pal and it will inherit the characteristics of its parents. Combine rare pals to create the strongest Pal of them all!\n\n▼Poaching & Crime\nEndangered Pals live in wildlife sanctuaries. Sneak in and capture rare Pals to get rich quick! It's not a crime if you don't get caught, after all.\n\n▼Multiplayer\nMultiplayer is supported, so invite a friend and go on an adventure together! And of course you can battle your friends and trade Pals, too.\nIn online co-op play mode, up to 4 players can play together.\nMeanwhile, a dedicated server can allow up to 32 players to play together.\n\nCollect all kinds of exciting Pals to fight, farm, build, and work for you in this completely new multiplayer, open world survival and crafting game!","skuId":"0011","skuImages":{},"skuTitle":"Palworld","isUbisoftConsoleCrossEntitlement":false}},"9P33VJGVPHVP":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B2NZD6G3GJ87","preferredAvailabilityId":"B2NZD6G3GJ87","productId":"9P33VJGVPHVP","skuDescription":"Respawn into a new dinosaur survival experience beyond your wildest dreams… as ARK is reimagined from the ground-up into the next-generation of videogame technology with Unreal Engine 5! You awake on a mysterious island, your senses overwhelmed by the blinding sunlight and brilliant colors bouncing off every surface around you, the azure waters of a verdant Island lapping at your bare feet. A deep roar echoes from the misty jungle, jolting you into action, and you stand up – not afraid, but intrigued. Are you ready to form a tribe, tame and breed hundreds of species of dinosaurs and other primeval creatures, explore, craft, build, and fight your way to the top of the food-chain? Your new world awaits… step through the looking-glass and join it!\n\nFEATURES\n\nARK: Survival Ascended has completely recreated and redesigned the artwork and worlds of ARK to take advantage of the latest in videogame technology, Unreal Engine 5, using high-end graphics features such as fully dynamic Global Illumination (“Lumen”), so that light bounces realistically off of surfaces and provides realistic reflections, and advanced mesh streaming (“Nanite”) of hundreds of millions of triangles for extreme detail.\n\nAdvanced new physics systems such as dynamic water so that every creature creates waves, ripples, splashes, and bubbles as they move through fluids, and fully interactive physical foliage where every blade of grass, bush, and tree reacts to characters, explosions, projectiles, and physics objects. Knock down a tree, and see it crash into other trees and disturb all the foliage on its way down to smacking into the grass below! Detect an enemy moving sneakily through the grass as it shifts and sways in response to their presence. Demolish a building and watch the pieces break apart realistically, interacting with the grass and water as they fall.\n\nARK: Survival Ascended includes access to all of ARK’s worlds, including Scorched Earth, Aberration, Extinction, ARK Genesis Part 1, ARK Genesis Part 2, and more. The Island, Scorched Earth, Aberration and The Center are released now, Extinction will be released on December 16, with the subsequent expansion worlds to be added at no additional cost on a regular basis.\n\nThe definitive survival experience returns better than ever: design your Survivor, form a tribe, and tame, train, breed & ride dinosaurs within a living ecosystem. Watch your food, water, temperature, and weather patterns. Slowly expand outwards as you harvest, build structures, farm crops, customize your visual designs, and proceed to explore to uncover the true nature of The Island and the worlds beyond. \n\nThorough Quality of Life revamps in every area: redesigned User Interfaces, dynamic navigation for intelligent creature pathfinding, Wild Babies, Photo Mode, new Camera systems, new Map system, Tracking System, new Structures and Items, new Creatures, and much more.\n\nCross-Platform Modding: Download & play new custom content created by players, including new maps, creatures, items, and game modes, through a dedicated mod collection directly within the game! Enjoy an endless stream of new ARK content as the creativity and talent of the community is fully unleashed for the first time ever across gaming platforms!\n\nCross-Platform Multiplayer: form your online tribe across different gaming platforms as you work together to survive and thrive on the ARK!\n\nSupports public online multiplayer for up to 70 players, private-session multiplayer for up to 8 players, and local split-screen for 2 players.","skuId":"0010","skuImages":{},"skuTitle":"ARK: Survival Ascended","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P33VJGVPHVP","skuDescription":"Respawn into a new dinosaur survival experience beyond your wildest dreams… as ARK is reimagined from the ground-up into the next-generation of videogame technology with Unreal Engine 5! You awake on a mysterious island, your senses overwhelmed by the blinding sunlight and brilliant colors bouncing off every surface around you, the azure waters of a verdant Island lapping at your bare feet. A deep roar echoes from the misty jungle, jolting you into action, and you stand up – not afraid, but intrigued. Are you ready to form a tribe, tame and breed hundreds of species of dinosaurs and other primeval creatures, explore, craft, build, and fight your way to the top of the food-chain? Your new world awaits… step through the looking-glass and join it!\n\nFEATURES\n\nARK: Survival Ascended has completely recreated and redesigned the artwork and worlds of ARK to take advantage of the latest in videogame technology, Unreal Engine 5, using high-end graphics features such as fully dynamic Global Illumination (“Lumen”), so that light bounces realistically off of surfaces and provides realistic reflections, and advanced mesh streaming (“Nanite”) of hundreds of millions of triangles for extreme detail.\n\nAdvanced new physics systems such as dynamic water so that every creature creates waves, ripples, splashes, and bubbles as they move through fluids, and fully interactive physical foliage where every blade of grass, bush, and tree reacts to characters, explosions, projectiles, and physics objects. Knock down a tree, and see it crash into other trees and disturb all the foliage on its way down to smacking into the grass below! Detect an enemy moving sneakily through the grass as it shifts and sways in response to their presence. Demolish a building and watch the pieces break apart realistically, interacting with the grass and water as they fall.\n\nARK: Survival Ascended includes access to all of ARK’s worlds, including Scorched Earth, Aberration, Extinction, ARK Genesis Part 1, ARK Genesis Part 2, and more. The Island, Scorched Earth, Aberration and The Center are released now, Extinction will be released on December 16, with the subsequent expansion worlds to be added at no additional cost on a regular basis.\n\nThe definitive survival experience returns better than ever: design your Survivor, form a tribe, and tame, train, breed & ride dinosaurs within a living ecosystem. Watch your food, water, temperature, and weather patterns. Slowly expand outwards as you harvest, build structures, farm crops, customize your visual designs, and proceed to explore to uncover the true nature of The Island and the worlds beyond. \n\nThorough Quality of Life revamps in every area: redesigned User Interfaces, dynamic navigation for intelligent creature pathfinding, Wild Babies, Photo Mode, new Camera systems, new Map system, Tracking System, new Structures and Items, new Creatures, and much more.\n\nCross-Platform Modding: Download & play new custom content created by players, including new maps, creatures, items, and game modes, through a dedicated mod collection directly within the game! Enjoy an endless stream of new ARK content as the creativity and talent of the community is fully unleashed for the first time ever across gaming platforms!\n\nCross-Platform Multiplayer: form your online tribe across different gaming platforms as you work together to survive and thrive on the ARK!\n\nSupports public online multiplayer for up to 70 players, private-session multiplayer for up to 8 players, and local split-screen for 2 players.","skuId":"0011","skuImages":{},"skuTitle":"ARK: Survival Ascended","isUbisoftConsoleCrossEntitlement":false}},"9N0KRV3ZL4GQ":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9ZVG3DW0DF67","preferredAvailabilityId":"9ZVG3DW0DF67","productId":"9N0KRV3ZL4GQ","skuDescription":"The much-loved zombie saga is back with a unique formula of horror, dark humor and over the top zombie-slaying, spanning an epic pulp adventure. \n\nDead Island 2 is a thrilling First-Person Action RPG, stylish, vibrant and flooded with zombie infection. Explore iconic, gore-drenched Los Angeles. Meet larger-than-life characters. Slay countless foes in exquisitely bloody detail. And evolve to become the ultimate Zombie Slayer.\n\nThe Ultimate Edition features the Xbox One and Xbox Series X|S versions of the game, both epic story expansions plus special weapons and stylish gear to unleash a new level of carnage. \n\nThe Ultimate Edition includes: \n- Haus and SoLA expansions\n- Memories of Banoi Pack\n- Golden Weapons Pack\n- Pulp Weapons Pack\n- Red’s Demise Katana\n- 6 Premium Character Packs\n- Kingdom Come: Deliverance II Pack \n\nPlayers using Xbox Series X|S and Xbox One X consoles can host and join co-op sessions. Xbox One|S players can join co-op sessions, but due to technical limitations they can host sessions for only one joining player.\n\nFor customers in Germany - Once zombies are defeated, players can no longer deal damage to or further dismember zombie corpses. USK players can play co-op sessions with international players through friend invites and joining friends. For public matchmaking, USK players can only play with other USK players.\n","skuId":"0010","skuImages":{},"skuTitle":"Dead Island 2 Ultimate Edition","isUbisoftConsoleCrossEntitlement":false}},"9NVJ7NZX1WL2":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9VZNF4XF3BZK","preferredAvailabilityId":"9VZNF4XF3BZK","productId":"9NVJ7NZX1WL2","skuDescription":"GREEN HELL is an Open World Survival Simulator set in the unique and uncharted setting of the Amazonian rainforest. \n\nPlunge into the open world survival simulation set in the extreme conditions of the unforgiving Amazon jungle. Use real-life survival techniques to craft, hunt, fight, and gather resources. Build a makeshift shelter or raise a fortress, but always remember to tend to your wounds and maintain mental health.\n\nSurvive on your own, or try your chances in an up-to-4-player online co-op mode.\n\nThe Xbox Series X|S edition of the game contains the highly acclaimed GREEN HELL experience, alongside the Spirits of Amazonia update with over 20 hours of additional gameplay. \n \n\nThe game also includes the following content updates:\n- Animal Husbandry \n- Building Update\n- Storage & Transportation\n- Fortifications \n- Flamekeeper\n\nThe Xbox Series X|S version of the game is not compatible with the Xbox One version due to differences in game content and online features.","skuId":"0010","skuImages":{},"skuTitle":"Green Hell Xbox Series X|S","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NVJ7NZX1WL2","skuDescription":"GREEN HELL is an Open World Survival Simulator set in the unique and uncharted setting of the Amazonian rainforest. \n\nPlunge into the open world survival simulation set in the extreme conditions of the unforgiving Amazon jungle. Use real-life survival techniques to craft, hunt, fight, and gather resources. Build a makeshift shelter or raise a fortress, but always remember to tend to your wounds and maintain mental health.\n\nSurvive on your own, or try your chances in an up-to-4-player online co-op mode.\n\nThe Xbox Series X|S edition of the game contains the highly acclaimed GREEN HELL experience, alongside the Spirits of Amazonia update with over 20 hours of additional gameplay. \n \n\nThe game also includes the following content updates:\n- Animal Husbandry \n- Building Update\n- Storage & Transportation\n- Fortifications \n- Flamekeeper\n\nThe Xbox Series X|S version of the game is not compatible with the Xbox One version due to differences in game content and online features.","skuId":"0011","skuImages":{},"skuTitle":"Green Hell Xbox Series X|S","isUbisoftConsoleCrossEntitlement":false}},"9PLRB49DJ4WK":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9Q8R6BWFXM4G","preferredAvailabilityId":"9Q8R6BWFXM4G","productId":"9PLRB49DJ4WK","skuDescription":"Step into a boundless open world where every planet, every system, and every moment is yours to shape. Explore a universe rich with life, ancient mysteries, and untamed beauty. Fight back the Red Darkness menace as you mine resources, craft tools, weapons, and build vehicles that are essential for your odyssey. Collaborate with friends to battle colossal threats and bring hope to the galaxy. Adventure, creation, and survival await!\n\nKey Features:\n\nHuge Open Cubic World\nEvery star seen in the sky or in space is the light of a star system. Each star is orbited by planets filled with life, with shifting day-night cycles, bustling NPC cities, pirate outposts, and dangerous ruins waiting to be discovered.\n\nCrafting and Building Paradise\nMine resources, refine materials, and build everything from tools and outposts to vehicles and starships.\n\nEndless Galactic Odyssey\nTake on diverse quests, uncover secrets of the forgotten civilization, trade with NPCs, or battle rogue pirates as the epic story of saving the galaxy unfolds before you.\n\nFun Co-op Gameplay\nJoin forces with others to take down massive enemies, initiate orbital laser strikes, or build cooperative megastructures.\n\nSeamless Ground, Air and Space Traversal\nSwitch between planetary vehicles and spaceships, exploring from the ground up—or the skies down. Experience warp jumps between star systems, cruise at blazing fast speed between planets or just use the planetary speeders to travel on planets.\n\nLimitless Exploration\nVenture across hundreds of star systems filled with rich ecosystems, alien flora and fauna, and ever-changing environments.\n\nIntense Red Darkness Battles\nCombat a spreading galactic infection that mutates wildlife, consumes planets, and threatens all life. Your actions can cleanse the plague—or let it thrive.\n\nRPG-style Depth\nLevel up your skills, unlock new crafting recipes, and shape your character’s journey through meaningful choices and upgrades.","skuId":"0010","skuImages":{},"skuTitle":"Cubic Odyssey","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9PLRB49DJ4WK","skuDescription":"Step into a boundless open world where every planet, every system, and every moment is yours to shape. Explore a universe rich with life, ancient mysteries, and untamed beauty. Fight back the Red Darkness menace as you mine resources, craft tools, weapons, and build vehicles that are essential for your odyssey. Collaborate with friends to battle colossal threats and bring hope to the galaxy. Adventure, creation, and survival await!\n\nKey Features:\n\nHuge Open Cubic World\nEvery star seen in the sky or in space is the light of a star system. Each star is orbited by planets filled with life, with shifting day-night cycles, bustling NPC cities, pirate outposts, and dangerous ruins waiting to be discovered.\n\nCrafting and Building Paradise\nMine resources, refine materials, and build everything from tools and outposts to vehicles and starships.\n\nEndless Galactic Odyssey\nTake on diverse quests, uncover secrets of the forgotten civilization, trade with NPCs, or battle rogue pirates as the epic story of saving the galaxy unfolds before you.\n\nFun Co-op Gameplay\nJoin forces with others to take down massive enemies, initiate orbital laser strikes, or build cooperative megastructures.\n\nSeamless Ground, Air and Space Traversal\nSwitch between planetary vehicles and spaceships, exploring from the ground up—or the skies down. Experience warp jumps between star systems, cruise at blazing fast speed between planets or just use the planetary speeders to travel on planets.\n\nLimitless Exploration\nVenture across hundreds of star systems filled with rich ecosystems, alien flora and fauna, and ever-changing environments.\n\nIntense Red Darkness Battles\nCombat a spreading galactic infection that mutates wildlife, consumes planets, and threatens all life. Your actions can cleanse the plague—or let it thrive.\n\nRPG-style Depth\nLevel up your skills, unlock new crafting recipes, and shape your character’s journey through meaningful choices and upgrades.","skuId":"0011","skuImages":{},"skuTitle":"Cubic Odyssey","isUbisoftConsoleCrossEntitlement":false}},"9NCJSXWZTP88":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9PL6H8PPMQC5","preferredAvailabilityId":"9PL6H8PPMQC5","productId":"9NCJSXWZTP88","skuDescription":"Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4. In this next generation role-playing game set amongst the stars, create any character you want and explore with unparalleled freedom as you embark on an epic journey to answer humanity’s greatest mystery.\r\n\r\nThe year is 2330. Humanity has ventured beyond our solar system, settling new planets, and living as a spacefaring people. From humble beginnings as a space miner, you will join Constellation – the last group of space explorers seeking rare artifacts throughout the galaxy – and navigate the vast expanse of the Settled Systems in Bethesda Game Studios’ biggest and most ambitious game.\n\nhttps:\u002F\u002Feulas.bethesda.net\u002FStarfield","skuId":"0010","skuImages":{},"skuTitle":"Starfield","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9NCJSXWZTP88","skuDescription":"Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4. In this next generation role-playing game set amongst the stars, create any character you want and explore with unparalleled freedom as you embark on an epic journey to answer humanity’s greatest mystery.\r\n\r\nThe year is 2330. Humanity has ventured beyond our solar system, settling new planets, and living as a spacefaring people. From humble beginnings as a space miner, you will join Constellation – the last group of space explorers seeking rare artifacts throughout the galaxy – and navigate the vast expanse of the Settled Systems in Bethesda Game Studios’ biggest and most ambitious game.\n\nhttps:\u002F\u002Feulas.bethesda.net\u002FStarfield","skuId":"0017","skuImages":{},"skuTitle":"Starfield","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NCJSXWZTP88","skuDescription":"Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4. In this next generation role-playing game set amongst the stars, create any character you want and explore with unparalleled freedom as you embark on an epic journey to answer humanity’s greatest mystery.\r\n\r\nThe year is 2330. Humanity has ventured beyond our solar system, settling new planets, and living as a spacefaring people. From humble beginnings as a space miner, you will join Constellation – the last group of space explorers seeking rare artifacts throughout the galaxy – and navigate the vast expanse of the Settled Systems in Bethesda Game Studios’ biggest and most ambitious game.\n\nhttps:\u002F\u002Feulas.bethesda.net\u002FStarfield","skuId":"0011","skuImages":{},"skuTitle":"Starfield","isUbisoftConsoleCrossEntitlement":false}},"BX3M8L83BBRW":{"0001":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9PLTT5Z9LJ90","preferredAvailabilityId":"9PLTT5Z9LJ90","productId":"BX3M8L83BBRW","skuDescription":"IMPORTANT: While Cyberpunk 2077 base game is available on Xbox One, this version of the game received its last patch on November 8th, 2022 and is no longer supported. An Xbox Series X|S console is required in order to download and apply Cyberpunk 2077 patches released after that date — as well as to buy and play the Phantom Liberty expansion pack.\n\nCyberpunk 2077 is an open-world, action-adventure RPG set in the megalopolis of Night City, where you play as a cyberpunk mercenary wrapped up in a do-or-die fight for survival. Improved and featuring all-new free additional content, customize your character and playstyle as you take on jobs, build a reputation, and unlock upgrades. The relationships you forge and the choices you make will shape the story and the world around you. Legends are made here. What will yours be?\n\nCUSTOMIZE YOUR CYBERPUNK WITH UPDATE 2.2!\nExpress yourself with free Update 2.2! Customize your character with new variants of cosmetic cyberware, tattoos, and makeup. Take your ride to the next level with Rayfield’s exclusive CrystalCoat technology, letting you swap colors on luxury and sports cars. Plus, dive into the enhanced photo mode to capture every moment in stunning detail.\n\nCREATE YOUR OWN CYBERPUNK\nBecome an urban outlaw equipped with cybernetic enhancements and build your legend on the streets of Night City.\n\nEXPLORE THE CITY OF THE FUTURE\nNight City is packed to the brim with things to do, places to see, and people to meet. And it’s up to you where to go, when to go, and how to get there. \n\nBUILD YOUR LEGEND\nGo on daring adventures and build relationships with unforgettable characters whose fates are shaped by the choices you make.\n\nCLAIM EXCLUSIVE ITEMS\nClaim in-game swag & digital goodies inspired by CD PROJEKT RED games as part of the My Rewards program.","skuId":"0001","skuImages":{},"skuTitle":"Cyberpunk 2077","isUbisoftConsoleCrossEntitlement":false},"0003":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"BX3M8L83BBRW","skuDescription":"IMPORTANT: While Cyberpunk 2077 base game is available on Xbox One, this version of the game received its last patch on November 8th, 2022 and is no longer supported. An Xbox Series X|S console is required in order to download and apply Cyberpunk 2077 patches released after that date — as well as to buy and play the Phantom Liberty expansion pack.\n\nCyberpunk 2077 is an open-world, action-adventure RPG set in the megalopolis of Night City, where you play as a cyberpunk mercenary wrapped up in a do-or-die fight for survival. Improved and featuring all-new free additional content, customize your character and playstyle as you take on jobs, build a reputation, and unlock upgrades. The relationships you forge and the choices you make will shape the story and the world around you. Legends are made here. What will yours be?\n\nCUSTOMIZE YOUR CYBERPUNK WITH UPDATE 2.2!\nExpress yourself with free Update 2.2! Customize your character with new variants of cosmetic cyberware, tattoos, and makeup. Take your ride to the next level with Rayfield’s exclusive CrystalCoat technology, letting you swap colors on luxury and sports cars. Plus, dive into the enhanced photo mode to capture every moment in stunning detail.\n\nCREATE YOUR OWN CYBERPUNK\nBecome an urban outlaw equipped with cybernetic enhancements and build your legend on the streets of Night City.\n\nEXPLORE THE CITY OF THE FUTURE\nNight City is packed to the brim with things to do, places to see, and people to meet. And it’s up to you where to go, when to go, and how to get there. \n\nBUILD YOUR LEGEND\nGo on daring adventures and build relationships with unforgettable characters whose fates are shaped by the choices you make.\n\nCLAIM EXCLUSIVE ITEMS\nClaim in-game swag & digital goodies inspired by CD PROJEKT RED games as part of the My Rewards program.","skuId":"0003","skuImages":{},"skuTitle":"Cyberpunk 2077","isUbisoftConsoleCrossEntitlement":false},"0004":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"BX3M8L83BBRW","skuDescription":"IMPORTANT: While Cyberpunk 2077 base game is available on Xbox One, this version of the game received its last patch on November 8th, 2022 and is no longer supported. An Xbox Series X|S console is required in order to download and apply Cyberpunk 2077 patches released after that date — as well as to buy and play the Phantom Liberty expansion pack.\n\nCyberpunk 2077 is an open-world, action-adventure RPG set in the megalopolis of Night City, where you play as a cyberpunk mercenary wrapped up in a do-or-die fight for survival. Improved and featuring all-new free additional content, customize your character and playstyle as you take on jobs, build a reputation, and unlock upgrades. The relationships you forge and the choices you make will shape the story and the world around you. Legends are made here. What will yours be?\n\nCUSTOMIZE YOUR CYBERPUNK WITH UPDATE 2.2!\nExpress yourself with free Update 2.2! Customize your character with new variants of cosmetic cyberware, tattoos, and makeup. Take your ride to the next level with Rayfield’s exclusive CrystalCoat technology, letting you swap colors on luxury and sports cars. Plus, dive into the enhanced photo mode to capture every moment in stunning detail.\n\nCREATE YOUR OWN CYBERPUNK\nBecome an urban outlaw equipped with cybernetic enhancements and build your legend on the streets of Night City.\n\nEXPLORE THE CITY OF THE FUTURE\nNight City is packed to the brim with things to do, places to see, and people to meet. And it’s up to you where to go, when to go, and how to get there. \n\nBUILD YOUR LEGEND\nGo on daring adventures and build relationships with unforgettable characters whose fates are shaped by the choices you make.\n\nCLAIM EXCLUSIVE ITEMS\nClaim in-game swag & digital goodies inspired by CD PROJEKT RED games as part of the My Rewards program.","skuId":"0004","skuImages":{},"skuTitle":"Cyberpunk 2077","isUbisoftConsoleCrossEntitlement":false}},"9MX7F9LLRKZP":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9XVCG1JQ85JG","preferredAvailabilityId":"9XVCG1JQ85JG","productId":"9MX7F9LLRKZP","skuDescription":"iDigging is an exciting cooperative (up to 5 people) first-person game with bright, stylized, cute graphics where you play as a protagonist who decides to challenge the rules and laws. In this game, you'll dig your way to success despite the bans and threats.\n\nThe life of your character is not going well: his wife left him for the neighbor because he has no job and no money, and his house is empty. However, one day, the main character decides to change his life. In the game world, there is a strict ban on digging on your own property — all underground resources belong to the state since someone found treasure buried beneath the ground. But our hero decides to find this treasure and regain his status.\n\nYou can dig endlessly in your backyard, exploring different layers of soil to find valuable resources and useful items such as furniture for your house, accessories, metals, jewels, and much more. Everything you find can be sold to earn money and improve your home, making it a cozy place to live. The more you dig, the better your life becomes, and the more you surpass your neighbor who lives nearby.\n\nHowever, your neighbor isn't that simple. He constantly spies on you and might call the police if he notices anything suspicious. The police come regularly to check if you’ve been digging, and if they find any traces, you’ll be in big trouble. You’ll have to use your wits and various tools to hide your actions and conceal the dug holes from prying eyes. To do so, you can use camouflage carpets, upgrade your digging tools, and employ other tricks.\n\nThroughout the game, you’ll be able to improve your tools, starting with simple shovels and pickaxes and advancing to powerful mechanical devices like drills or dynamite. You’ll also have access to various bombs and even guard dogs to protect you from the pesky neighbor.","skuId":"0010","skuImages":{},"skuTitle":"iDigging","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9MX7F9LLRKZP","skuDescription":"iDigging is an exciting cooperative (up to 5 people) first-person game with bright, stylized, cute graphics where you play as a protagonist who decides to challenge the rules and laws. In this game, you'll dig your way to success despite the bans and threats.\n\nThe life of your character is not going well: his wife left him for the neighbor because he has no job and no money, and his house is empty. However, one day, the main character decides to change his life. In the game world, there is a strict ban on digging on your own property — all underground resources belong to the state since someone found treasure buried beneath the ground. But our hero decides to find this treasure and regain his status.\n\nYou can dig endlessly in your backyard, exploring different layers of soil to find valuable resources and useful items such as furniture for your house, accessories, metals, jewels, and much more. Everything you find can be sold to earn money and improve your home, making it a cozy place to live. The more you dig, the better your life becomes, and the more you surpass your neighbor who lives nearby.\n\nHowever, your neighbor isn't that simple. He constantly spies on you and might call the police if he notices anything suspicious. The police come regularly to check if you’ve been digging, and if they find any traces, you’ll be in big trouble. You’ll have to use your wits and various tools to hide your actions and conceal the dug holes from prying eyes. To do so, you can use camouflage carpets, upgrade your digging tools, and employ other tricks.\n\nThroughout the game, you’ll be able to improve your tools, starting with simple shovels and pickaxes and advancing to powerful mechanical devices like drills or dynamite. You’ll also have access to various bombs and even guard dogs to protect you from the pesky neighbor.","skuId":"0011","skuImages":{},"skuTitle":"iDigging","isUbisoftConsoleCrossEntitlement":false}},"9MW2X7FQ4ZG9":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9Z818Z5MPWZ4","preferredAvailabilityId":"9Z818Z5MPWZ4","productId":"9MW2X7FQ4ZG9","skuDescription":"The universe is getting bigger every day! Paradox Development Studio is bringing the grand strategy genre to consoles for the first time ever with Stellaris: Console Edition. Featuring the same deep strategic gameplay, rich and diverse alien races and emergent storytelling, Stellaris: Console Edition puts the complexity of the galaxy at your thumbsticks. Whether you’re exploring the unknown, discovering the mysteries of the universe, or conquering it for the glory of your empire, console players have more inter-galactic strategy awaiting them than ever before.\n\nThe universe has arrived at your consoles, it’s up to you what to do with it.\n\nMAIN FEATURES\n•\tBehold the enormity of space with procedurally generated galaxies with an untold number of planets to explore.\n•\tEncounter a myriad of wild, wacky, and dangerous alien races who may prove to be crucial trade partners or conquering forces hellbent on enslaving your civilization.\n•\tTake on strategic space warfare and resource management to ensure the survival and advancement of your empire.\n•\tExplore scientific anomalies and uncover technological wonders throughout the galaxy to mercilessly utilize them toward your own gains.\n•\tGovern your own fledgling population and secure your power and agenda through manipulating internal policies, factions, traditions and more.\n\nParadox ID user account (16+) is required for online multiplayer. Age restrictions apply (16+) for online multiplayer.","skuId":"0010","skuImages":{},"skuTitle":"Stellaris: Console Edition (X|S)","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9MW2X7FQ4ZG9","skuDescription":"The universe is getting bigger every day! Paradox Development Studio is bringing the grand strategy genre to consoles for the first time ever with Stellaris: Console Edition. Featuring the same deep strategic gameplay, rich and diverse alien races and emergent storytelling, Stellaris: Console Edition puts the complexity of the galaxy at your thumbsticks. Whether you’re exploring the unknown, discovering the mysteries of the universe, or conquering it for the glory of your empire, console players have more inter-galactic strategy awaiting them than ever before.\n\nThe universe has arrived at your consoles, it’s up to you what to do with it.\n\nMAIN FEATURES\n•\tBehold the enormity of space with procedurally generated galaxies with an untold number of planets to explore.\n•\tEncounter a myriad of wild, wacky, and dangerous alien races who may prove to be crucial trade partners or conquering forces hellbent on enslaving your civilization.\n•\tTake on strategic space warfare and resource management to ensure the survival and advancement of your empire.\n•\tExplore scientific anomalies and uncover technological wonders throughout the galaxy to mercilessly utilize them toward your own gains.\n•\tGovern your own fledgling population and secure your power and agenda through manipulating internal policies, factions, traditions and more.\n\nParadox ID user account (16+) is required for online multiplayer. Age restrictions apply (16+) for online multiplayer.","skuId":"0011","skuImages":{},"skuTitle":"Stellaris: Console Edition (X|S)","isUbisoftConsoleCrossEntitlement":false}},"9MX0X718686P":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B4V1QS9P8NF2","preferredAvailabilityId":"B4V1QS9P8NF2","productId":"9MX0X718686P","skuDescription":"Join Sharpe Industries as a vehicle test pilot and journey across the world to remote outposts where everything needs to be destroyed, using purpose-built wrecking machines such as flying bulldozers, tanks wielding quad rocket launchers, and ornithopters with grappling hooks.  \n\nMaster these contraptions and demolish every structure in sight across two campaigns and a Sandbox mode. Deconstruct buildings piece-by-piece or take advantage of explosive chain-reactions with Instruments of Destruction’s advanced physics system. \n\nTackle a carnage-filled campaign filled with demolition-based objectives, then test your skills even further in dedicated high-score challenges that apply new parameters and objectives to each level. Or take a break from missions and unwind in the Sandbox mode to raze the world at your own pace.  \n\nAnd don’t just destroy: build. Learn how to design your own machines in a dedicated epilogue campaign for the ultimate demolition experience. Use the in-built editor to construct devastating vehicles armed with chainsaws, lasers, claws, wrecking balls, magnets, vortex generators, and much more.\n\n\n ","skuId":"0010","skuImages":{},"skuTitle":"Instruments of Destruction","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9MX0X718686P","skuDescription":"Join Sharpe Industries as a vehicle test pilot and journey across the world to remote outposts where everything needs to be destroyed, using purpose-built wrecking machines such as flying bulldozers, tanks wielding quad rocket launchers, and ornithopters with grappling hooks.  \n\nMaster these contraptions and demolish every structure in sight across two campaigns and a Sandbox mode. Deconstruct buildings piece-by-piece or take advantage of explosive chain-reactions with Instruments of Destruction’s advanced physics system. \n\nTackle a carnage-filled campaign filled with demolition-based objectives, then test your skills even further in dedicated high-score challenges that apply new parameters and objectives to each level. Or take a break from missions and unwind in the Sandbox mode to raze the world at your own pace.  \n\nAnd don’t just destroy: build. Learn how to design your own machines in a dedicated epilogue campaign for the ultimate demolition experience. Use the in-built editor to construct devastating vehicles armed with chainsaws, lasers, claws, wrecking balls, magnets, vortex generators, and much more.\n\n\n ","skuId":"0011","skuImages":{},"skuTitle":"Instruments of Destruction","isUbisoftConsoleCrossEntitlement":false}},"9P3H2PVZZPSD":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B1TSGNCWPB0Z","preferredAvailabilityId":"B1TSGNCWPB0Z","productId":"9P3H2PVZZPSD","skuDescription":"ICARUS: Console Edition\nLand on ICARUS, a planet broken due to failed terraforming. Once meant to be humanity’s second home, it is now a hostile frontier of toxic skies, savage wildlife, and relentless storms. Every drop from orbit is a fight for survival. Build shelter, craft weapons, hunt for food, and seek your fortune in exotic matter. \n\nSurvive alone or with up to four players in this uncompromising PvE survival game from the creator of DayZ.\n\nThe New Frontiers Expansion is included from the start, transforming ICARUS: Console Edition into a larger, deadlier but more rewarding survival experience. Discover new maps, missions, creatures, and rewards.\n________________________________________\nA PLANET THAT FIGHTS BACK\nICARUS resists your presence; poisoned air, lightning storms that tear apart structures, wildfires that spread unchecked, and predators that stalk in the shadows. It feels like the planet itself wants to drive you back into orbit. \n·       With New Frontiers added from the start, you can explore two 64 km2 maps of handcrafted terrain across forests, mountains, deserts, and caves\n·       Harvest every tree, rock, and creature\n·       Adapt to extreme weather and natural disasters\n________________________________________\nNEW FRONTIERS INCLUDED\nThe Prometheus region, once sealed off by the UDA, is now open. Terraforming failed here completely, leaving raw alien landscapes intact but warped. This expansion expands ICARUS far beyond its original borders:\n·       New Map & biomes: Alien grasslands, volcanic wastelands of molten lava, and dangerous swamplands\n·       Six Narrative Missions: A chained story across Prometheus as you pursue a mysterious whistleblower for the UDA\n·       New Creatures: Face Needlers, Dracs, Dreadwings, and other mutated apex predators, evolved to dominate these zones\n·       New Exotics: Discover a volatile new exotic with unique effects on the flora, plus new exotic plants and over 30 additional workshop items\n·       New Items & Resources: Mine obsidian, clay, scoria, crystallised miasma, and super-cooled ice; craft 100+ new items including weapons, food, recipes, and building tiers\n________________________________________\nTHREE WAYS TO SURVIVE\n·       Open World: Establish permanent bases and explore freely\n·       Missions: Timed contracts where extraction is everything\n·       Outposts: Low-pressure zones for creative building and experimentation\n________________________________________\nPROGRESSION & REWARD\n·       Tech Tree & Talents: Advance from primitive tools to advanced tech\n·       Specialisation: Focus as a hunter, builder, or survivalist\n·       Orbital Workshop: Trade exotic matter for permanent upgrades and equipment\nExotic matter remains the ultimate prize; rare, unstable, and deadly to pursue.\n________________________________________\nSOLO OR CO-OP\nUp to four players can share each drop, combining skills and resources to endure. Prefer to go it alone? Survive solo with a Solo Talent Tree for maximum challenge.\nNote: ICARUS: Console Edition does not support cross-play.","skuId":"0010","skuImages":{},"skuTitle":"ICARUS: Console Edition","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9P3H2PVZZPSD","skuDescription":"ICARUS: Console Edition\nLand on ICARUS, a planet broken due to failed terraforming. Once meant to be humanity’s second home, it is now a hostile frontier of toxic skies, savage wildlife, and relentless storms. Every drop from orbit is a fight for survival. Build shelter, craft weapons, hunt for food, and seek your fortune in exotic matter. \n\nSurvive alone or with up to four players in this uncompromising PvE survival game from the creator of DayZ.\n\nThe New Frontiers Expansion is included from the start, transforming ICARUS: Console Edition into a larger, deadlier but more rewarding survival experience. Discover new maps, missions, creatures, and rewards.\n________________________________________\nA PLANET THAT FIGHTS BACK\nICARUS resists your presence; poisoned air, lightning storms that tear apart structures, wildfires that spread unchecked, and predators that stalk in the shadows. It feels like the planet itself wants to drive you back into orbit. \n·       With New Frontiers added from the start, you can explore two 64 km2 maps of handcrafted terrain across forests, mountains, deserts, and caves\n·       Harvest every tree, rock, and creature\n·       Adapt to extreme weather and natural disasters\n________________________________________\nNEW FRONTIERS INCLUDED\nThe Prometheus region, once sealed off by the UDA, is now open. Terraforming failed here completely, leaving raw alien landscapes intact but warped. This expansion expands ICARUS far beyond its original borders:\n·       New Map & biomes: Alien grasslands, volcanic wastelands of molten lava, and dangerous swamplands\n·       Six Narrative Missions: A chained story across Prometheus as you pursue a mysterious whistleblower for the UDA\n·       New Creatures: Face Needlers, Dracs, Dreadwings, and other mutated apex predators, evolved to dominate these zones\n·       New Exotics: Discover a volatile new exotic with unique effects on the flora, plus new exotic plants and over 30 additional workshop items\n·       New Items & Resources: Mine obsidian, clay, scoria, crystallised miasma, and super-cooled ice; craft 100+ new items including weapons, food, recipes, and building tiers\n________________________________________\nTHREE WAYS TO SURVIVE\n·       Open World: Establish permanent bases and explore freely\n·       Missions: Timed contracts where extraction is everything\n·       Outposts: Low-pressure zones for creative building and experimentation\n________________________________________\nPROGRESSION & REWARD\n·       Tech Tree & Talents: Advance from primitive tools to advanced tech\n·       Specialisation: Focus as a hunter, builder, or survivalist\n·       Orbital Workshop: Trade exotic matter for permanent upgrades and equipment\nExotic matter remains the ultimate prize; rare, unstable, and deadly to pursue.\n________________________________________\nSOLO OR CO-OP\nUp to four players can share each drop, combining skills and resources to endure. Prefer to go it alone? Survive solo with a Solo Talent Tree for maximum challenge.\nNote: ICARUS: Console Edition does not support cross-play.","skuId":"0017","skuImages":{},"skuTitle":"ICARUS: Console Edition","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P3H2PVZZPSD","skuDescription":"ICARUS: Console Edition\nLand on ICARUS, a planet broken due to failed terraforming. Once meant to be humanity’s second home, it is now a hostile frontier of toxic skies, savage wildlife, and relentless storms. Every drop from orbit is a fight for survival. Build shelter, craft weapons, hunt for food, and seek your fortune in exotic matter. \n\nSurvive alone or with up to four players in this uncompromising PvE survival game from the creator of DayZ.\n\nThe New Frontiers Expansion is included from the start, transforming ICARUS: Console Edition into a larger, deadlier but more rewarding survival experience. Discover new maps, missions, creatures, and rewards.\n________________________________________\nA PLANET THAT FIGHTS BACK\nICARUS resists your presence; poisoned air, lightning storms that tear apart structures, wildfires that spread unchecked, and predators that stalk in the shadows. It feels like the planet itself wants to drive you back into orbit. \n·       With New Frontiers added from the start, you can explore two 64 km2 maps of handcrafted terrain across forests, mountains, deserts, and caves\n·       Harvest every tree, rock, and creature\n·       Adapt to extreme weather and natural disasters\n________________________________________\nNEW FRONTIERS INCLUDED\nThe Prometheus region, once sealed off by the UDA, is now open. Terraforming failed here completely, leaving raw alien landscapes intact but warped. This expansion expands ICARUS far beyond its original borders:\n·       New Map & biomes: Alien grasslands, volcanic wastelands of molten lava, and dangerous swamplands\n·       Six Narrative Missions: A chained story across Prometheus as you pursue a mysterious whistleblower for the UDA\n·       New Creatures: Face Needlers, Dracs, Dreadwings, and other mutated apex predators, evolved to dominate these zones\n·       New Exotics: Discover a volatile new exotic with unique effects on the flora, plus new exotic plants and over 30 additional workshop items\n·       New Items & Resources: Mine obsidian, clay, scoria, crystallised miasma, and super-cooled ice; craft 100+ new items including weapons, food, recipes, and building tiers\n________________________________________\nTHREE WAYS TO SURVIVE\n·       Open World: Establish permanent bases and explore freely\n·       Missions: Timed contracts where extraction is everything\n·       Outposts: Low-pressure zones for creative building and experimentation\n________________________________________\nPROGRESSION & REWARD\n·       Tech Tree & Talents: Advance from primitive tools to advanced tech\n·       Specialisation: Focus as a hunter, builder, or survivalist\n·       Orbital Workshop: Trade exotic matter for permanent upgrades and equipment\nExotic matter remains the ultimate prize; rare, unstable, and deadly to pursue.\n________________________________________\nSOLO OR CO-OP\nUp to four players can share each drop, combining skills and resources to endure. Prefer to go it alone? Survive solo with a Solo Talent Tree for maximum challenge.\nNote: ICARUS: Console Edition does not support cross-play.","skuId":"0011","skuImages":{},"skuTitle":"ICARUS: Console Edition","isUbisoftConsoleCrossEntitlement":false}},"9NC4WDL5KZBL":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9R3J1NLK5SWJ","preferredAvailabilityId":"9R3J1NLK5SWJ","productId":"9NC4WDL5KZBL","skuDescription":"A survival-action game inspired by real-life events, Atomfall is set five years after the Windscale nuclear disaster in Northern England.\nExplore the fictional quarantine zone, scavenge, craft, barter, fight and talk your way through a British countryside setting filled with bizarre characters, mysticism, cults, and rogue government agencies.\nFrom Rebellion, the studio behind Sniper Elite and Zombie Army, Atomfall will challenge you to solve the dark mystery of what really happened.\nPlayer Driven Mystery: Unravel a tapestry of interwoven narratives through exploration, conversation, investigation, and combat, where every choice you make has consequences.\n\nSearch, Scavage, Survive: You’ll need to scavenge for supplies, craft weapons and items, and fight desperately to make it out alive!\n\nDesperate Combat: With weapons and ammunition scarce, each frenetic engagement will see you blend marksmanship with vicious hand-to-hand combat. Manage your heart rate to hold a steady aim and ensure you have the energy you need to reach for your cricket bat and land the killer blow.\n\nGreen and Unpleasant Land: The picturesque British countryside, with rolling green hills, lush valleys, and rural villages belie the dangers that await you. Navigate cult-controlled ruins, natural caves, nuclear bunkers and more as you explore this dense, foreboding world.\n\nReimagining Windscale: A fictional reimagining of a real-world event, Atomfall draws from science fiction, folk horror, and Cold War influences to create a world that is eerily familiar yet completely alien.","skuId":"0010","skuImages":{},"skuTitle":"Atomfall","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9NC4WDL5KZBL","skuDescription":"A survival-action game inspired by real-life events, Atomfall is set five years after the Windscale nuclear disaster in Northern England.\nExplore the fictional quarantine zone, scavenge, craft, barter, fight and talk your way through a British countryside setting filled with bizarre characters, mysticism, cults, and rogue government agencies.\nFrom Rebellion, the studio behind Sniper Elite and Zombie Army, Atomfall will challenge you to solve the dark mystery of what really happened.\nPlayer Driven Mystery: Unravel a tapestry of interwoven narratives through exploration, conversation, investigation, and combat, where every choice you make has consequences.\n\nSearch, Scavage, Survive: You’ll need to scavenge for supplies, craft weapons and items, and fight desperately to make it out alive!\n\nDesperate Combat: With weapons and ammunition scarce, each frenetic engagement will see you blend marksmanship with vicious hand-to-hand combat. Manage your heart rate to hold a steady aim and ensure you have the energy you need to reach for your cricket bat and land the killer blow.\n\nGreen and Unpleasant Land: The picturesque British countryside, with rolling green hills, lush valleys, and rural villages belie the dangers that await you. Navigate cult-controlled ruins, natural caves, nuclear bunkers and more as you explore this dense, foreboding world.\n\nReimagining Windscale: A fictional reimagining of a real-world event, Atomfall draws from science fiction, folk horror, and Cold War influences to create a world that is eerily familiar yet completely alien.","skuId":"0017","skuImages":{},"skuTitle":"Atomfall","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NC4WDL5KZBL","skuDescription":"A survival-action game inspired by real-life events, Atomfall is set five years after the Windscale nuclear disaster in Northern England.\nExplore the fictional quarantine zone, scavenge, craft, barter, fight and talk your way through a British countryside setting filled with bizarre characters, mysticism, cults, and rogue government agencies.\nFrom Rebellion, the studio behind Sniper Elite and Zombie Army, Atomfall will challenge you to solve the dark mystery of what really happened.\nPlayer Driven Mystery: Unravel a tapestry of interwoven narratives through exploration, conversation, investigation, and combat, where every choice you make has consequences.\n\nSearch, Scavage, Survive: You’ll need to scavenge for supplies, craft weapons and items, and fight desperately to make it out alive!\n\nDesperate Combat: With weapons and ammunition scarce, each frenetic engagement will see you blend marksmanship with vicious hand-to-hand combat. Manage your heart rate to hold a steady aim and ensure you have the energy you need to reach for your cricket bat and land the killer blow.\n\nGreen and Unpleasant Land: The picturesque British countryside, with rolling green hills, lush valleys, and rural villages belie the dangers that await you. Navigate cult-controlled ruins, natural caves, nuclear bunkers and more as you explore this dense, foreboding world.\n\nReimagining Windscale: A fictional reimagining of a real-world event, Atomfall draws from science fiction, folk horror, and Cold War influences to create a world that is eerily familiar yet completely alien.","skuId":"0011","skuImages":{},"skuTitle":"Atomfall","isUbisoftConsoleCrossEntitlement":false}},"9N9QJG4S82B5":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9Q1SHGC55THR","preferredAvailabilityId":"9Q1SHGC55THR","productId":"9N9QJG4S82B5","skuDescription":"Avatar: Frontiers of Pandora™ is a third and first-person action-adventure game set in the never-before-seen Western Frontier of Pandora. Abducted by the human militaristic corporation known as the RDA, you, a Na’vi, were trained and molded to serve their purpose. Fifteen years later, you are free, but find yourself a stranger in your birthplace. Reconnect with your lost heritage, discover what it truly means to be Na’vi, and join other clans to protect Pandora from the RDA.\n\nEXPLORE A WORLD OF WONDER AND DANGER\nExperience the epic wonders of the Western Frontier, a never-before-seen continent of Pandora. Journey through beautiful yet unpredictable open world regions, where lowering your guard can lead to deadly mistakes.\n\nBECOME NA’VI\nHarness your incredible strength and agility while customizing your character, crafting new gear, and upgrading skills and weapons to fit your playstyle.\n\nSOAR THE SKIES\nBond with your own personal banshee that will give you an edge in aerial combat and can be used for traveling across the vast Western Frontier.\n\nMASTER MULTIPLE COMBAT STYLES\nFight off the dangers of Pandora as you embrace the precision of traditional Na’vi weapons, including your bow and spear-thrower, or leverage your human training with more destructive weapons, such as an assault rifle or a shotgun.\n\nAN IMMERSIVE NEXT-GEN EXPERIENCE\nDeveloped to maximize the power of Xbox Series X|S, Avatar: Frontiers of Pandora will push the limits of immersion with extraordinary levels of detail, rendering, density, and immersive audio.\n\nSHARE YOUR ADVENTURE IN FULL CAMPAIGN CO-OP\nPlay the full story campaign in single-player or with a friend online in two-player co-op.\n\nInternet connection, Ubisoft account, Microsoft Account and Game Pass Ultimate or Core (subscriptions sold separately) required to access online multiplayer\u002Ffeatures.","skuId":"0010","skuImages":{},"skuTitle":"Avatar: Frontiers of Pandora™","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9N9QJG4S82B5","skuDescription":"Avatar: Frontiers of Pandora™ is a third and first-person action-adventure game set in the never-before-seen Western Frontier of Pandora. Abducted by the human militaristic corporation known as the RDA, you, a Na’vi, were trained and molded to serve their purpose. Fifteen years later, you are free, but find yourself a stranger in your birthplace. Reconnect with your lost heritage, discover what it truly means to be Na’vi, and join other clans to protect Pandora from the RDA.\n\nEXPLORE A WORLD OF WONDER AND DANGER\nExperience the epic wonders of the Western Frontier, a never-before-seen continent of Pandora. Journey through beautiful yet unpredictable open world regions, where lowering your guard can lead to deadly mistakes.\n\nBECOME NA’VI\nHarness your incredible strength and agility while customizing your character, crafting new gear, and upgrading skills and weapons to fit your playstyle.\n\nSOAR THE SKIES\nBond with your own personal banshee that will give you an edge in aerial combat and can be used for traveling across the vast Western Frontier.\n\nMASTER MULTIPLE COMBAT STYLES\nFight off the dangers of Pandora as you embrace the precision of traditional Na’vi weapons, including your bow and spear-thrower, or leverage your human training with more destructive weapons, such as an assault rifle or a shotgun.\n\nAN IMMERSIVE NEXT-GEN EXPERIENCE\nDeveloped to maximize the power of Xbox Series X|S, Avatar: Frontiers of Pandora will push the limits of immersion with extraordinary levels of detail, rendering, density, and immersive audio.\n\nSHARE YOUR ADVENTURE IN FULL CAMPAIGN CO-OP\nPlay the full story campaign in single-player or with a friend online in two-player co-op.\n\nInternet connection, Ubisoft account, Microsoft Account and Game Pass Ultimate or Core (subscriptions sold separately) required to access online multiplayer\u002Ffeatures.","skuId":"0017","skuImages":{},"skuTitle":"Avatar: Frontiers of Pandora™","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9N9QJG4S82B5","skuDescription":"Avatar: Frontiers of Pandora™ is a third and first-person action-adventure game set in the never-before-seen Western Frontier of Pandora. Abducted by the human militaristic corporation known as the RDA, you, a Na’vi, were trained and molded to serve their purpose. Fifteen years later, you are free, but find yourself a stranger in your birthplace. Reconnect with your lost heritage, discover what it truly means to be Na’vi, and join other clans to protect Pandora from the RDA.\n\nEXPLORE A WORLD OF WONDER AND DANGER\nExperience the epic wonders of the Western Frontier, a never-before-seen continent of Pandora. Journey through beautiful yet unpredictable open world regions, where lowering your guard can lead to deadly mistakes.\n\nBECOME NA’VI\nHarness your incredible strength and agility while customizing your character, crafting new gear, and upgrading skills and weapons to fit your playstyle.\n\nSOAR THE SKIES\nBond with your own personal banshee that will give you an edge in aerial combat and can be used for traveling across the vast Western Frontier.\n\nMASTER MULTIPLE COMBAT STYLES\nFight off the dangers of Pandora as you embrace the precision of traditional Na’vi weapons, including your bow and spear-thrower, or leverage your human training with more destructive weapons, such as an assault rifle or a shotgun.\n\nAN IMMERSIVE NEXT-GEN EXPERIENCE\nDeveloped to maximize the power of Xbox Series X|S, Avatar: Frontiers of Pandora will push the limits of immersion with extraordinary levels of detail, rendering, density, and immersive audio.\n\nSHARE YOUR ADVENTURE IN FULL CAMPAIGN CO-OP\nPlay the full story campaign in single-player or with a friend online in two-player co-op.\n\nInternet connection, Ubisoft account, Microsoft Account and Game Pass Ultimate or Core (subscriptions sold separately) required to access online multiplayer\u002Ffeatures.","skuId":"0011","skuImages":{},"skuTitle":"Avatar: Frontiers of Pandora™","isUbisoftConsoleCrossEntitlement":false}},"9P1GTVHTSMT4":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9VQJRTB5JLM2","preferredAvailabilityId":"9VQJRTB5JLM2","productId":"9P1GTVHTSMT4","skuDescription":"Work fast, stay safe, and protect your cat\n\nYou wake up in a dark warehouse, tasked with packing orders while something lurks in the shadows. Work fast, stay safe, and protect your cat. He’s all you’ve got.\n\nYou’re all alone working at a remote fulfillment center. Your only companion is your cat, a comforting presence in the vast, dark warehouse you are stationed in. Start each shift by reviewing incoming orders, as the demands increase, unlock deeper sections of the warehouse and uncover its unsettling secrets. But it’s not just your survival, your cat depends on you.\n\nFeatures:\n\n- Order Fulfillment Simulation: Retrieve, pack, and ship items while meeting tight quotas.\n- Navigate a warehouse where danger grows with every step.\n- Each death places you in a new warehouse where dynamic events create unpredictable challenges.\n- Unlock and explore new areas, piecing together the dark truths within.\n- Protect and care for your cat, your only source of comfort and connection.\n- Upgrade your tools to enhance your efficiency and chances of survival.","skuId":"0010","skuImages":{},"skuTitle":"Order 13","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9P1GTVHTSMT4","skuDescription":"Work fast, stay safe, and protect your cat\n\nYou wake up in a dark warehouse, tasked with packing orders while something lurks in the shadows. Work fast, stay safe, and protect your cat. He’s all you’ve got.\n\nYou’re all alone working at a remote fulfillment center. Your only companion is your cat, a comforting presence in the vast, dark warehouse you are stationed in. Start each shift by reviewing incoming orders, as the demands increase, unlock deeper sections of the warehouse and uncover its unsettling secrets. But it’s not just your survival, your cat depends on you.\n\nFeatures:\n\n- Order Fulfillment Simulation: Retrieve, pack, and ship items while meeting tight quotas.\n- Navigate a warehouse where danger grows with every step.\n- Each death places you in a new warehouse where dynamic events create unpredictable challenges.\n- Unlock and explore new areas, piecing together the dark truths within.\n- Protect and care for your cat, your only source of comfort and connection.\n- Upgrade your tools to enhance your efficiency and chances of survival.","skuId":"0017","skuImages":{},"skuTitle":"Order 13","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P1GTVHTSMT4","skuDescription":"Work fast, stay safe, and protect your cat\n\nYou wake up in a dark warehouse, tasked with packing orders while something lurks in the shadows. Work fast, stay safe, and protect your cat. He’s all you’ve got.\n\nYou’re all alone working at a remote fulfillment center. Your only companion is your cat, a comforting presence in the vast, dark warehouse you are stationed in. Start each shift by reviewing incoming orders, as the demands increase, unlock deeper sections of the warehouse and uncover its unsettling secrets. But it’s not just your survival, your cat depends on you.\n\nFeatures:\n\n- Order Fulfillment Simulation: Retrieve, pack, and ship items while meeting tight quotas.\n- Navigate a warehouse where danger grows with every step.\n- Each death places you in a new warehouse where dynamic events create unpredictable challenges.\n- Unlock and explore new areas, piecing together the dark truths within.\n- Protect and care for your cat, your only source of comfort and connection.\n- Upgrade your tools to enhance your efficiency and chances of survival.","skuId":"0011","skuImages":{},"skuTitle":"Order 13","isUbisoftConsoleCrossEntitlement":false}},"9P5BRS3LJN26":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B0H58Z6LWDJQ","preferredAvailabilityId":"B0H58Z6LWDJQ","productId":"9P5BRS3LJN26","skuDescription":"Bum Simulator is a sandbox game bursting with inappropriate humor and memorable characters. Apart from day-to-day survival, you can enjoy many unique features.\r\n\r\nYou can throw pigeons at people and watch as the panic ensues. Not fun enough? Upgrade your birds with explosives and let chaos reign. Still not satisfied? Wait until you see the fully upgraded pigeonado skill…\r\n\r\nMix alcohol with stuff you found on the ground to create powerful mixtures. Drink them (if you dare) to get a boost, or throw them at your enemies for a devastating effect.\r\n\r\nEvery bum needs a shopping cart of their own. Yours is named Carl and he’s your trusty mobile inventory. Also, he’s your best friend (no, really). You’ll learn to love him - we promise!\r\n\r\nMutant sewer rat people from the ’80s? Mentally unstable clown with a hook for a hand? A bored rich man telling you to punch random people on the street? We have them all, and then some! You’ll meet them all while following the insane storyline (yes, this game has an actual story!)\r\n\r\nDay-to-day survival can be exhausting, so why not take a break and get some shut-eye in a cozy shelter? Conquer, construct, and customize your cardboard bases to your heart’s content. However, remember to build some defenses as the rival bum gang raids are inevitable!\r\n\r\nCrafting makes your life easier. Collect materials and process them to get upgrades and expansions to your base. Tired of searching for food? Construct pots and plant some vegetables. Need stronger pigeons? Better upgrade that coop. Scavenging for scrap got boring? Recruit other bums to do the dirty work for you. With enough work, you can build a truly self-sustainable bum base!\r\n\r\nHear ye, hear ye! Every character in the game is fully voiced. Each line of dialogue oozes emotion and personality, which makes the game's storyline and atmosphere even gross… er… more engrossing!","skuId":"0010","skuImages":{},"skuTitle":"Bum Simulator","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P5BRS3LJN26","skuDescription":"Bum Simulator is a sandbox game bursting with inappropriate humor and memorable characters. Apart from day-to-day survival, you can enjoy many unique features.\r\n\r\nYou can throw pigeons at people and watch as the panic ensues. Not fun enough? Upgrade your birds with explosives and let chaos reign. Still not satisfied? Wait until you see the fully upgraded pigeonado skill…\r\n\r\nMix alcohol with stuff you found on the ground to create powerful mixtures. Drink them (if you dare) to get a boost, or throw them at your enemies for a devastating effect.\r\n\r\nEvery bum needs a shopping cart of their own. Yours is named Carl and he’s your trusty mobile inventory. Also, he’s your best friend (no, really). You’ll learn to love him - we promise!\r\n\r\nMutant sewer rat people from the ’80s? Mentally unstable clown with a hook for a hand? A bored rich man telling you to punch random people on the street? We have them all, and then some! You’ll meet them all while following the insane storyline (yes, this game has an actual story!)\r\n\r\nDay-to-day survival can be exhausting, so why not take a break and get some shut-eye in a cozy shelter? Conquer, construct, and customize your cardboard bases to your heart’s content. However, remember to build some defenses as the rival bum gang raids are inevitable!\r\n\r\nCrafting makes your life easier. Collect materials and process them to get upgrades and expansions to your base. Tired of searching for food? Construct pots and plant some vegetables. Need stronger pigeons? Better upgrade that coop. Scavenging for scrap got boring? Recruit other bums to do the dirty work for you. With enough work, you can build a truly self-sustainable bum base!\r\n\r\nHear ye, hear ye! Every character in the game is fully voiced. Each line of dialogue oozes emotion and personality, which makes the game's storyline and atmosphere even gross… er… more engrossing!","skuId":"0011","skuImages":{},"skuTitle":"Bum Simulator","isUbisoftConsoleCrossEntitlement":false}},"9P7ZG9MQKKLN":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B26DLGX0JHNQ","preferredAvailabilityId":"B26DLGX0JHNQ","productId":"9P7ZG9MQKKLN","skuDescription":"Pre-order the Standard Edition now to get the exclusive Hero of Harran Bundle, which contains:\n– Ultimate Survivor Outfit\n– Harran Combat Knife (+ Upgradable Blueprint)\n– The Follower Crossbow (+ Upgradable Blueprint)\n– In Jade’s Memory Pistol (+ Upgradable Blueprint)\n– Castor Woods Patrol \n\nYou are Kyle Crane. After being captured by the Baron and enduring his painful experiments for years, you escape. But the scars remain. Left on the edge of humanity with both human and zombie DNA, you struggle to control your inner beast and the conflict that comes with it. But you’ll need to, if you want to get your revenge on the man who did this to you. A unique blend of open world and action survival horror, Dying Light: The Beast is set in the beautiful, yet dangerous valley of Castor Woods that’s now overrun with zombies rather than tourists. To take your former captor down, you’ll need to form fragile alliances, as well as utilize all the combat and traversal options in your arsenal. But be careful: out here, each step is a fight for survival, especially once the sun sets and the tension heightens as the true horrors come out at night!\nHalf Beast, Half Survivor\nBecome Kyle Crane, a unique hero with DNA of a survivor… and a beast. Switch between two playstyles and experience a fierce inner conflict between man and monster, leading to the ultimate embrace of unstoppable strength.\n\nPrimal Brutality\nTake the raw savagery of Dying Light’s combat to the extreme and push brutality beyond human limits as you crush skulls, rip heads off, and tear enemies in half struggling to control the hero's constantly evolving, rage fueled, beast-like powers.\n\nOwn the day, fear the night\nA signature of the Dying Light series - two vastly different experiences of day and night merge into one unforgettable whole. Scavenge and explore by day, mindful of the constant tension of the moving clock - as when the sun sets, the night unleashes horrors that leave you with only three choices: run, hide, or fight for your life.\n\nRun the Rooftops, Rule the Roads\nFeel the rush of best-in-class first-person parkour as you jump from rooftop to rooftop and climb over any obstacle using a movement system accessible to all, yet rewarding those who master it. Then take the wheel of an off-road vehicle and plow through hordes of zombies enjoying unparalleled freedom of open world traversal.\n\nBeautiful Zombie Apocalypse\nBreathtaking next-gen visuals bring the handcrafted zombie apocalypse to life, where every detail tells a story of survival. Get lost in the majesty of Swiss-Alps inspired valley of Castor Woods with various biomes - tourist town, industrial area, national park, farm fields, swamps - full of beauty… and decay.\n\nShare the adventure\nBand together in up to 4-player co-op to take on the dangers of Castor Woods, where every fight, every discovery and every twisting step of the story can be faced as a group. Use shared progression to conquer the entire adventure side by side, as you face relentless enemies, scavenge for resources and save each other from the brink of death.","skuId":"0010","skuImages":{},"skuTitle":"Dying Light: The Beast","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9P7ZG9MQKKLN","skuDescription":"Pre-order the Standard Edition now to get the exclusive Hero of Harran Bundle, which contains:\n– Ultimate Survivor Outfit\n– Harran Combat Knife (+ Upgradable Blueprint)\n– The Follower Crossbow (+ Upgradable Blueprint)\n– In Jade’s Memory Pistol (+ Upgradable Blueprint)\n– Castor Woods Patrol \n\nYou are Kyle Crane. After being captured by the Baron and enduring his painful experiments for years, you escape. But the scars remain. Left on the edge of humanity with both human and zombie DNA, you struggle to control your inner beast and the conflict that comes with it. But you’ll need to, if you want to get your revenge on the man who did this to you. A unique blend of open world and action survival horror, Dying Light: The Beast is set in the beautiful, yet dangerous valley of Castor Woods that’s now overrun with zombies rather than tourists. To take your former captor down, you’ll need to form fragile alliances, as well as utilize all the combat and traversal options in your arsenal. But be careful: out here, each step is a fight for survival, especially once the sun sets and the tension heightens as the true horrors come out at night!\nHalf Beast, Half Survivor\nBecome Kyle Crane, a unique hero with DNA of a survivor… and a beast. Switch between two playstyles and experience a fierce inner conflict between man and monster, leading to the ultimate embrace of unstoppable strength.\n\nPrimal Brutality\nTake the raw savagery of Dying Light’s combat to the extreme and push brutality beyond human limits as you crush skulls, rip heads off, and tear enemies in half struggling to control the hero's constantly evolving, rage fueled, beast-like powers.\n\nOwn the day, fear the night\nA signature of the Dying Light series - two vastly different experiences of day and night merge into one unforgettable whole. Scavenge and explore by day, mindful of the constant tension of the moving clock - as when the sun sets, the night unleashes horrors that leave you with only three choices: run, hide, or fight for your life.\n\nRun the Rooftops, Rule the Roads\nFeel the rush of best-in-class first-person parkour as you jump from rooftop to rooftop and climb over any obstacle using a movement system accessible to all, yet rewarding those who master it. Then take the wheel of an off-road vehicle and plow through hordes of zombies enjoying unparalleled freedom of open world traversal.\n\nBeautiful Zombie Apocalypse\nBreathtaking next-gen visuals bring the handcrafted zombie apocalypse to life, where every detail tells a story of survival. Get lost in the majesty of Swiss-Alps inspired valley of Castor Woods with various biomes - tourist town, industrial area, national park, farm fields, swamps - full of beauty… and decay.\n\nShare the adventure\nBand together in up to 4-player co-op to take on the dangers of Castor Woods, where every fight, every discovery and every twisting step of the story can be faced as a group. Use shared progression to conquer the entire adventure side by side, as you face relentless enemies, scavenge for resources and save each other from the brink of death.","skuId":"0017","skuImages":{},"skuTitle":"Dying Light: The Beast","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P7ZG9MQKKLN","skuDescription":"Pre-order the Standard Edition now to get the exclusive Hero of Harran Bundle, which contains:\n– Ultimate Survivor Outfit\n– Harran Combat Knife (+ Upgradable Blueprint)\n– The Follower Crossbow (+ Upgradable Blueprint)\n– In Jade’s Memory Pistol (+ Upgradable Blueprint)\n– Castor Woods Patrol \n\nYou are Kyle Crane. After being captured by the Baron and enduring his painful experiments for years, you escape. But the scars remain. Left on the edge of humanity with both human and zombie DNA, you struggle to control your inner beast and the conflict that comes with it. But you’ll need to, if you want to get your revenge on the man who did this to you. A unique blend of open world and action survival horror, Dying Light: The Beast is set in the beautiful, yet dangerous valley of Castor Woods that’s now overrun with zombies rather than tourists. To take your former captor down, you’ll need to form fragile alliances, as well as utilize all the combat and traversal options in your arsenal. But be careful: out here, each step is a fight for survival, especially once the sun sets and the tension heightens as the true horrors come out at night!\nHalf Beast, Half Survivor\nBecome Kyle Crane, a unique hero with DNA of a survivor… and a beast. Switch between two playstyles and experience a fierce inner conflict between man and monster, leading to the ultimate embrace of unstoppable strength.\n\nPrimal Brutality\nTake the raw savagery of Dying Light’s combat to the extreme and push brutality beyond human limits as you crush skulls, rip heads off, and tear enemies in half struggling to control the hero's constantly evolving, rage fueled, beast-like powers.\n\nOwn the day, fear the night\nA signature of the Dying Light series - two vastly different experiences of day and night merge into one unforgettable whole. Scavenge and explore by day, mindful of the constant tension of the moving clock - as when the sun sets, the night unleashes horrors that leave you with only three choices: run, hide, or fight for your life.\n\nRun the Rooftops, Rule the Roads\nFeel the rush of best-in-class first-person parkour as you jump from rooftop to rooftop and climb over any obstacle using a movement system accessible to all, yet rewarding those who master it. Then take the wheel of an off-road vehicle and plow through hordes of zombies enjoying unparalleled freedom of open world traversal.\n\nBeautiful Zombie Apocalypse\nBreathtaking next-gen visuals bring the handcrafted zombie apocalypse to life, where every detail tells a story of survival. Get lost in the majesty of Swiss-Alps inspired valley of Castor Woods with various biomes - tourist town, industrial area, national park, farm fields, swamps - full of beauty… and decay.\n\nShare the adventure\nBand together in up to 4-player co-op to take on the dangers of Castor Woods, where every fight, every discovery and every twisting step of the story can be faced as a group. Use shared progression to conquer the entire adventure side by side, as you face relentless enemies, scavenge for resources and save each other from the brink of death.","skuId":"0011","skuImages":{},"skuTitle":"Dying Light: The Beast","isUbisoftConsoleCrossEntitlement":false}},"9MT19Q3CRMQZ":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9TR8V9F21NXB","preferredAvailabilityId":"9TR8V9F21NXB","productId":"9MT19Q3CRMQZ","skuDescription":"Hop into the driver's seat of your rocket-powered big rig as you haul cargo, scavenge for salvage and interact with an eclectic cast of star-hopping truckers in this Americana-infused journey on the ultimate open road - space!\n\nHAUL AND HOLLER\n\nCruise the hyper highways, taking on a variety of jobs such as fuel hungry long hauls and hazardous drop-offs to earn cash and unlock new content.\n\nAnd don't forget to monitor the CB radio for chatter from fellow truckers; it's a fantastic way to uncover side gigs and stay updated on galactic gossip.\n\n\nMANAGE AND MAINTAIN\n\nKeeping your rig runnin’ isn’t always easy. You’ll need to keep your core systems online, gravity compensator spinnin’ and hull patched to prevent your cab from leaking lung juice.\n\nBe sure to make pre-trip shop stops for replacement parts, and consider upgrading your truck at a local garage. These improvements are vital for safely navigating volatile sectors and ensuring timely deliveries.\n\n\nHYPERJUMP!\n\nUse the galactic map to plan your journey and warp jumps, while keeping an eye on your fuel reserves and power levels.\n\nOnce your route is set, kick back, crank up the cab hi-fi and cruise to a selection of original songs covering starburst blues, galactic rock and asteroid infused americana. The open road is waiting!\n\nMADE BY MONSTERS\nStar Trucker is the passion project of a small team: Monster and Monster. A two-person indie studio with a love for all things sci-fi and sim.\n\nWith the help of some talented friends they’ve developed an out of this world experience filled with emergent challenges and complex systems to master. So buckle up and join them for the long haul!","skuId":"0010","skuImages":{},"skuTitle":"Star Trucker","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9MT19Q3CRMQZ","skuDescription":"Hop into the driver's seat of your rocket-powered big rig as you haul cargo, scavenge for salvage and interact with an eclectic cast of star-hopping truckers in this Americana-infused journey on the ultimate open road - space!\n\nHAUL AND HOLLER\n\nCruise the hyper highways, taking on a variety of jobs such as fuel hungry long hauls and hazardous drop-offs to earn cash and unlock new content.\n\nAnd don't forget to monitor the CB radio for chatter from fellow truckers; it's a fantastic way to uncover side gigs and stay updated on galactic gossip.\n\n\nMANAGE AND MAINTAIN\n\nKeeping your rig runnin’ isn’t always easy. You’ll need to keep your core systems online, gravity compensator spinnin’ and hull patched to prevent your cab from leaking lung juice.\n\nBe sure to make pre-trip shop stops for replacement parts, and consider upgrading your truck at a local garage. These improvements are vital for safely navigating volatile sectors and ensuring timely deliveries.\n\n\nHYPERJUMP!\n\nUse the galactic map to plan your journey and warp jumps, while keeping an eye on your fuel reserves and power levels.\n\nOnce your route is set, kick back, crank up the cab hi-fi and cruise to a selection of original songs covering starburst blues, galactic rock and asteroid infused americana. The open road is waiting!\n\nMADE BY MONSTERS\nStar Trucker is the passion project of a small team: Monster and Monster. A two-person indie studio with a love for all things sci-fi and sim.\n\nWith the help of some talented friends they’ve developed an out of this world experience filled with emergent challenges and complex systems to master. So buckle up and join them for the long haul!","skuId":"0011","skuImages":{},"skuTitle":"Star Trucker","isUbisoftConsoleCrossEntitlement":false}},"9NPR2CG6S95Q":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B1NH7WVV2W86","preferredAvailabilityId":"B1NH7WVV2W86","productId":"9NPR2CG6S95Q","skuDescription":"Satisfactory is a first-person open-world factory building game with a dash of exploration and combat. Play alone or with friends, explore an alien planet, create multi-story factories, and enter conveyor belt heaven!\n\nConstruct\nConquer nature by building massive factories across the land. Expand wherever and however you want. The planet is filled with valuable natural resources just waiting to be utilized. As an employee of FICSIT it’s your duty to make sure they come to good use.\n\nAutomate\nConstruct your factories with gracious perfection or build intricate webs of conveyor belts to supply all your needs. Automate trucks and trains to reach your faraway outposts and be sure to handle liquids properly by transporting them in pipes. It’s all about minimizing manual labor!\n\nExplore & Exploit\nVenture on expeditions to search for new materials and be sure to put everything to good use. Nature is yours to harvest! You have vehicles, jetpacks, jump pads and more at your disposal to make the exploration easier. Equip the proper safety gear as well, just in case you run into the local wildlife.\n\nFEATURES\n• Open World: Explore the huge (30km²) alien planet that is Massage-2(AB)b with its unique fauna and creatures.\n• Co-Op: Build a factory yourself or share the joy with your friends. Up to you!\n• Factory Building: Experience building a huge factory from a first-person perspective. Automate and optimize it to perfection for your personal satisfaction.\n• Customization: Customize your factory to your own liking. Build at high altitudes or over wide plains, there is almost no limits in the making of your tailor-made factory.\n• Vehicles: Travel the world with class. Use jump pads, factory carts, jetpacks, hypertubes, trucks or trains. The choice is yours!","skuId":"0010","skuImages":{},"skuTitle":"Satisfactory","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9NPR2CG6S95Q","skuDescription":"Satisfactory is a first-person open-world factory building game with a dash of exploration and combat. Play alone or with friends, explore an alien planet, create multi-story factories, and enter conveyor belt heaven!\n\nConstruct\nConquer nature by building massive factories across the land. Expand wherever and however you want. The planet is filled with valuable natural resources just waiting to be utilized. As an employee of FICSIT it’s your duty to make sure they come to good use.\n\nAutomate\nConstruct your factories with gracious perfection or build intricate webs of conveyor belts to supply all your needs. Automate trucks and trains to reach your faraway outposts and be sure to handle liquids properly by transporting them in pipes. It’s all about minimizing manual labor!\n\nExplore & Exploit\nVenture on expeditions to search for new materials and be sure to put everything to good use. Nature is yours to harvest! You have vehicles, jetpacks, jump pads and more at your disposal to make the exploration easier. Equip the proper safety gear as well, just in case you run into the local wildlife.\n\nFEATURES\n• Open World: Explore the huge (30km²) alien planet that is Massage-2(AB)b with its unique fauna and creatures.\n• Co-Op: Build a factory yourself or share the joy with your friends. Up to you!\n• Factory Building: Experience building a huge factory from a first-person perspective. Automate and optimize it to perfection for your personal satisfaction.\n• Customization: Customize your factory to your own liking. Build at high altitudes or over wide plains, there is almost no limits in the making of your tailor-made factory.\n• Vehicles: Travel the world with class. Use jump pads, factory carts, jetpacks, hypertubes, trucks or trains. The choice is yours!","skuId":"0011","skuImages":{},"skuTitle":"Satisfactory","isUbisoftConsoleCrossEntitlement":false}},"9PNKG0WBL61W":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9RSN3983STPN","preferredAvailabilityId":"9RSN3983STPN","productId":"9PNKG0WBL61W","skuDescription":"Pacific Drive is a first-person driving survival game with your car as your only companion. Navigate a surreal reimagining of the Pacific Northwest, and face supernatural dangers as you venture into the Olympic Exclusion Zone. Each excursion into the wilderness brings unique and strange challenges as you restore and upgrade your car from an abandoned garage that acts as your home base. Gather precious resources and investigate what’s been left behind in the Zone; unravel a long-forgotten mystery while learning exactly what it takes to survive in this unpredictable, hostile environment.\n\nDRIVE TO SURVIVE\nIt’s you and your station wagon against an unforgiving, vicious world. It’ll take more than a fresh set of tires to keep you alive, on and off the road. Your faithful wagon can be upgraded and reinforced to protect you, but the car is going to take a beating. Keep your gas tank filled and your panels intact to withstand the radiation permeating the Zone. You’ll be pushed to your limit - making repairs on the fly, scavenging materials wherever you can, and adapting your rolling fortress to tackle the many life-threatening dangers that lurk in the shadows.\n\nINVESTIGATE THE ZONE\nThe experimental leftovers of the secretive ARDA organization remain scattered across the Zone, and finding answers won’t be easy. Everywhere you look you’ll find anomalies, surreal forces of a twisted nature that make your journey more difficult... or more interesting. Silhouettes in the dark, rolling piles of scrap metal, and towering pillars of earth - each outing from your garage is packed with otherworldly hazards. As terrifying as those may be, nothing compares to the overwhelming power of a Zone Storm. Stomp on the gas and outrun it if you can - these rolling maelstroms rend the landscape and obliterate anything that sticks around too long. Don’t let that be you.\n\nREPEAT\nCheck the map, pack some gear for the trip, and hit the road. Gather resources and collect data as you go, there’s all sorts of useful stuff inside the walls of the Zone. Make it back safely and use the contents of your trunk to improve your car and garage. Every time you venture out, new trials await: bizarre weather, unforgiving landscapes, and experimental remnants. The golden rule in the Zone is ‘nothing ventured, nothing gained’ — some materials can only be found in the most dangerous places. Be smart out there, and don’t waste time — it’s going to be a long haul.\n","skuId":"0010","skuImages":{},"skuTitle":"Pacific Drive","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9PNKG0WBL61W","skuDescription":"Pacific Drive is a first-person driving survival game with your car as your only companion. Navigate a surreal reimagining of the Pacific Northwest, and face supernatural dangers as you venture into the Olympic Exclusion Zone. Each excursion into the wilderness brings unique and strange challenges as you restore and upgrade your car from an abandoned garage that acts as your home base. Gather precious resources and investigate what’s been left behind in the Zone; unravel a long-forgotten mystery while learning exactly what it takes to survive in this unpredictable, hostile environment.\n\nDRIVE TO SURVIVE\nIt’s you and your station wagon against an unforgiving, vicious world. It’ll take more than a fresh set of tires to keep you alive, on and off the road. Your faithful wagon can be upgraded and reinforced to protect you, but the car is going to take a beating. Keep your gas tank filled and your panels intact to withstand the radiation permeating the Zone. You’ll be pushed to your limit - making repairs on the fly, scavenging materials wherever you can, and adapting your rolling fortress to tackle the many life-threatening dangers that lurk in the shadows.\n\nINVESTIGATE THE ZONE\nThe experimental leftovers of the secretive ARDA organization remain scattered across the Zone, and finding answers won’t be easy. Everywhere you look you’ll find anomalies, surreal forces of a twisted nature that make your journey more difficult... or more interesting. Silhouettes in the dark, rolling piles of scrap metal, and towering pillars of earth - each outing from your garage is packed with otherworldly hazards. As terrifying as those may be, nothing compares to the overwhelming power of a Zone Storm. Stomp on the gas and outrun it if you can - these rolling maelstroms rend the landscape and obliterate anything that sticks around too long. Don’t let that be you.\n\nREPEAT\nCheck the map, pack some gear for the trip, and hit the road. Gather resources and collect data as you go, there’s all sorts of useful stuff inside the walls of the Zone. Make it back safely and use the contents of your trunk to improve your car and garage. Every time you venture out, new trials await: bizarre weather, unforgiving landscapes, and experimental remnants. The golden rule in the Zone is ‘nothing ventured, nothing gained’ — some materials can only be found in the most dangerous places. Be smart out there, and don’t waste time — it’s going to be a long haul.\n","skuId":"0011","skuImages":{},"skuTitle":"Pacific Drive","isUbisoftConsoleCrossEntitlement":false}},"9P7ZBF3S7PSS":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"B231FVGDVQZT","preferredAvailabilityId":"B231FVGDVQZT","productId":"9P7ZBF3S7PSS","skuDescription":"S.T.A.L.K.E.R. 2: Heart of Chornobyl is the unforgiving FPS survival adventure in a dark science-fiction open world. Scavenge for gear and resources, hunt for wonders, make hard decisions to survive and pave the path through the Chornobyl Anomalous Zone.\n\nTHE ZONE\nThousands of adventurers from all over the world find a new life here, in a mysterious and dangerous place on the land of the Chornobyl Anomalous Exclusion Zone. Become one of them, and start your own through an immense, atmospheric open world, full of dangers and mysteries. Shed light on the dark secrets of the second disaster, hunt mutants, and explore the hazardous anomalies in search of precious artifacts.\nWill your skill and courage be enough to overcome anomalous and human threats, or will you become one of many who lost to the Zone?\n\nTHE STORY\nThe Zone keeps hundreds of secrets and thousands of stories, revealing them only to the bravest and most dexterous. Starting as a lone stalker, explore a unique post-apocalyptic world and decide who will get a bullet and who is worthy of your helping hand. And while making decisions, be sure: many choices and actions will have their own, sometimes far from the obvious, consequences.\nTo be a savior and a faithful friend, the figure for stalker's campfire legends. Or to carry out harsh, but profitable missions for those who are in control of the Zone — you are free to be anyone here, even yourself.\n\nTHE DANGER\nBandits, mercenaries, official authority forces, lone stalkers, various factions, and mutants… The world of «S.T.A.L.K.E.R. 2: Heart of Chornobyl» is full of predators who strive to seize your loot or get a taste of human flesh. Analyzing their behavior and picking specific tactics for each species is the only way to win or at least get out of the fight alive.\nThere is no absolute safety because your foremost enemy is the Zone itself, capable of challenging all your skill and courage at the most unexpected moment.\n\nTHE ACTION\nThe Zone has become a perfect black market for weaponry from all around the world. This means that in the potential arsenal of stalkers, there are more than 30 models of various firearms and the ingenuity of gunsmiths who are ready to modify them for greater lethality and reliability. Define your distinctive combat style, select the most efficient weapon, and customize it to your taste for maximal tactical advantage.\nA wise stalker said: the most dangerous weapon is not the gun in your holster but the gumption, tenacity, and sharp reflexes. Keep that in mind on your path to the Heart of Chornobyl!\n\n\nCertain features of the game, including mods, may not be accessible to Xbox child accounts. On Xbox, a child is defined as a player under the age of 13, unless local laws specify otherwise.","skuId":"0010","skuImages":{},"skuTitle":"S.T.A.L.K.E.R. 2: Heart of Chornobyl","isUbisoftConsoleCrossEntitlement":false},"0017":{"isGamesWithGoldSku":false,"isPreorder":true,"productId":"9P7ZBF3S7PSS","skuDescription":"S.T.A.L.K.E.R. 2: Heart of Chornobyl is the unforgiving FPS survival adventure in a dark science-fiction open world. Scavenge for gear and resources, hunt for wonders, make hard decisions to survive and pave the path through the Chornobyl Anomalous Zone.\n\nTHE ZONE\nThousands of adventurers from all over the world find a new life here, in a mysterious and dangerous place on the land of the Chornobyl Anomalous Exclusion Zone. Become one of them, and start your own through an immense, atmospheric open world, full of dangers and mysteries. Shed light on the dark secrets of the second disaster, hunt mutants, and explore the hazardous anomalies in search of precious artifacts.\nWill your skill and courage be enough to overcome anomalous and human threats, or will you become one of many who lost to the Zone?\n\nTHE STORY\nThe Zone keeps hundreds of secrets and thousands of stories, revealing them only to the bravest and most dexterous. Starting as a lone stalker, explore a unique post-apocalyptic world and decide who will get a bullet and who is worthy of your helping hand. And while making decisions, be sure: many choices and actions will have their own, sometimes far from the obvious, consequences.\nTo be a savior and a faithful friend, the figure for stalker's campfire legends. Or to carry out harsh, but profitable missions for those who are in control of the Zone — you are free to be anyone here, even yourself.\n\nTHE DANGER\nBandits, mercenaries, official authority forces, lone stalkers, various factions, and mutants… The world of «S.T.A.L.K.E.R. 2: Heart of Chornobyl» is full of predators who strive to seize your loot or get a taste of human flesh. Analyzing their behavior and picking specific tactics for each species is the only way to win or at least get out of the fight alive.\nThere is no absolute safety because your foremost enemy is the Zone itself, capable of challenging all your skill and courage at the most unexpected moment.\n\nTHE ACTION\nThe Zone has become a perfect black market for weaponry from all around the world. This means that in the potential arsenal of stalkers, there are more than 30 models of various firearms and the ingenuity of gunsmiths who are ready to modify them for greater lethality and reliability. Define your distinctive combat style, select the most efficient weapon, and customize it to your taste for maximal tactical advantage.\nA wise stalker said: the most dangerous weapon is not the gun in your holster but the gumption, tenacity, and sharp reflexes. Keep that in mind on your path to the Heart of Chornobyl!\n\n\nCertain features of the game, including mods, may not be accessible to Xbox child accounts. On Xbox, a child is defined as a player under the age of 13, unless local laws specify otherwise.","skuId":"0017","skuImages":{},"skuTitle":"S.T.A.L.K.E.R. 2: Heart of Chornobyl","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9P7ZBF3S7PSS","skuDescription":"S.T.A.L.K.E.R. 2: Heart of Chornobyl is the unforgiving FPS survival adventure in a dark science-fiction open world. Scavenge for gear and resources, hunt for wonders, make hard decisions to survive and pave the path through the Chornobyl Anomalous Zone.\n\nTHE ZONE\nThousands of adventurers from all over the world find a new life here, in a mysterious and dangerous place on the land of the Chornobyl Anomalous Exclusion Zone. Become one of them, and start your own through an immense, atmospheric open world, full of dangers and mysteries. Shed light on the dark secrets of the second disaster, hunt mutants, and explore the hazardous anomalies in search of precious artifacts.\nWill your skill and courage be enough to overcome anomalous and human threats, or will you become one of many who lost to the Zone?\n\nTHE STORY\nThe Zone keeps hundreds of secrets and thousands of stories, revealing them only to the bravest and most dexterous. Starting as a lone stalker, explore a unique post-apocalyptic world and decide who will get a bullet and who is worthy of your helping hand. And while making decisions, be sure: many choices and actions will have their own, sometimes far from the obvious, consequences.\nTo be a savior and a faithful friend, the figure for stalker's campfire legends. Or to carry out harsh, but profitable missions for those who are in control of the Zone — you are free to be anyone here, even yourself.\n\nTHE DANGER\nBandits, mercenaries, official authority forces, lone stalkers, various factions, and mutants… The world of «S.T.A.L.K.E.R. 2: Heart of Chornobyl» is full of predators who strive to seize your loot or get a taste of human flesh. Analyzing their behavior and picking specific tactics for each species is the only way to win or at least get out of the fight alive.\nThere is no absolute safety because your foremost enemy is the Zone itself, capable of challenging all your skill and courage at the most unexpected moment.\n\nTHE ACTION\nThe Zone has become a perfect black market for weaponry from all around the world. This means that in the potential arsenal of stalkers, there are more than 30 models of various firearms and the ingenuity of gunsmiths who are ready to modify them for greater lethality and reliability. Define your distinctive combat style, select the most efficient weapon, and customize it to your taste for maximal tactical advantage.\nA wise stalker said: the most dangerous weapon is not the gun in your holster but the gumption, tenacity, and sharp reflexes. Keep that in mind on your path to the Heart of Chornobyl!\n\n\nCertain features of the game, including mods, may not be accessible to Xbox child accounts. On Xbox, a child is defined as a player under the age of 13, unless local laws specify otherwise.","skuId":"0011","skuImages":{},"skuTitle":"S.T.A.L.K.E.R. 2: Heart of Chornobyl","isUbisoftConsoleCrossEntitlement":false}},"9PHFJ0N31NV1":{"0010":{"isGamesWithGoldSku":false,"isPreorder":false,"optimalAvailabilityId":"9WB1FVRHTZ68","preferredAvailabilityId":"9WB1FVRHTZ68","productId":"9PHFJ0N31NV1","skuDescription":"Slime Rancher 2 is a sequel to the award-winning, smash-hit original that has been enjoyed by over 10 million fans worldwide. Continue the adventures of Beatrix LeBeau as she journeys to Rainbow Island, a mysterious land brimming with ancient technology, unknown natural resources, and an avalanche of wiggling, jiggling, new slimes to discover.\n\nAs Beatrix attempts to unravel the island’s secrets and uncover its true purpose, she’ll build, ranch, and farm within a beautiful conservatory, whose sparkling glass walls give her full view of the prismatic paradise she now calls home.","skuId":"0010","skuImages":{},"skuTitle":"Slime Rancher 2","isUbisoftConsoleCrossEntitlement":false},"0011":{"isGamesWithGoldSku":false,"isPreorder":false,"productId":"9PHFJ0N31NV1","skuDescription":"Slime Rancher 2 is a sequel to the award-winning, smash-hit original that has been enjoyed by over 10 million fans worldwide. Continue the adventures of Beatrix LeBeau as she journeys to Rainbow Island, a mysterious land brimming with ancient technology, unknown natural resources, and an avalanche of wiggling, jiggling, new slimes to discover.\n\nAs Beatrix attempts to unravel the island’s secrets and uncover its true purpose, she’ll build, ranch, and farm within a beautiful conservatory, whose sparkling glass walls give her full view of the prismatic paradise she now calls home.","skuId":"0011","skuImages":{},"skuTitle":"Slime Rancher 2","isUbisoftConsoleCrossEntitlement":false}}},"entitlements":{},"productActions":{},"ratingsAndReviews":{}},"searchPromotions":{},"serviceErrorMessages":{},"support":{},"userSettings":{"privacySettingsData":{},"safetySettingsData":{},"messageSafetySettingsData":{},"gamingConsentsData":{}},"wishlist":{"wishlists":{}},"productEvents":{},"planPicker":{"type":0},"search":{}},"content":{"buddyPass":{"buddyPassOffers":{"type":0},"buddyPassValidateRedeemer":{"type":0},"buddyPassValidateSender":{"type":0}},"channels":{"channelData":{},"channelMetadata":{}},"contentPages":{},"xgpp":{"validateTransaction":{"type":0},"activateSubscription":{"type":0}},"filters":{},"eligibleTokenOffer":{"type":0},"enrollment":{"type":0},"entitlements":{},"incentives":{"eligibility":{}},"products":{"additionalInformation":{},"availabilitySummaries":{},"productSummaries":{},"productInfoMetadata":{},"skuSummaries":{}},"recommendationLists":{},"optInSubmit":{"type":0},"sweepstakesSubmit":{"type":0},"yearInReview":{"userPage":{"userData":{"type":0},"campsiteData":{"type":0}},"marketingPage":{"campsiteData":{"type":0}}}}};
