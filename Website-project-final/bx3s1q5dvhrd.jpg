02F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F5150b74f-f117-4fb6-970f-b12218bf459f-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Dead Island 2 Neighborhood Watch Trailer ","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.59318.13923893344658637.6ce58e1e-5d11-4117-bfca-19800098ac55.71ffc77b-722a-4adb-ba69-bc3504f5d0b5","width":1920,"height":1080,"caption":"Dead Island 2 Neighborhood Watch Trailer "}}],"xCloudProperties":{"xCloudId":"DEADISLAND2","xboxTitleId":783973363,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"DEADISLAND2","xboxTitleId":783973363,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9NVJ7NZX1WL2":{"availableOn":["XboxSeriesX","XCloud"],"averageRating":3.7,"badges":[],"categories":["Simulation","Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Violence","Blood","Use of Drugs","Strong Language"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"GREEN HELL is an Open World Survival Simulator set in the unique and uncharted setting of the Amazonian rainforest. \n\nPlunge into the open world survival simulation set in the extreme conditions of the unforgiving Amazon jungle. Use real-life survival techniques to craft, hunt, fight, and gather resources. Build a makeshift shelter or raise a fortress, but always remember to tend to your wounds and maintain mental health.\n\nSurvive on your own, or try your chances in an up-to-4-player online co-op mode.\n\nThe Xbox Series X|S edition of the game contains the highly acclaimed GREEN HELL experience, alongside the Spirits of Amazonia update with over 20 hours of additional gameplay. \n \n\nThe game also includes the following content updates:\n- Animal Husbandry \n- Building Update\n- Storage & Transportation\n- Fortifications \n- Flamekeeper\n\nThe Xbox Series X|S version of the game is not compatible with the Xbox One version due to differences in game content and online features.","developerName":"Creepy Jar","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.33854.13940291450306824.b8a3160d-1f0e-47b1-a033-3deacec85b8a.cc04bced-0eb3-4d08-ac39-a1bb498d20ce","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.12064.13940291450306824.b8a3160d-1f0e-47b1-a033-3deacec85b8a.eeec71cf-5993-4927-b1ca-ad969512ecc6","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.53183.13940291450306824.b8a3160d-1f0e-47b1-a033-3deacec85b8a.0eb40936-6119-4d80-bb96-e8794dd12aa3","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NVJ7NZX1WL2","productKind":"Game","publisherName":"Creepy Jar","ratingCount":548,"releaseDate":"2024-08-14T04:00:00.0000000Z","shortDescription":"GREEN HELL is an Open World Survival Simulator set in the unique and uncharted setting of the Amazonian rainforest. Survive on your own, or try your chances in an up-to-4-player online co-op mode.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9VZNF4XF3BZK","discountPercentage":75.030014,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":6.24,"msrp":24.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B16WLC6XH8N6","discountPercentage":75.030014,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":6.24,"msrp":24.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Green Hell Xbox Series X|S","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F66a30c25-7b13-41c3-8645-504494004768-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Green Hell","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.1991.14398377361448261.323dc254-ac57-4caf-8a74-6fc7ef6efa16.f8415953-f818-42c7-a07c-66f3efde06b8","width":1920,"height":1080,"caption":"Green Hell"}}],"xCloudProperties":{"xCloudId":"GREENHELLXBOXSERIESXS","xboxTitleId":1949704395,"supportsTouch":false},"passMetadataByPassProductId":{},"xCloudPropertiesV2":{"xCloudId":"GREENHELLXBOXSERIESXS","xboxTitleId":1949704395,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9PLRB49DJ4WK":{"availableOn":["XboxSeriesX"],"averageRating":3.9,"badges":[],"categories":["Action & adventure"],"contentRating":{"boardName":"ESRB","description":"For ages 10 and up","disclaimers":[],"descriptors":["Fantasy Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.56093.image.e3da543f-ed61-47ce-bc12-683dab90c502.5e57d206-3b82-4a7b-9b98-d1548cd450a8","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["Users Interact"],"rating":"EVERYONE 10+","ratingAge":10,"ratingDescription":"For ages 10 and up"},"description":"Step into a boundless open world where every planet, every system, and every moment is yours to shape. Explore a universe rich with life, ancient mysteries, and untamed beauty. Fight back the Red Darkness menace as you mine resources, craft tools, weapons, and build vehicles that are essential for your odyssey. Collaborate with friends to battle colossal threats and bring hope to the galaxy. Adventure, creation, and survival await!\n\nKey Features:\n\nHuge Open Cubic World\nEvery star seen in the sky or in space is the light of a star system. Each star is orbited by planets filled with life, with shifting day-night cycles, bustling NPC cities, pirate outposts, and dangerous ruins waiting to be discovered.\n\nCrafting and Building Paradise\nMine resources, refine materials, and build everything from tools and outposts to vehicles and starships.\n\nEndless Galactic Odyssey\nTake on diverse quests, uncover secrets of the forgotten civilization, trade with NPCs, or battle rogue pirates as the epic story of saving the galaxy unfolds before you.\n\nFun Co-op Gameplay\nJoin forces with others to take down massive enemies, initiate orbital laser strikes, or build cooperative megastructures.\n\nSeamless Ground, Air and Space Traversal\nSwitch between planetary vehicles and spaceships, exploring from the ground up—or the skies down. Experience warp jumps between star systems, cruise at blazing fast speed between planets or just use the planetary speeders to travel on planets.\n\nLimitless Exploration\nVenture across hundreds of star systems filled with rich ecosystems, alien flora and fauna, and ever-changing environments.\n\nIntense Red Darkness Battles\nCombat a spreading galactic infection that mutates wildlife, consumes planets, and threatens all life. Your actions can cleanse the plague—or let it thrive.\n\nRPG-style Depth\nLevel up your skills, unlock new crafting recipes, and shape your character’s journey through meaningful choices and upgrades.","developerName":"Atypical Games","hasAddOns":false,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.59823.14308150716434444.e3628855-cd45-4a9b-8381-a1d41ad814c5.696fc686-983a-4fde-9d1d-2a93436901e2","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.55897.14308150716434444.e3628855-cd45-4a9b-8381-a1d41ad814c5.c273bde2-8323-4e9a-9491-dfad9ba64f53","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.53203.14308150716434444.e3628855-cd45-4a9b-8381-a1d41ad814c5.88333277-0023-47ef-9995-4fb0df5d369b","width":3840,"height":2160}},"includedWithPassesProductIds":[],"maxInstallSize":0,"optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9PLRB49DJ4WK","productKind":"Game","publisherName":"Gaijin Distribution Kft","ratingCount":93,"releaseDate":"2025-05-14T17:00:00.0000000Z","shortDescription":"Embark on a galactic journey in Cubic Odyssey, an open-world adventure where you explore vibrant planets, craft tools, build vehicles, and fight the Red Darkness. Uncover ancient mysteries, and shape a universe full of life, danger, and limitless possibilities!","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9Q8R6BWFXM4G","discountPercentage":40.016006,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":14.99,"msrp":24.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"9MXSHNZ98ZMJ","discountPercentage":40.016006,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F30\u002F2026 09:59:59","hasXPriceOffer":false,"listPrice":14.99,"msrp":24.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Cubic Odyssey","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F6e4b6ae0-ebc0-4fbc-af23-cb9fdfb08ad4-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":2160,"width":3840,"title":"Cubic Odyssey - Launch Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.17423.14308150716434444.e3628855-cd45-4a9b-8381-a1d41ad814c5.42b25dbb-eeaf-420f-bfa3-ce39dc27b741","width":1920,"height":1080,"caption":"Cubic Odyssey - Launch Trailer"}}],"passMetadataByPassProductId":{},"isAvailableOnGarrison":false,"hasUbisoftCrossEntitlementProduct":false},"9NCJSXWZTP88":{"availableOn":["XboxSeriesX","PC","XCloud","Handheld"],"averageRating":3.4,"badges":[{"type":3},{"type":2},{"type":9}],"categories":["Role playing"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Blood","Suggestive Themes","Use of Drugs","Strong Language","Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":["In-Game Purchases"],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4. In this next generation role-playing game set amongst the stars, create any character you want and explore with unparalleled freedom as you embark on an epic journey to answer humanity’s greatest mystery.\r\n\r\nThe year is 2330. Humanity has ventured beyond our solar system, settling new planets, and living as a spacefaring people. From humble beginnings as a space miner, you will join Constellation – the last group of space explorers seeking rare artifacts throughout the galaxy – and navigate the vast expanse of the Settled Systems in Bethesda Game Studios’ biggest and most ambitious game.\n\nhttps:\u002F\u002Feulas.bethesda.net\u002FStarfield","developerName":"Bethesda Game Studios","hasAddOns":true,"hhVerified":{"deviceEvaluation":3},"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.1647.13567343664224659.1eb6fdf9-8a0b-4344-a135-ab17dfa3c609.39331391-9de2-48f8-8643-8eb1bd964383","width":1080,"height":1080},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.35187.13567343664224659.1eb6fdf9-8a0b-4344-a135-ab17dfa3c609.c83b6d6a-56c3-4c3f-8b31-456cfb21c3b7","width":720,"height":1080},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.52870.13567343664224659.1eb6fdf9-8a0b-4344-a135-ab17dfa3c609.20ed1644-2c01-4d5a-b636-3d54ac941a1f","width":1920,"height":1080}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0KGQ8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSatisfyingPassId":"CFQ7TTC0P85B","optimalSkuId":"0010","preferredSkuId":"0010","productFamily":"Games","productId":"9NCJSXWZTP88","productKind":"Game","publisherName":"Bethesda Softworks","ratingCount":33782,"releaseDate":"2023-09-06T00:00:00.0000000Z","shortDescription":"Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4. In this next generation role-playing game set amongst the stars, create any character you want and explore with unparalleled freedom as you embark on an epic journey to answer humanity’s greatest mystery.","showSupportedLanguageDisclaimer":false,"specificPrices":{"purchaseable":[{"skuId":"0010","availabilityId":"9PL6H8PPMQC5","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Purchase","Browse","Curate","Redeem"],"endDateUtc":"07\u002F29\u002F2026 23:59:59","hasXPriceOffer":false,"listPrice":49.99,"msrp":49.99,"currency":"USD"}],"giftable":[{"skuId":"0010","availabilityId":"B07HMLP2T5WL","discountPercentage":0,"eligibilityInfo":{"eligibility":"None","type":"Unknown"},"availabilityActions":["Details","Fulfill","Browse","Curate","Gift"],"endDateUtc":"07\u002F29\u002F2026 23:59:59","hasXPriceOffer":false,"listPrice":49.99,"msrp":49.99,"currency":"USD"}],"totalPurchaseablePricesCount":1},"title":"Starfield","videos":[],"cmsVideos":[{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F5f838898-0cd3-45f6-b8ad-d1492fab45c5-AVS.m3u8?packagedStreaming=true","purpose":"trailer","height":1080,"width":1920,"title":"Gameplay Trailer","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.18869.13567343664224659.d779e929-8095-4769-87de-82799d310c43.48f6f756-0a69-4e40-861e-e608b1020edf","width":1920,"height":1080,"caption":"Gameplay Trailer"}},{"url":"https:\u002F\u002Fcdn.trailers.xboxservices.com\u002Ftrailers\u002F00000000-0000-0000-0000-000000000000\u002Fis\u002Fcontent\u002Fmicrosoftassets\u002F3d189d5e-1892-4be0-8489-aeb7d4f5b99d-AVS.m3u8?packagedStreaming=true","purpose":"HeroTrailer","height":1080,"width":1920,"title":"Free Lanes & Terran Armada Announce","previewImage":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.56862.13567343664224659.d472602d-df7c-48d0-a6f7-81954820ad64.b31a2d70-7910-4eb6-a110-cec2cc126463","width":1920,"height":1080,"caption":"Free Lanes & Terran Armada Announce"}}],"xCloudProperties":{"xCloudId":"STARFIELD","xboxTitleId":2079794073,"supportsTouch":false},"passMetadataByPassProductId":{"CFQ7TTC0K6L8":{"entryDateUTC":"2023-09-06T00:00:00Z"},"CFQ7TTC0KHS0":{"entryDateUTC":"2023-09-06T00:00:00Z"},"CFQ7TTC0KGQ8":{"entryDateUTC":"2023-09-06T00:00:00Z"},"CFQ7TTC0P85B":{"entryDateUTC":"2025-02-05T00:00:00Z"}},"xCloudPropertiesV2":{"xCloudId":"STARFIELD","xboxTitleId":2079794073,"programs":["GPULTIMATE","CALLISTO","DIA","EUROPA","TRITON","FERDINAND"],"supportedInputTypes":["Controller"],"supportsTouch":false},"isAvailableOnGarrison":true,"hasUbisoftCrossEntitlementProduct":false},"BX3M8L83BBRW":{"availableOn":["XboxOne","XboxSeriesX","XCloud"],"averageRating":4.2,"badges":[{"type":3},{"type":9}],"categories":["Role playing"],"contentRating":{"boardName":"ESRB","description":"For ages 17 and up","disclaimers":[],"descriptors":["Nudity","Use Of Drugs And Alcohol","Blood and Gore","Strong Sexual Content","Strong Language","Intense Violence"],"imageUri":"https:\u002F\u002Fstore-images.microsoft.com\u002Fimage\u002Fglobal.53975.image.32437939-2f27-4e79-8431-5f5866f32908.3dc74b18-4153-423c-b367-bdcfd34ac658","imageLinkUri":"https:\u002F\u002Fwww.esrb.org\u002Fratings-guide\u002F","interactiveDescriptions":[],"rating":"MATURE 17+","ratingAge":17,"ratingDescription":"For ages 17 and up"},"description":"IMPORTANT: While Cyberpunk 2077 base game is available on Xbox One, this version of the game received its last patch on November 8th, 2022 and is no longer supported. An Xbox Series X|S console is required in order to download and apply Cyberpunk 2077 patches released after that date — as well as to buy and play the Phantom Liberty expansion pack.\n\nCyberpunk 2077 is an open-world, action-adventure RPG set in the megalopolis of Night City, where you play as a cyberpunk mercenary wrapped up in a do-or-die fight for survival. Improved and featuring all-new free additional content, customize your character and playstyle as you take on jobs, build a reputation, and unlock upgrades. The relationships you forge and the choices you make will shape the story and the world around you. Legends are made here. What will yours be?\n\nCUSTOMIZE YOUR CYBERPUNK WITH UPDATE 2.2!\nExpress yourself with free Update 2.2! Customize your character with new variants of cosmetic cyberware, tattoos, and makeup. Take your ride to the next level with Rayfield’s exclusive CrystalCoat technology, letting you swap colors on luxury and sports cars. Plus, dive into the enhanced photo mode to capture every moment in stunning detail.\n\nCREATE YOUR OWN CYBERPUNK\nBecome an urban outlaw equipped with cybernetic enhancements and build your legend on the streets of Night City.\n\nEXPLORE THE CITY OF THE FUTURE\nNight City is packed to the brim with things to do, places to see, and people to meet. And it’s up to you where to go, when to go, and how to get there. \n\nBUILD YOUR LEGEND\nGo on daring adventures and build relationships with unforgettable characters whose fates are shaped by the choices you make.\n\nCLAIM EXCLUSIVE ITEMS\nClaim in-game swag & digital goodies inspired by CD PROJEKT RED games as part of the My Rewards program.","developerName":"CD PROJEKT RED","hasAddOns":true,"images":{"boxArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.23022.63407868131364914.bcaa868c-407e-42c2-baeb-48a3c9f29b54.be7c9193-46d7-42e9-b555-d0b8921fc4b8","width":2160,"height":2160},"poster":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.47379.63407868131364914.bcaa868c-407e-42c2-baeb-48a3c9f29b54.89bb995b-b066-4a53-9fe4-0260ce07e894","width":1440,"height":2160},"superHeroArt":{"url":"https:\u002F\u002Fstore-images.s-microsoft.com\u002Fimage\u002Fapps.34838.63407868131364914.bcaa868c-407e-42c2-baeb-48a3c9f29b54.1463028d-79fa-46e5-9fc2-63203992a4dc","width":3840,"height":2160}},"includedWithPassesProductIds":["CFQ7TTC0K6L8","CFQ7TTC0P85B"],"maxInstallSize":0,"optimalSkuId":"0001","preferredSkuId":"0001","prod